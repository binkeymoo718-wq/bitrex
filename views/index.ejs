<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bitrex 722</title>
  <style>
    :root{
      --bg:#0b1220;
      --bg-soft:#101a2e;
      --card:#111c31;
      --card-2:#162540;
      --line:rgba(255,255,255,.08);
      --text:#f4f7fb;
      --muted:#98a7c7;
      --primary:#16a34a;
      --primary-2:#22c55e;
      --danger:#ef4444;
      --warning:#f59e0b;
      --blue:#2563eb;
      --purple:#8b5cf6;
      --gold:#facc15;
      --shadow:0 18px 40px rgba(0,0,0,.35);
      --radius:20px;
    }

    *{box-sizing:border-box}
    html,body{margin:0;padding:0;background:linear-gradient(180deg,#08101d,#0c1627 35%,#0a1323 100%);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--text)}
    a{text-decoration:none;color:inherit}
    button,input,select,textarea{font:inherit}
    img{max-width:100%;display:block}

    .container{
      width:min(1180px, 100%);
      margin:0 auto;
      padding:18px 14px 110px;
    }

    .app-shell{
      min-height:100vh;
      position:relative;
    }

    .flash{
      margin:0 0 16px;
      padding:14px 16px;
      border-radius:14px;
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      font-weight:700;
      font-size:14px;
    }
    .flash.success{
      background:rgba(34,197,94,.12);
      color:#c9ffd9;
      border-color:rgba(34,197,94,.35);
    }
    .flash.error{
      background:rgba(239,68,68,.12);
      color:#ffd3d3;
      border-color:rgba(239,68,68,.35);
    }

    /* SIMPLE LOGIN */
    .auth-wrap{
      min-height:100vh;
      display:grid;
      place-items:center;
      padding:20px;
    }

    .auth-simple{
      width:min(420px,100%);
      background:linear-gradient(180deg,rgba(18,29,51,.95),rgba(12,20,36,.98));
      border:1px solid var(--line);
      border-radius:30px;
      padding:40px;
      box-shadow:var(--shadow);
    }

    .auth-logo{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:12px;
      margin-bottom:28px;
    }
    .auth-logo-icon{
      width:48px;height:48px;border-radius:14px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,var(--primary),var(--blue));
      font-weight:900;font-size:20px;color:#fff;
      box-shadow:0 10px 30px rgba(22,163,74,.35);
    }
    .auth-logo h1{
      margin:0;font-size:24px;letter-spacing:.4px;
    }

    .auth-title{
      text-align:center;
      margin-bottom:28px;
    }
    .auth-title h2{
      margin:0 0 8px;
      font-size:24px;
    }
    .auth-title p{
      margin:0;color:var(--muted);font-size:13px;
    }

    .form-group{
      margin-bottom:16px;
    }
    .form-group label{
      display:block;
      font-size:13px;
      color:#cdd9f1;
      font-weight:700;
      margin-bottom:8px;
    }
    .form-group input{
      width:100%;
      background:#0d1526;
      border:1px solid rgba(255,255,255,.08);
      color:#fff;
      border-radius:12px;
      padding:12px 14px;
      outline:none;
      font-size:14px;
    }
    .form-group input::placeholder{
      color:#7f92b8;
    }
    .form-group input:focus{
      border-color:rgba(34,197,94,.35);
      background:#0f1830;
    }

    .password-wrapper{
      position:relative;
    }
    .password-toggle{
      position:absolute;
      right:12px;
      top:50%;
      transform:translateY(-50%);
      background:none;
      border:none;
      color:#7f92b8;
      cursor:pointer;
      font-size:18px;
      display:flex;
      align-items:center;
      justify-content:center;
      width:30px;
      height:30px;
    }
    .password-toggle:hover{color:#cdd9f1}

    .btn-auth{
      width:100%;
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      color:#fff;
      border:none;
      border-radius:12px;
      padding:13px;
      font-weight:800;
      cursor:pointer;
      transition:.2s ease;
      box-shadow:0 10px 25px rgba(34,197,94,.25);
      margin-bottom:16px;
    }
    .btn-auth:hover{transform:translateY(-2px)}

    .auth-links{
      display:grid;
      gap:12px;
    }
    .auth-link{
      text-align:center;
      font-size:13px;
    }
    .auth-link button{
      background:none;
      border:none;
      color:var(--blue);
      cursor:pointer;
      font-weight:700;
      text-decoration:underline;
    }
    .auth-link button:hover{opacity:.8}

    .auth-section{display:none}
    .auth-section.active{display:block}

    /* DASHBOARD */
    .page{display:none}
    .page.active{display:block}

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      margin-bottom:16px;
      padding:10px 0;
    }

    .topbar-left{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .topbar-phone{
      font-size:14px;
      font-weight:700;
    }
    .topbar-phone-sub{
      font-size:12px;
      color:var(--muted);
    }

    .stats-cards{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:14px;
      margin-bottom:18px;
    }

    .stat-card-small{
      background:linear-gradient(135deg,#111c31,#0d1627);
      border:1px solid var(--line);
      border-radius:18px;
      padding:16px;
      text-align:center;
      box-shadow:var(--shadow);
    }
    .stat-card-small .label{
      font-size:12px;
      color:var(--muted);
      margin-bottom:8px;
      text-transform:uppercase;
      letter-spacing:.3px;
    }
    .stat-card-small .value{
      font-size:26px;
      font-weight:900;
      color:#fff;
    }

    .quick-actions-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
      margin-bottom:18px;
    }

    .action-card{
      background:linear-gradient(135deg,#14223b,#0f182a);
      border:1px solid var(--line);
      border-radius:18px;
      padding:18px;
      display:flex;
      flex-direction:column;
      gap:12px;
      cursor:pointer;
      transition:.2s ease;
      box-shadow:var(--shadow);
    }
    .action-card:hover{
      border-color:rgba(34,197,94,.35);
      background:linear-gradient(135deg,#17283e,#11192e);
    }
    .action-card h3{
      margin:0;
      font-size:16px;
      color:#fff;
    }
    .action-card p{
      margin:0;
      font-size:12px;
      color:var(--muted);
    }
    .action-card form{
      margin-top:auto;
    }

    .action-btn{
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      color:#fff;
      border:none;
      border-radius:10px;
      padding:10px 14px;
      font-weight:700;
      font-size:12px;
      cursor:pointer;
      transition:.2s ease;
      width:100%;
    }
    .action-btn:hover{transform:translateY(-1px)}

    .section{
      margin-bottom:18px;
    }
    .section-title{
      font-size:18px;
      font-weight:800;
      margin-bottom:12px;
      color:#fff;
    }

    .city-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:16px;
    }

    .city-card{
      overflow:hidden;
      border-radius:20px;
      background:linear-gradient(180deg,#111c31,#0e182b);
      border:1px solid var(--line);
      box-shadow:var(--shadow);
    }

    .city-image{
      height:140px;
      background-size:cover;
      background-position:center;
      position:relative;
    }
    .city-overlay{
      position:absolute;inset:0;
      background:linear-gradient(180deg,transparent,rgba(0,0,0,.7));
      display:flex;
      align-items:flex-end;
      padding:14px;
    }
    .city-name{
      font-size:20px;
      font-weight:900;
    }
    .city-body{
      padding:14px;
    }
    .city-meta{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
      margin-bottom:12px;
    }
    .meta-item{
      padding:10px;
      border-radius:12px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
    }
    .meta-item .k{
      color:var(--muted);
      font-size:11px;
      margin-bottom:4px;
    }
    .meta-item .v{
      font-size:16px;
      font-weight:800;
    }
    .city-btn{
      width:100%;
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      color:#fff;
      border:none;
      border-radius:10px;
      padding:10px;
      font-weight:700;
      font-size:12px;
      cursor:pointer;
    }

    .task-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:16px;
    }

    .task-card{
      border-radius:18px;
      background:linear-gradient(180deg,#111c31,#0e182b);
      border:1px solid var(--line);
      padding:16px;
      box-shadow:var(--shadow);
      display:flex;
      flex-direction:column;
    }

    .task-title{
      font-size:16px;
      font-weight:800;
      margin-bottom:10px;
    }
    .task-reward{
      font-size:13px;
      color:var(--primary-2);
      font-weight:700;
      margin-bottom:10px;
    }
    .task-claim-btn{
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      color:#fff;
      border:none;
      border-radius:10px;
      padding:10px;
      font-weight:700;
      font-size:12px;
      cursor:pointer;
      margin-top:auto;
    }
    .task-claim-btn:disabled{
      background:rgba(255,255,255,.1);
      color:#7f92b8;
      cursor:not-allowed;
    }

    .wheel-section{
      background:linear-gradient(135deg,#111c31,#0d1627);
      border:1px solid var(--line);
      border-radius:20px;
      padding:24px;
      box-shadow:var(--shadow);
      text-align:center;
      margin-bottom:18px;
    }

    .wheel{
      width:min(300px,100%);
      aspect-ratio:1/1;
      margin:20px auto;
      border-radius:50%;
      border:10px solid rgba(255,255,255,.08);
      background:
        conic-gradient(
          #22c55e 0 60deg,
          #2563eb 60deg 120deg,
          #f59e0b 120deg 180deg,
          #8b5cf6 180deg 240deg,
          #ef4444 240deg 300deg,
          #14b8a6 300deg 360deg
        );
      position:relative;
      box-shadow:0 30px 60px rgba(0,0,0,.35);
      transition:transform 4s cubic-bezier(.12,.8,.12,1);
      cursor:pointer;
    }

    .wheel::before{
      content:"";
      position:absolute;
      inset:22%;
      border-radius:50%;
      background:linear-gradient(180deg,#101b31,#0b1322);
      border:8px solid rgba(255,255,255,.08);
      z-index:1;
    }

    .wheel::after{
      content:"SPIN";
      position:absolute;
      inset:39%;
      border-radius:50%;
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      display:grid;
      place-items:center;
      font-weight:900;
      font-size:14px;
      letter-spacing:1px;
      z-index:2;
      box-shadow:0 8px 20px rgba(34,197,94,.28);
    }

    .wheel-pointer{
      width:0;height:0;
      border-left:12px solid transparent;
      border-right:12px solid transparent;
      border-top:24px solid #fff;
      margin:0 auto -6px;
      filter:drop-shadow(0 8px 12px rgba(0,0,0,.4));
    }

    .prize-display{
      font-size:16px;
      font-weight:800;
      margin-top:16px;
      color:var(--primary-2);
      min-height:24px;
    }

    .spin-info{
      font-size:13px;
      color:var(--muted);
      margin-top:12px;
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:16px;
      width:min(500px, calc(100% - 20px));
      background:rgba(12,20,36,.92);
      border:1px solid rgba(255,255,255,.08);
      box-shadow:0 20px 50px rgba(0,0,0,.45);
      border-radius:24px;
      padding:10px;
      display:grid;
      grid-template-columns:repeat(5,1fr);
      gap:8px;
      backdrop-filter: blur(12px);
      z-index:100;
    }

    .nav-btn{
      border:none;
      cursor:pointer;
      background:transparent;
      color:#9fb0d1;
      border-radius:16px;
      padding:10px 8px;
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:4px;
      transition:.2s ease;
      font-weight:700;
      font-size:10px;
    }
    .nav-btn:hover{background:rgba(255,255,255,.04)}
    .nav-btn.active{
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      color:#fff;
      box-shadow:0 10px 25px rgba(34,197,94,.25);
    }
    .nav-icon{font-size:20px}

    .page-header{
      display:flex;
      align-items:center;
      gap:16px;
      margin-bottom:24px;
      padding:16px;
      background:linear-gradient(135deg,#111c31,#0d1627);
      border:1px solid var(--line);
      border-radius:18px;
    }
    .back-btn{
      background:rgba(255,255,255,.1);
      border:1px solid var(--line);
      color:#fff;
      width:40px;height:40px;
      border-radius:12px;
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      font-size:18px;
      transition:.2s ease;
    }
    .back-btn:hover{background:rgba(255,255,255,.15)}

    .page-title{
      font-size:24px;
      font-weight:900;
    }

    .profile-section{
      background:linear-gradient(135deg,#111c31,#0d1627);
      border:1px solid var(--line);
      border-radius:18px;
      padding:20px;
      margin-bottom:16px;
      box-shadow:var(--shadow);
    }
    .profile-item{
      display:grid;
      gap:8px;
      margin-bottom:16px;
    }
    .profile-label{
      font-size:12px;
      color:var(--muted);
      text-transform:uppercase;
      font-weight:700;
      letter-spacing:.3px;
    }
    .profile-value{
      font-size:15px;
      font-weight:700;
      color:#fff;
    }

    .password-change-form{
      background:rgba(255,255,255,.05);
      border:1px solid var(--line);
      border-radius:14px;
      padding:16px;
      margin-top:16px;
    }

    .support-link{
      background:linear-gradient(135deg,#111c31,#0d1627);
      border:1px solid var(--line);
      border-radius:14px;
      padding:16px;
      margin-bottom:12px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      text-decoration:none;
      color:inherit;
      transition:.2s ease;
      cursor:pointer;
    }
    .support-link:hover{
      border-color:rgba(34,197,94,.35);
      background:linear-gradient(135deg,#14223b,#0f1830);
    }
    .support-link-text{
      flex:1;
    }
    .support-link-text h4{
      margin:0 0 4px;
      font-size:15px;
      font-weight:800;
    }
    .support-link-text p{
      margin:0;
      font-size:12px;
      color:var(--muted);
    }
    .support-link-icon{
      font-size:20px;
    }

    .referral-stats{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
      margin-bottom:16px;
    }
    .ref-stat{
      background:linear-gradient(135deg,#111c31,#0d1627);
      border:1px solid var(--line);
      border-radius:14px;
      padding:16px;
      text-align:center;
    }
    .ref-stat-label{
      font-size:12px;
      color:var(--muted);
      margin-bottom:8px;
    }
    .ref-stat-value{
      font-size:24px;
      font-weight:900;
      color:var(--primary-2);
    }

    .copy-btn, .share-btn{
      width:100%;
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      color:#fff;
      border:none;
      border-radius:12px;
      padding:12px;
      font-weight:700;
      cursor:pointer;
      margin-bottom:12px;
      transition:.2s ease;
    }
    .copy-btn:hover, .share-btn:hover{transform:translateY(-2px)}

    .terms-text{
      background:rgba(255,255,255,.03);
      border:1px solid var(--line);
      border-radius:14px;
      padding:16px;
      font-size:13px;
      line-height:1.8;
      color:#d4e0f9;
      max-height:600px;
      overflow-y:auto;
    }
    .terms-text h4{
      margin:16px 0 8px;
      font-size:14px;
      font-weight:800;
      color:#fff;
    }
    .terms-text p{
      margin:0 0 12px;
    }

    .tx-table{
      width:100%;
      border-collapse:collapse;
      background:#0e182b;
      border:1px solid var(--line);
      border-radius:14px;
      overflow:hidden;
    }
    .tx-table th{
      background:#101c31;
      color:#b9c7e6;
      padding:12px;
      text-align:left;
      font-size:12px;
      font-weight:700;
      text-transform:uppercase;
      border-bottom:1px solid var(--line);
    }
    .tx-table td{
      padding:12px;
      border-bottom:1px solid rgba(255,255,255,.06);
      font-size:13px;
    }

    .logout-btn{
      background:linear-gradient(135deg,var(--danger),#f87171);
      color:#fff;
      border:none;
      border-radius:12px;
      padding:13px;
      font-weight:800;
      cursor:pointer;
      width:100%;
      transition:.2s ease;
      box-shadow:0 10px 25px rgba(239,68,68,.25);
      margin-top:20px;
    }
    .logout-btn:hover{transform:translateY(-2px)}

    .muted{color:var(--muted)}
    .center{text-align:center}
    .hidden{display:none !important}

    @media (max-width: 1080px){
      .stats-cards,.quick-actions-grid{grid-template-columns:1fr}
      .city-grid,.task-grid{grid-template-columns:repeat(2,1fr)}
      .auth-simple{width:min(360px,100%);padding:30px}
    }

    @media (max-width: 720px){
      .container{padding:14px 12px 110px}
      .auth-simple{width:100%;padding:24px}
      .stats-cards,.city-grid,.task-grid{grid-template-columns:1fr}
      .bottom-nav{
        border-radius:18px;
        padding:8px;
        width:calc(100% - 12px);
      }
      .nav-btn{padding:8px 4px;font-size:9px}
      .nav-icon{font-size:18px}
    }
  </style>
</head>
<body>
  <% const hasUser = !!user; %>
  <% const userName = user ? (user.name || (user.email ? user.email.split('@')[0] : 'Investor')) : 'Investor'; %>
  <% const firstLetter = userName ? userName.charAt(0).toUpperCase() : 'B'; %>
  <% const totalTasks = hasUser ? taskLimitToday : 0; %>
  <% const completedTasks = hasUser ? Number(user.tasksCompletedToday || 0) : 0; %>
  <% const todayTasksClaimed = hasUser && Array.isArray(user.claimedTasksToday) ? user.claimedTasksToday : []; %>
  <% const isAdminUser = hasUser && isAdminPhone; %>

  <% function formatMoney(amount){ return `KSH ${Number(amount || 0).toLocaleString()}`; } %>

  <!-- AUTH PAGE -->
  <% if (!hasUser) { %>
    <div class="auth-wrap">
      <div class="auth-simple">
        <div class="auth-logo">
          <div class="auth-logo-icon">B7</div>
          <h1>Bitrex 722</h1>
        </div>

        <div class="auth-title">
          <h2>Welcome Back</h2>
          <p>Login to your account</p>
        </div>

        <% if (message) { %>
          <div class="flash success"><%= message %></div>
        <% } %>
        <% if (error) { %>
          <div class="flash error"><%= error %></div>
        <% } %>

        <!-- LOGIN FORM -->
        <div class="auth-section active" id="login-section">
          <form method="POST" action="/login">
            <div class="form-group">
              <label>Phone Number</label>
              <input type="tel" name="phone" placeholder="0712345678" required>
            </div>
            <div class="form-group">
              <label>Password</label>
              <div class="password-wrapper">
                <input type="password" id="login-password" name="password" placeholder="Enter password" required>
                <button type="button" class="password-toggle" onclick="togglePassword('login-password')">👁️</button>
              </div>
            </div>
            <button type="submit" class="btn-auth">Login</button>
          </form>

          <div class="auth-links">
            <div class="auth-link">
              <span>Don't have an account? </span>
              <button type="button" onclick="switchAuth('signup-section')">Sign Up</button>
            </div>
            <div class="auth-link">
              <button type="button" onclick="switchAuth('forgot-section')">Forgot Password?</button>
            </div>
          </div>
        </div>

        <!-- SIGNUP FORM -->
        <div class="auth-section" id="signup-section">
          <form method="POST" action="/signup">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="name" placeholder="John Doe">
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" placeholder="you@example.com" required>
            </div>
            <div class="form-group">
              <label>Phone Number</label>
              <input type="tel" name="phone" placeholder="0712345678" required>
            </div>
            <div class="form-group">
              <label>Password (6-8 characters)</label>
              <div class="password-wrapper">
                <input type="password" id="signup-password" name="password" placeholder="Enter password" required>
                <button type="button" class="password-toggle" onclick="togglePassword('signup-password')">👁️</button>
              </div>
            </div>
            <input type="hidden" name="referralCode" value="<%= referralFromQuery %>">
            <button type="submit" class="btn-auth">Sign Up</button>
          </form>

          <div class="auth-links">
            <div class="auth-link">
              <span>Already have an account? </span>
              <button type="button" onclick="switchAuth('login-section')">Login</button>
            </div>
          </div>
        </div>

        <!-- FORGOT PASSWORD FORM -->
        <div class="auth-section" id="forgot-section">
          <form method="POST" action="/forgot-password">
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" placeholder="you@example.com" required>
            </div>
            <div class="form-group">
              <label>New Password (6-8 characters)</label>
              <div class="password-wrapper">
                <input type="password" id="forgot-password" name="newPassword" placeholder="Enter new password" required>
                <button type="button" class="password-toggle" onclick="togglePassword('forgot-password')">👁️</button>
              </div>
            </div>
            <div class="form-group">
              <label>Confirm Password</label>
              <div class="password-wrapper">
                <input type="password" id="confirm-password" name="confirmNewPassword" placeholder="Confirm password" required>
                <button type="button" class="password-toggle" onclick="togglePassword('confirm-password')">👁️</button>
              </div>
            </div>
            <button type="submit" class="btn-auth">Reset Password</button>
          </form>

          <div class="auth-links">
            <div class="auth-link">
              <button type="button" onclick="switchAuth('login-section')">Back to Login</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      function switchAuth(sectionId) {
        document.querySelectorAll('.auth-section').forEach(el => el.classList.remove('active'));
        document.getElementById(sectionId).classList.add('active');
      }
      function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        input.type = input.type === 'password' ? 'text' : 'password';
      }
    </script>
