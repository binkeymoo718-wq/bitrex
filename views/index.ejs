<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f6f1e8" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <title>BITREX 722 | Alt</title>
  <style>
    :root{
      --bg:#f6f1e8;
      --paper:rgba(255,255,255,.78);
      --ink:#19202b;
      --muted:#6e7784;
      --line:rgba(25,32,43,.08);
      --gold:#c47f2f;
      --teal:#1f9fb1;
      --rose:#cc5b7e;
      --shadow:0 18px 42px rgba(17,23,34,.12);
      --radius:26px;
    }
    *{box-sizing:border-box}
    html,body{margin:0;min-height:100%;background:
      radial-gradient(circle at 12% 12%, rgba(196,127,47,.12), transparent 26%),
      radial-gradient(circle at 88% 18%, rgba(31,159,177,.12), transparent 26%),
      linear-gradient(180deg, #f6f1e8 0%, #f8f4ee 100%);
      color:var(--ink);
      font-family:"Segoe UI", Georgia, serif;
    }
    a{text-decoration:none;color:inherit}
    button,input,select{font:inherit}
    .wrap{width:min(1160px, calc(100% - 20px)); margin:0 auto; padding:16px 0 100px}
    .top{
      display:flex; justify-content:space-between; align-items:center; gap:12px;
      background:rgba(255,255,255,.75); border:1px solid var(--line); border-radius:999px;
      padding:14px 16px; box-shadow:var(--shadow); backdrop-filter:blur(12px);
      position:sticky; top:12px; z-index:10;
    }
    .brand{display:flex; align-items:center; gap:12px; font-weight:900; letter-spacing:.08em; text-transform:uppercase}
    .logo{
      width:42px;height:42px;border-radius:14px; display:grid; place-items:center;
      background:linear-gradient(135deg,var(--gold),var(--rose)); color:white; box-shadow:0 10px 20px rgba(196,127,47,.22)
    }
    .hint{color:var(--muted); font-size:.84rem}
    .hero{
      margin-top:18px; display:grid; grid-template-columns:1.1fr .9fr; gap:16px;
    }
    .card{
      background:var(--paper); border:1px solid var(--line); border-radius:var(--radius);
      box-shadow:var(--shadow); backdrop-filter:blur(10px);
    }
    .pad{padding:22px}
    h1,h2,h3,p{margin:0}
    h1{
      font-family:Georgia, "Times New Roman", serif;
      font-size:clamp(2rem,3.7vw,4.2rem);
      line-height:1; letter-spacing:-.04em;
    }
    .lead{margin-top:14px; color:var(--muted); line-height:1.7; max-width:62ch}
    .slabs{display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:18px}
    .slab{
      padding:14px; border-radius:18px; border:1px solid var(--line); background:rgba(255,255,255,.6)
    }
    .slab b{display:block; margin-top:6px}
    .grid{display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin-top:16px}
    .stats{display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px}
    .stat{padding:14px; border:1px solid var(--line); border-radius:18px; background:rgba(255,255,255,.6)}
    .label{font-size:.76rem; letter-spacing:.09em; text-transform:uppercase; color:var(--muted)}
    .value{display:block; margin-top:8px; font-size:1.25rem; font-weight:900}
    .tabs{display:flex; flex-wrap:wrap; gap:8px; margin-top:14px}
    .tabs a,.nav a,.btn,.ghost{
      border:1px solid var(--line); border-radius:999px; padding:10px 14px; font-weight:800;
      background:rgba(255,255,255,.6); color:var(--ink)
    }
    .tabs a.active,.nav a.active{
      background:linear-gradient(135deg,var(--teal),#5ea2ff); color:white; border-color:transparent
    }
    .btn{
      background:linear-gradient(135deg,var(--gold),#f0b55e); color:white; border-color:transparent
    }
    .ghost{background:transparent}
    .note{color:var(--muted); line-height:1.6; font-size:.95rem}
    .field,.select{
      width:100%; padding:13px 14px; border-radius:16px; border:1px solid var(--line);
      background:white; color:var(--ink)
    }
    .field:focus,.select:focus{outline:none; border-color:rgba(31,159,177,.55); box-shadow:0 0 0 4px rgba(31,159,177,.1)}
    .form{display:grid; gap:10px; margin-top:14px}
    .fields{display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px}
    .pane{display:none}
    .pane.active{display:block}
    .city-list{display:grid; gap:12px}
    .city{
      overflow:hidden; border-radius:22px; background:rgba(255,255,255,.72); border:1px solid var(--line)
    }
    .city img{display:block; width:100%; height:150px; object-fit:cover}
    .city-body{padding:14px}
    .city-top{display:flex; justify-content:space-between; gap:10px; align-items:flex-start}
    .badge{display:inline-flex; padding:6px 10px; border-radius:999px; background:rgba(31,159,177,.12); color:#156d7a; font-size:.75rem; font-weight:900; text-transform:uppercase}
    .badge.free{background:rgba(60,211,159,.14); color:#15714f}
    .row{display:flex; justify-content:space-between; gap:12px; padding:10px 0; border-bottom:1px solid rgba(25,32,43,.06); color:var(--muted)}
    .row:last-child{border-bottom:none}
    .row strong{color:var(--ink)}
    .feed{display:grid; gap:10px}
    .tx{
      padding:12px 14px; border:1px solid var(--line); border-radius:18px; background:rgba(255,255,255,.62);
      display:flex; justify-content:space-between; gap:10px
    }
    .tx small{display:block; margin-top:4px; color:var(--muted)}
    .bottom{
      position:fixed; left:50%; transform:translateX(-50%); bottom:12px;
      width:min(1160px, calc(100% - 14px)); display:grid; grid-template-columns:repeat(4,minmax(0,1fr));
      gap:8px; padding:10px; border-radius:24px; background:rgba(255,255,255,.88); border:1px solid var(--line);
      box-shadow:var(--shadow); backdrop-filter:blur(14px)
    }
    .bottom a{padding:12px 8px; text-align:center; border-radius:18px; font-weight:900; color:var(--muted)}
    .bottom a.active{background:rgba(196,127,47,.12); color:var(--gold)}
    .footer{text-align:center; color:var(--muted); padding-top:18px; font-size:.88rem}
    @media (max-width: 960px){
      .hero,.grid,.slabs,.stats,.fields{grid-template-columns:1fr}
      .top{position:static; border-radius:24px}
      .bottom{left:0; transform:none; width:calc(100% - 14px)}
    }
  </style>
</head>
<body>
<%
  const money = (v) => new Intl.NumberFormat('en-KE').format(Number(v || 0));
  const tab = activeTab || 'home';
  const isLogged = Boolean(user);
  const cities = Object.entries(cityConfig || {});
  const activeCities = Array.isArray(user?.activeCities) ? user.activeCities : [];
  const txs = Array.isArray(user?.transactions) ? user.transactions.slice(0, 6) : [];
  const authTab = authMode || 'login';
%>

<div class="wrap">
  <header class="top">
    <div class="brand">
      <div class="logo">B</div>
      <div>
        <div>BITREX 722</div>
        <div class="hint">Clean alternate presentation</div>
      </div>
    </div>
    <div class="hint"><%= isLogged ? 'Account open' : 'Guest preview' %></div>
  </header>

  <% if (message || error) { %>
    <div class="grid" style="grid-template-columns:1fr; margin-top:16px;">
      <% if (message) { %><div class="card pad"><strong>Success:</strong> <%= message %></div><% } %>
      <% if (error) { %><div class="card pad"><strong>Alert:</strong> <%= error %></div><% } %>
    </div>
  <% } %>

  <section class="hero pane <%= tab === 'home' ? 'active' : '' %>">
    <div class="card pad">
      <h1>A softer, editorial-looking BITREX homepage.</h1>
      <p class="lead">This version is intentionally very different: lighter surfaces, serif headlines, and a more magazine-style spacing system while still using the same backend routes.</p>
      <div class="slabs">
        <div class="slab"><span class="label">Format</span><b>Bottom navigation</b></div>
        <div class="slab"><span class="label">Render</span><b>Simple deployment</b></div>
        <div class="slab"><span class="label">Tabs</span><b>Own query page</b></div>
      </div>
      <div class="tabs">
        <a class="<%= authTab === 'login' ? 'active' : '' %>" href="/?tab=home&auth=login">Login</a>
        <a class="<%= authTab === 'signup' ? 'active' : '' %>" href="/?tab=home&auth=signup">Signup</a>
        <a class="<%= authTab === 'forgot' ? 'active' : '' %>" href="/?tab=home&auth=forgot">Forgot</a>
      </div>
    </div>
    <div class="card pad">
      <div class="stats">
        <div class="stat"><span class="label">Balance</span><span class="value">KSH <%= money(user?.balance) %></span></div>
        <div class="stat"><span class="label">Today</span><span class="value">KSH <%= money(user?.todayIncome) %></span></div>
        <div class="stat"><span class="label">Gems</span><span class="value"><%= money(user?.gems) %></span></div>
        <div class="stat"><span class="label">Spins</span><span class="value"><%= money(user?.freeSpins) %></span></div>
      </div>
      <div class="card pad" style="margin-top:12px; background:rgba(255,255,255,.45);">
        <span class="label">Referral</span>
        <div style="margin-top:8px; font-weight:900; font-size:1.2rem;"><%= user?.referralCode || 'N/A' %></div>
        <div class="note" style="margin-top:6px;">The profile tab contains the share link and password tools.</div>
      </div>
    </div>
  </section>

  <% if (!isLogged) { %>
    <section class="grid pane <%= tab === 'home' ? 'active' : '' %>">
      <div class="card pad">
        <h2>Account access</h2>
        <p class="note" style="margin-top:10px;">This stays compact and uses the existing auth routes exactly as the server expects.</p>
        <% if (authTab === 'signup') { %>
          <form class="form" action="/signup" method="post">
            <div class="fields">
              <input class="field" name="name" placeholder="Full name" required />
              <input class="field" name="phone" placeholder="Phone number" required />
              <input class="field" name="email" type="email" placeholder="Email address" required />
              <input class="field" name="password" type="password" minlength="6" maxlength="8" placeholder="Password 6-8 chars" required />
            </div>
            <input class="field" name="referralCode" value="<%= referralFromQuery || '' %>" placeholder="Referral code" />
            <button class="btn" type="submit">Create account</button>
          </form>
        <% } else if (authTab === 'forgot') { %>
          <form class="form" action="/forgot-password" method="post">
            <input class="field" name="email" type="email" placeholder="Registered email" required />
            <div class="fields">
              <input class="field" name="newPassword" type="password" minlength="6" maxlength="8" placeholder="New password" required />
              <input class="field" name="confirmNewPassword" type="password" minlength="6" maxlength="8" placeholder="Confirm password" required />
            </div>
            <button class="btn" type="submit">Reset password</button>
          </form>
        <% } else { %>
          <form class="form" action="/login" method="post">
            <input class="field" name="phone" placeholder="Phone number" required />
            <input class="field" name="password" type="password" placeholder="Password" required />
            <button class="btn" type="submit">Login</button>
          </form>
        <% } %>
      </div>
      <div class="card pad">
        <h2>Why this version</h2>
        <p class="note" style="margin-top:10px;">It keeps the same server behavior, but the visual language is much calmer and more premium-looking than the first version.</p>
      </div>
    </section>
  <% } %>

  <section class="pane <%= tab === 'city' ? 'active' : '' %>">
    <div class="grid">
      <div class="card pad">
        <h2>City packages</h2>
        <p class="note" style="margin-top:10px;">Join a city from this screen using the existing route and a contract signature.</p>
        <div class="city-list" style="margin-top:14px;">
          <% cities.forEach(([code, city]) => { %>
            <article class="city">
              <img src="<%= city.image %>" alt="<%= city.city %>" />
              <div class="city-body">
                <div class="city-top">
                  <div>
                    <h3><%= city.city %></h3>
                    <div class="note">Code <%= code %></div>
                  </div>
                  <span class="badge <%= city.free ? 'free' : '' %>"><%= city.free ? 'Free start' : 'Paid plan' %></span>
                </div>
                <div class="row"><span>Amount</span><strong>KSH <%= money(city.amount) %></strong></div>
                <div class="row"><span>Tasks/day</span><strong><%= money(city.tasksPerDay) %></strong></div>
                <div class="row"><span>Income/day</span><strong>KSH <%= money(city.dailyIncome) %></strong></div>
                <div class="row"><span>Duration</span><strong><%= money(city.durationDays) %> days</strong></div>
                <% if (isLogged) { %>
                  <form class="form" action="/invest/<%= code %>" method="post">
                    <input class="field" name="signature" placeholder="Type your signature" required />
                    <button class="btn" type="submit">Join city</button>
                  </form>
                <% } else { %>
                  <div class="note" style="margin-top:10px;">Login to activate this package.</div>
                <% } %>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
      <div class="card pad">
        <h2>Joined cities</h2>
        <div class="feed" style="margin-top:14px;">
          <% if (activeCities.length) { %>
            <% activeCities.forEach((code) => { const city = cityConfig[code]; %>
              <div class="tx">
                <div><strong><%= city.city %></strong><small>Package <%= code %></small></div>
                <div class="badge">Active</div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="card pad">
              <div class="note">No city joined yet.</div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <section class="pane <%= tab === 'task' ? 'active' : '' %>">
    <div class="grid">
      <div class="card pad">
        <h2>Task center</h2>
        <div class="stats" style="margin-top:14px;">
          <div class="stat"><span class="label">Completed</span><span class="value"><%= money(user?.tasksCompletedToday) %></span></div>
          <div class="stat"><span class="label">Limit</span><span class="value"><%= money(taskLimitToday) %></span></div>
        </div>
        <% if (isLogged) { %>
          <form class="form" action="/task" method="post">
            <select class="select" name="taskName" required>
              <% (tasks || []).forEach((task) => { %>
                <option value="<%= task %>"><%= task %></option>
              <% }) %>
            </select>
            <button class="btn" type="submit">Claim KSH 50</button>
          </form>
        <% } else { %>
          <div class="note" style="margin-top:14px;">Login first, then join a city to unlock task claims.</div>
        <% } %>
      </div>
      <div class="card pad">
        <h2>Recent activity</h2>
        <div class="feed" style="margin-top:14px;">
          <% if (txs.length) { %>
            <% txs.forEach((tx) => { %>
              <div class="tx">
                <div>
                  <strong><%= tx.type || 'Transaction' %></strong>
                  <small><%= tx.detail || 'No details' %></small>
                </div>
                <div style="text-align:right;">
                  <div class="badge"><%= tx.status || 'PENDING' %></div>
                  <div style="margin-top:8px; font-weight:900;">KSH <%= money(tx.amount) %></div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="note">No recent activity yet.</div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <section class="pane <%= tab === 'menu' ? 'active' : '' %>">
    <div class="grid">
      <div class="card pad">
        <h2>Wallet tools</h2>
        <% if (isLogged) { %>
          <form class="form" action="/deposit" method="post">
            <div class="fields">
              <input class="field" name="amount" type="number" min="200" step="1" placeholder="Deposit amount" required />
              <input class="field" name="phone" placeholder="Phone number" required />
            </div>
            <button class="btn" type="submit">Send deposit push</button>
          </form>
          <form class="form" action="/withdraw" method="post" style="margin-top:14px;">
            <div class="fields">
              <input class="field" name="amount" type="number" min="300" step="1" placeholder="Withdraw amount" required />
              <input class="field" name="phone" placeholder="Phone number" required />
            </div>
            <input class="field" name="withdrawalPassword" type="password" placeholder="Withdrawal password" required />
            <button class="btn" type="submit">Request withdrawal</button>
          </form>
        <% } else { %>
          <div class="note" style="margin-top:14px;">Sign in to use wallet actions.</div>
        <% } %>
      </div>
      <div class="card pad">
        <h2>Profile tools</h2>
        <% if (isLogged) { %>
          <div class="card pad" style="margin-top:14px; background:rgba(255,255,255,.45);">
            <span class="label">Referral link</span>
            <input class="field" id="refAlt" readonly value="<%= referralLink || '' %>" style="margin-top:8px;" />
            <button class="ghost" type="button" style="margin-top:10px;" onclick="copyAlt()">Copy link</button>
          </div>
          <form class="form" action="/verify-email" method="post" style="margin-top:14px;">
            <button class="ghost" type="submit">Verify email</button>
          </form>
          <form class="form" action="/profile/password" method="post" style="margin-top:14px;">
            <div class="fields">
              <input class="field" name="currentPassword" type="password" placeholder="Current password" required />
              <input class="field" name="newPassword" type="password" minlength="6" maxlength="8" placeholder="New password" required />
            </div>
            <button class="ghost" type="submit">Update password</button>
          </form>
          <form class="form" action="/spin-roulette" method="post" style="margin-top:14px;">
            <button class="ghost" type="submit">Spin roulette</button>
          </form>
          <form class="form" action="/logout" method="post" style="margin-top:14px;">
            <button class="ghost" type="submit">Logout</button>
          </form>
        <% } else { %>
          <div class="note" style="margin-top:14px;">Login to unlock profile tools.</div>
        <% } %>
      </div>
    </div>
  </section>

  <div class="footer">Alternate theme for BITREX 722 with the same server routes.</div>
</div>

<nav class="bottom">
  <% ['home','city','task','menu'].forEach((key) => { %>
    <a class="<%= tab === key ? 'active' : '' %>" href="/?tab=<%= key %>"><%= key === 'menu' ? 'Wallet' : key.charAt(0).toUpperCase() + key.slice(1) %></a>
  <% }) %>
</nav>

<script>
  function copyAlt() {
    const input = document.getElementById('refAlt');
    if (!input) return;
    if (navigator.clipboard && input.value) {
      navigator.clipboard.writeText(input.value);
      return;
    }
    input.focus();
    input.select();
    document.execCommand('copy');
  }
</script>
</body>
</html>
