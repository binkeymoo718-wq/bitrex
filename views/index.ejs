<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BITREX Platform</title>
  <style>
    :root{--bg:#080f1f;--bg2:#0b1730;--card:#121d33cc;--line:#2f3e5d;--text:#f5f7f7;--muted:#a8b5d8;--blue:#4f8dff;--cyan:#35d3ff;--green:#22c55e;--red:#ef4444}
    *{box-sizing:border-box}
    body{margin:0;background:radial-gradient(1200px 600px at 20% -10%,#1f4ccf66,transparent),radial-gradient(900px 500px at 120% 20%,#0ea5e966,transparent),linear-gradient(180deg,var(--bg),var(--bg2));font-family:Inter,system-ui,Arial,sans-serif;color:var(--text)}
    .container{max-width:980px;margin:0 auto;padding:18px 16px 96px}
    .card{background:var(--card);backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:14px;box-shadow:0 10px 30px #00000055}
    .hero{display:flex;justify-content:space-between;align-items:center;gap:12px;background:linear-gradient(120deg,#2c65f8,#00b8f0)}
    .hero h2{margin:0;font-size:1.45rem}
    h3{margin:0 0 10px} .small{color:var(--muted);font-size:.93rem}
    .msg{padding:11px 12px;border-radius:10px;margin-bottom:12px;transition:opacity .4s ease,transform .4s ease}.ok{background:#062d19;color:#a7f3d0}.err{background:#3a0f14;color:#fecaca}
    .topbar{display:flex;justify-content:space-between;align-items:center;gap:10px}
    .pill-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
    .pill{background:linear-gradient(180deg,#0f1a31,#0c162b);border:1px solid #304268;border-radius:14px;padding:10px}
    .kpi{font-size:1.2rem;font-weight:700}
    .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    input,select,button{width:100%;padding:11px 12px;border-radius:12px;border:1px solid #304268;background:#0a1428;color:var(--text);margin:6px 0}
    input:focus,select:focus{outline:none;border-color:#5ea2ff;box-shadow:0 0 0 3px #3b82f633}
    button{border:none;background:linear-gradient(120deg,var(--blue),var(--cyan));font-weight:700;cursor:pointer;transition:.2s transform}
    button:hover{transform:translateY(-1px)}
    .btn-red{background:linear-gradient(120deg,#b91c1c,#ef4444)}
    .badge-link{display:inline-flex;align-items:center;gap:6px;padding:7px 11px;border:1px solid #6cc2ff;border-radius:999px;background:#0a3158;color:#d8f1ff;text-decoration:none;font-size:.82rem}
    table{width:100%;border-collapse:collapse}
    th,td{padding:9px 8px;border-bottom:1px solid #253654;font-size:.9rem;text-align:left}
    th{color:#c7d8ff;font-weight:600}
    .section{display:none}.section.active{display:block}
    .status{padding:2px 8px;border-radius:999px;font-size:.75rem;font-weight:700;display:inline-block}.PENDING{background:#78350f;color:#fde68a}.APPROVED{background:#14532d;color:#bbf7d0}.REJECTED{background:#7f1d1d;color:#fecaca}
    .bottom-nav{position:fixed;left:50%;transform:translateX(-50%);bottom:10px;width:min(960px,calc(100% - 16px));background:#0a1326cc;backdrop-filter:blur(8px);border:1px solid #2c3e63;border-radius:14px;display:grid;grid-template-columns:repeat(5,1fr);overflow:hidden;z-index:10}
    .bottom-nav button{margin:0;border-radius:0;background:transparent;border-right:1px solid #243654;padding:10px;color:#d8e6ff}
    .bottom-nav button:last-child{border-right:none}
    .copy-actions{display:flex;gap:8px;flex-wrap:wrap}
    .copy-actions button{width:auto;padding:6px 10px;border-radius:999px}
    .task-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
    .task-item{background:linear-gradient(180deg,#10203d,#0b1730);border:1px solid #2a4068;border-radius:14px;padding:12px}
    .task-head{display:flex;justify-content:space-between;align-items:center;gap:8px}
    .task-icon{font-size:22px}
    .task-title{font-weight:700;font-size:.95rem}
    .task-sub{font-size:.8rem;color:#9db3da;margin:8px 0 10px}
    .claim-btn{background:linear-gradient(120deg,#22c55e,#06b6d4)}
    .claim-btn[disabled]{opacity:.55;cursor:not-allowed}
    .action-buttons{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .action-link{display:block;text-align:center;padding:14px;border-radius:12px;text-decoration:none;color:#e8eeff;font-weight:700;border:1px solid #2a4068;background:linear-gradient(120deg,#1d4ed8,#0891b2)}
    .panel{display:none;margin-top:10px}
    .panel.active{display:block}
    .wheel-wrap{display:grid;place-items:center;gap:10px}
    .wheel{width:300px;height:300px;border-radius:50%;border:8px solid #fef3c7;position:relative;box-shadow:0 10px 24px #00000066;transition:transform 5s cubic-bezier(.17,.67,.12,.99);background:
      conic-gradient(from -30deg,
      #2563eb 0deg 60deg,
      #16a34a 60deg 120deg,
      #06b6d4 120deg 180deg,
      #9333ea 180deg 240deg,
      #dc2626 240deg 300deg,
      #f59e0b 300deg 360deg);}
    .wheel::before{content:'';position:absolute;inset:28%;background:radial-gradient(circle,#7f1d1d,#4c0519);border:6px solid #fef3c7;border-radius:50%;z-index:2}
    .wheel-label{position:absolute;left:50%;top:50%;transform-origin:0 0;color:#fff7d6;font-weight:800;font-size:22px;text-shadow:0 2px 4px #000}
    .pointer{width:0;height:0;border-left:14px solid transparent;border-right:14px solid transparent;border-top:28px solid #fef3c7;filter:drop-shadow(0 2px 4px #000);margin-bottom:-8px;z-index:3}
    .spin-center{position:absolute;inset:41%;display:grid;place-items:center;z-index:3;color:#fff7d6;font-weight:900;font-size:30px}
    .city-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
    .city-card{min-height:420px;border-radius:24px;overflow:hidden;position:relative;border:1px solid #6d5dfc99;background-size:cover;background-position:center;box-shadow:0 16px 34px #00000080}
    .city-card::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#02061733 15%,#020617bb 62%,#020617f2 100%)}
    .city-content{position:absolute;inset:0;padding:18px;display:flex;flex-direction:column;justify-content:space-between;z-index:1}
    .city-name{align-self:flex-start;padding:8px 20px;border-radius:999px;background:linear-gradient(120deg,#9333ea,#60a5fa);box-shadow:0 0 20px #a855f780;font-size:1.2rem;font-weight:900;letter-spacing:.04em}
    .city-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:auto}
    .city-stat{padding:12px;border-radius:18px;background:#111827cc;border:1px solid #a78bfa99;box-shadow:inset 0 0 18px #60a5fa33,0 0 16px #a855f755}
    .city-stat .value{font-size:1.35rem;font-weight:900;color:#fff}
    .signature-box{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end;margin-top:12px;padding:12px;border:1px solid #a78bfa99;border-radius:18px;background:#111827cc}
    .signature-box input{border-width:0 0 1px 0;border-radius:0;background:transparent;margin:0}
    .signature-box button{min-width:130px;background:linear-gradient(120deg,#047857,#22c55e)}
    .terms-box{max-height:360px;overflow:auto;line-height:1.55;color:#dce7ff}
    .terms-box h4{margin:16px 0 6px;color:#fff}
    .menu-list{display:grid;gap:10px}
    .menu-item{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;padding:15px;border-radius:14px;border:1px solid #2a4068;background:linear-gradient(120deg,#0f1f3d,#10284c);color:#e8eeff;text-decoration:none;font-weight:800;cursor:pointer}
    .menu-item span:first-child{display:flex;align-items:center;gap:10px}
    .menu-detail{display:none}
    .menu-detail.active{display:block}
    .back-btn{width:auto;padding:9px 13px;margin-bottom:12px;border-radius:999px;background:linear-gradient(120deg,#334155,#0f172a);border:1px solid #64748b}
    @media(max-width:820px){.pill-grid,.row{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}}
  </style>
</head>
<body>
  <div class="container">
    <% if (error) { %><div class="msg err"><%= error %></div><% } %>
    <% if (message) { %><div class="msg ok"><%= message %></div><% } %>

    <% if (!user) { %>
      <div class="card hero">
        <div>
          <h2>Welcome to BITREX Business Platform👋</h2>
          <div class="small" style="color:#ecfeff">Create an account,log in,Navigate to cities,invest on your preferences,complete daily task to grow your account📈.</div>
        </div>
      </div>
      <% if (authMode === 'login') { %>
        <div class="card">
          <h3>Login</h3>
          <form method="post" action="/login">
            <input name="phone" placeholder="Phone Number" required />
            <input name="password" type="password" placeholder="Password" required />
            <button type="submit">Log In</button>
          </form>
          <p class="small"><a href="#" style="color:#93c5fd" onclick="document.getElementById('forgotBox').style.display='block';return false;">Forgot password?</a></p>
