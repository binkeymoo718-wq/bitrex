<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BITREX-722</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"/>

  <style>
    :root{
      --bg-1:#0b1020;
      --bg-2:#121a33;
      --panel:#11182d;
      --panel-2:#16213e;
      --card:#182544;
      --card-2:#1d2c53;
      --line:rgba(255,255,255,.08);
      --text:#f5f7ff;
      --muted:#a8b0c8;
      --primary:#4f8cff;
      --primary-2:#6ea8ff;
      --success:#1fce7a;
      --danger:#ff5c7a;
      --warning:#ffb84d;
      --shadow:0 18px 50px rgba(0,0,0,.35);
      --radius:22px;
      --radius-sm:16px;
    }

    *{box-sizing:border-box}
    html,body{margin:0;padding:0;font-family:'Inter',system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:
      radial-gradient(circle at top right, rgba(79,140,255,.18), transparent 28%),
      radial-gradient(circle at bottom left, rgba(31,206,122,.14), transparent 30%),
      linear-gradient(160deg,var(--bg-1),var(--bg-2));
      color:var(--text);min-height:100%;
    }

    a{text-decoration:none;color:inherit}
    button,input,textarea,select{font:inherit}

    .app-shell{
      max-width: 1180px;
      margin: 0 auto;
      padding: 20px 18px 110px;
    }

    .glass{
      background: rgba(17,24,45,.88);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
      backdrop-filter: blur(16px);
    }

    .top-banner{
      margin-bottom:18px;
      border-radius: 24px;
      padding: 18px 20px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      background:
        linear-gradient(135deg, rgba(79,140,255,.22), rgba(31,206,122,.12)),
        rgba(17,24,45,.88);
      border:1px solid rgba(255,255,255,.08);
      box-shadow: var(--shadow);
    }

    .brand-wrap{
      display:flex;
      align-items:center;
      gap:14px;
    }

    .brand-logo{
      width:54px;height:54px;border-radius:18px;
      display:grid;place-items:center;
      background: linear-gradient(135deg, #4f8cff, #7c5cff);
      color:#fff;font-size:24px;box-shadow:0 10px 24px rgba(79,140,255,.35);
      flex-shrink:0;
    }

    .brand-title{
      font-size:22px;
      font-weight:800;
      letter-spacing:.4px;
      margin:0;
    }

    .brand-sub{
      margin:4px 0 0;
      color:var(--muted);
      font-size:13px;
    }

    .phone-chip{
      display:inline-flex;
      align-items:center;
      gap:10px;
      background: rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.08);
      padding: 10px 14px;
      border-radius: 999px;
      font-size:14px;
      color:#fff;
      white-space:nowrap;
    }

    .phone-chip i{
      color: var(--primary-2);
    }

    .alert-stack{
      display:grid;
      gap:12px;
      margin-bottom:18px;
    }

    .alert{
      border-radius:18px;
      padding:14px 16px;
      font-size:14px;
      display:flex;
      gap:12px;
      align-items:flex-start;
      border:1px solid transparent;
      box-shadow: var(--shadow);
    }

    .alert i{margin-top:2px}
    .alert-success{
      background: rgba(31,206,122,.12);
      border-color: rgba(31,206,122,.28);
      color:#e9fff3;
    }
    .alert-error{
      background: rgba(255,92,122,.12);
      border-color: rgba(255,92,122,.28);
      color:#fff1f4;
    }

    /* ================= LOGIN PAGE ================= */
    .auth-page{
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      padding: 24px;
    }

    .auth-card{
      width:100%;
      max-width:460px;
      border-radius:28px;
      padding:32px 28px;
      background:
        linear-gradient(180deg, rgba(79,140,255,.12), rgba(255,255,255,.02)),
        rgba(17,24,45,.95);
      border:1px solid rgba(255,255,255,.08);
      box-shadow: var(--shadow);
      position:relative;
      overflow:hidden;
    }

    .auth-card::before{
      content:'';
      position:absolute;
      width:180px;height:180px;
      border-radius:50%;
      background: radial-gradient(circle, rgba(79,140,255,.35), transparent 65%);
      top:-50px;right:-50px;
      pointer-events:none;
    }

    .auth-card::after{
      content:'';
      position:absolute;
      width:160px;height:160px;
      border-radius:50%;
      background: radial-gradient(circle, rgba(31,206,122,.22), transparent 65%);
      bottom:-60px;left:-60px;
      pointer-events:none;
    }

    .auth-header{
      position:relative;
      z-index:2;
      text-align:center;
      margin-bottom:26px;
    }

    .auth-logo{
      width:74px;height:74px;
      margin:0 auto 16px;
      border-radius:22px;
      display:grid;place-items:center;
      font-size:30px;
      background: linear-gradient(135deg, #4f8cff, #7c5cff);
      box-shadow: 0 18px 40px rgba(79,140,255,.35);
    }

    .auth-title{
      margin:0;
      font-size:28px;
      font-weight:800;
      letter-spacing:.3px;
    }

    .auth-sub{
      margin:8px 0 0;
      color:var(--muted);
      font-size:14px;
      line-height:1.6;
    }

    .auth-tabs{
      display:flex;
      gap:10px;
      margin-bottom:22px;
      position:relative;
      z-index:2;
    }

    .auth-tab-btn{
      flex:1;
      padding:12px 14px;
      border-radius:14px;
      border:1px solid rgba(255,255,255,.08);
      background: rgba(255,255,255,.04);
      color:var(--muted);
      font-weight:700;
      text-align:center;
      cursor:pointer;
      transition:.2s ease;
    }

    .auth-tab-btn.active{
      background: linear-gradient(135deg, rgba(79,140,255,.24), rgba(124,92,255,.2));
      color:#fff;
      border-color: rgba(79,140,255,.35);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.04);
    }

    .auth-panel{
      display:none;
      position:relative;
      z-index:2;
    }
    .auth-panel.active{display:block}

    .form-group{
      margin-bottom:16px;
    }

    .form-label{
      display:block;
      font-size:13px;
      font-weight:700;
      color:#dce4ff;
      margin-bottom:8px;
    }

    .input-wrap{
      position:relative;
    }

    .form-control{
      width:100%;
      border:none;
      outline:none;
      border-radius:16px;
      background: rgba(255,255,255,.06);
      color:#fff;
      border:1px solid rgba(255,255,255,.08);
      padding:14px 16px;
      font-size:15px;
      transition:.2s ease;
    }

    .form-control::placeholder{color:#8f9aba}
    .form-control:focus{
      border-color: rgba(79,140,255,.55);
      box-shadow: 0 0 0 4px rgba(79,140,255,.14);
      background: rgba(255,255,255,.08);
    }

    .password-toggle{
      position:absolute;
      top:50%;
      right:14px;
      transform:translateY(-50%);
      background:none;
      border:none;
      color:#aab6d6;
      cursor:pointer;
      font-size:16px;
      padding:0;
    }

    .btn{
      border:none;
      outline:none;
      cursor:pointer;
      border-radius:16px;
      padding:14px 16px;
      font-weight:800;
      transition:.2s ease;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
    }

    .btn-primary{
      width:100%;
      background: linear-gradient(135deg, #4f8cff, #6a7bff);
      color:#fff;
      box-shadow: 0 18px 35px rgba(79,140,255,.25);
    }

    .btn-primary:hover{transform:translateY(-1px)}
    .btn-ghost{
      background: rgba(255,255,255,.05);
      color:#fff;
      border:1px solid rgba(255,255,255,.08);
    }
    .btn-success{
      background: linear-gradient(135deg, #19c96d, #15a85b);
      color:#fff;
    }
    .btn-warning{
      background: linear-gradient(135deg, #ffb84d, #ff9f1a);
      color:#1b1405;
    }
    .btn-danger{
      background: linear-gradient(135deg, #ff4f73, #ff2f5c);
      color:#fff;
    }
    .btn-dark{
      background: rgba(255,255,255,.08);
      color:#fff;
      border:1px solid rgba(255,255,255,.08);
    }

    .auth-actions{
      display:flex;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
      margin-top:10px;
      font-size:14px;
      color:var(--muted);
    }

    .auth-link{
      color:#9ec0ff;
      font-weight:700;
      cursor:pointer;
    }

    .auth-note{
      margin-top:18px;
      padding:12px 14px;
      border-radius:14px;
      background: rgba(255,255,255,.04);
      color:var(--muted);
      font-size:13px;
      line-height:1.6;
    }

    /* ================= DASHBOARD ================= */
    .dashboard-grid{
      display:grid;
      gap:18px;
    }

    .stats-grid{
      display:grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap:16px;
    }

    .stat-card{
      border-radius:22px;
      padding:18px;
      background:
        linear-gradient(160deg, rgba(255,255,255,.04), rgba(255,255,255,.02)),
        rgba(24,37,68,.88);
      border:1px solid rgba(255,255,255,.08);
      box-shadow: var(--shadow);
      position:relative;
      overflow:hidden;
    }

    .stat-card::after{
      content:'';
      position:absolute;
      width:120px;height:120px;
      border-radius:50%;
      background: radial-gradient(circle, rgba(255,255,255,.08), transparent 65%);
      right:-30px;top:-30px;
      pointer-events:none;
    }

    .stat-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:14px;
    }

    .stat-icon{
      width:48px;height:48px;border-radius:16px;
      display:grid;place-items:center;
      font-size:18px;
      background: rgba(255,255,255,.08);
      color:#fff;
    }

    .stat-label{
      color:var(--muted);
      font-size:13px;
      font-weight:600;
      margin-bottom:8px;
    }

    .stat-value{
      font-size:28px;
      font-weight:800;
      letter-spacing:.3px;
      margin:0;
    }

    .stat-card.balance .stat-icon{background: rgba(79,140,255,.18); color:#8bb4ff}
    .stat-card.income .stat-icon{background: rgba(31,206,122,.18); color:#7ff0b1}
    .stat-card.earnings .stat-icon{background: rgba(255,184,77,.18); color:#ffd38a}

    .section-grid{
      display:grid;
      grid-template-columns: 1.2fr .8fr;
      gap:18px;
    }

    .panel{
      border-radius:24px;
      padding:20px;
      background: rgba(17,24,45,.9);
      border:1px solid rgba(255,255,255,.08);
      box-shadow: var(--shadow);
    }

    .panel-title{
      margin:0 0 16px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }

    .panel-title h3{
      margin:0;
      font-size:18px;
      font-weight:800;
      letter-spacing:.2px;
    }

    .panel-title p{
      margin:4px 0 0;
      color:var(--muted);
      font-size:13px;
    }

    .card-grid-2{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:16px;
    }

    .action-card{
      border-radius:20px;
      padding:18px;
      background:
        linear-gradient(160deg, rgba(255,255,255,.04), rgba(255,255,255,.015)),
        rgba(24,37,68,.85);
      border:1px solid rgba(255,255,255,.08);
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .action-head{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .action-icon{
      width:44px;height:44px;border-radius:14px;
      display:grid;place-items:center;
      background: rgba(255,255,255,.08);
      font-size:18px;
    }

    .action-title{
      margin:0;
      font-size:16px;
      font-weight:800;
    }

    .action-sub{
      margin:3px 0 0;
      color:var(--muted);
      font-size:13px;
    }

    .mini-inputs{
      display:grid;
      gap:12px;
    }

    .investments-list{
      display:grid;
      gap:14px;
    }

    .investment-item{
      border-radius:18px;
      padding:16px;
      background: rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:14px;
    }

    .investment-left h4{
      margin:0 0 8px;
      font-size:16px;
      font-weight:800;
    }

    .meta-list{
      display:grid;
      gap:6px;
      color:var(--muted);
      font-size:13px;
    }

    .badge{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 12px;
      border-radius:999px;
      font-size:12px;
      font-weight:800;
      white-space:nowrap;
    }

    .badge.active{
      background: rgba(31,206,122,.15);
      color:#a7ffd0;
      border:1px solid rgba(31,206,122,.25);
    }

    .badge.pending{
      background: rgba(255,184,77,.12);
      color:#ffd38a;
      border:1px solid rgba(255,184,77,.22);
    }

    .badge.claimed{
      background: rgba(79,140,255,.14);
      color:#b8d0ff;
      border:1px solid rgba(79,140,255,.22);
    }

    /* tabs */
    .tab-view{
      display:none;
      animation: fadeIn .22s ease;
    }
    .tab-view.active{display:block}

    @keyframes fadeIn{
      from{opacity:0;transform:translateY(6px)}
      to{opacity:1;transform:none}
    }

    .task-grid,
    .cities-grid,
    .menu-list{
      display:grid;
      gap:16px;
    }

    .task-grid{
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .task-card{
      border-radius:22px;
      padding:18px;
      background:
        linear-gradient(160deg, rgba(255,255,255,.04), rgba(255,255,255,.02)),
        rgba(24,37,68,.88);
      border:1px solid rgba(255,255,255,.08);
      box-shadow: var(--shadow);
      display:flex;
      flex-direction:column;
      gap:14px;
      min-height: 240px;
    }

    .task-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
    }

    .task-name{
      margin:0;
      font-size:16px;
      font-weight:800;
      line-height:1.5;
    }

    .task-price{
      margin:0;
      color:var(--muted);
      font-size:13px;
    }

    .reward-pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 12px;
      border-radius:999px;
      background: rgba(31,206,122,.14);
      color:#9ef0c3;
      border:1px solid rgba(31,206,122,.22);
      font-size:12px;
      font-weight:800;
      width:fit-content;
    }

    .task-progress{
      margin-top:auto;
      display:grid;
      gap:12px;
    }

    .countdown-box{
      border-radius:14px;
      padding:12px 14px;
      background: rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      font-size:13px;
      color:var(--muted);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
    }

    .city-card{
      border-radius:24px;
      overflow:hidden;
      background: rgba(17,24,45,.92);
      border:1px solid rgba(255,255,255,.08);
      box-shadow: var(--shadow);
    }

    .city-cover{
      position:relative;
      height:190px;
      background-size:cover;
      background-position:center;
    }

    .city-cover::after{
      content:'';
      position:absolute;inset:0;
      background: linear-gradient(180deg, rgba(0,0,0,.05), rgba(8,12,22,.82));
    }

    .city-chip{
      position:absolute;
      top:16px;left:16px;
      z-index:2;
      background: rgba(0,0,0,.45);
      border:1px solid rgba(255,255,255,.12);
      color:#fff;
      padding:8px 12px;
      border-radius:999px;
      font-size:12px;
      font-weight:800;
      backdrop-filter: blur(10px);
    }

    .city-body{
      padding:18px;
      position:relative;
      margin-top:-50px;
      z-index:2;
    }

    .city-title{
      margin:0 0 12px;
      font-size:22px;
      font-weight:800;
    }

    .city-metrics{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:12px;
      margin-bottom:14px;
    }

    .city-metric{
      border-radius:16px;
      padding:14px;
      background: rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.08);
    }

    .city-metric small{
      display:block;
      color:var(--muted);
      margin-bottom:6px;
      font-size:12px;
    }

    .city-metric strong{
      font-size:16px;
    }

    .city-form{
      display:grid;
      gap:12px;
      margin-top:10px;
    }

    /* spin */
    .spin-wrap{
      display:grid;
      grid-template-columns: 1fr .9fr;
      gap:18px;
      align-items:start;
    }

    .wheel-card{
      border-radius:24px;
      padding:24px;
      background: rgba(17,24,45,.92);
      border:1px solid rgba(255,255,255,.08);
      box-shadow: var(--shadow);
      text-align:center;
    }

    .wheel-circle{
      width: 280px;
      height: 280px;
      margin: 0 auto 20px;
      border-radius:50%;
      border:12px solid rgba(255,255,255,.08);
      position:relative;
      background:
        conic-gradient(
          #4f8cff 0deg 60deg,
          #19c96d 60deg 120deg,
          #ffb84d 120deg 180deg,
          #7c5cff 180deg 240deg,
          #00c2ff 240deg 300deg,
          #ff5c7a 300deg 360deg
        );
      box-shadow: inset 0 0 0 10px rgba(0,0,0,.18), 0 18px 40px rgba(0,0,0,.3);
      display:grid;
      place-items:center;
      transition: transform 4s cubic-bezier(.17,.67,.12,.99);
    }

    .wheel-center{
      width:100px;height:100px;border-radius:50%;
      background: rgba(10,14,26,.9);
      border:6px solid rgba(255,255,255,.12);
      display:grid;place-items:center;
      font-size:24px;
      color:#fff;
      box-shadow: inset 0 0 0 2px rgba(255,255,255,.04);
    }

    .wheel-pointer{
      width:0;height:0;
      border-left:16px solid transparent;
      border-right:16px solid transparent;
      border-top:28px solid #fff;
      margin:0 auto 14px;
      filter: drop-shadow(0 10px 18px rgba(0,0,0,.35));
    }

    .spin-result{
      border-radius:18px;
      padding:16px;
      background: rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      color:#dfe6ff;
      line-height:1.7;
    }

    .spin-side{
      display:grid;
      gap:16px;
    }

    .spin-info{
      border-radius:24px;
      padding:20px;
      background: rgba(17,24,45,.92);
      border:1px solid rgba(255,255,255,.08);
      box-shadow: var(--shadow);
    }

    .spin-metrics{
      display:grid;
      gap:12px;
      margin-top:12px;
    }

    .spin-metric{
      border-radius:16px;
      padding:14px 16px;
      background: rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
    }

    .spin-metric strong{font-size:16px}

    /* menu */
    .menu-list{
      grid-template-columns:repeat(2,minmax(0,1fr));
    }

    .menu-item{
      border-radius:22px;
      padding:18px;
      background:
        linear-gradient(160deg, rgba(255,255,255,.04), rgba(255,255,255,.02)),
        rgba(24,37,68,.88);
      border:1px solid rgba(255,255,255,.08);
      box-shadow: var(--shadow);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      cursor:pointer;
      transition:.2s ease;
    }

    .menu-item:hover{transform:translateY(-2px)}
    .menu-item-left{
      display:flex;
      align-items:center;
      gap:14px;
    }

    .menu-icon{
      width:48px;height:48px;border-radius:16px;
      display:grid;place-items:center;
      background: rgba(255,255,255,.08);
      color:#fff;
      font-size:18px;
      flex-shrink:0;
    }

    .menu-item h4{
      margin:0 0 4px;
      font-size:16px;
      font-weight:800;
    }

    .menu-item p{
      margin:0;
      color:var(--muted);
      font-size:13px;
    }

    .menu-page{
      display:none;
      border-radius:24px;
      padding:20px;
      background: rgba(17,24,45,.92);
      border:1px solid rgba(255,255,255,.08);
      box-shadow: var(--shadow);
      animation: fadeIn .22s ease;
    }
    .menu-page.active{display:block}

    .menu-page-head{
      display:flex;
      align-items:center;
      gap:12px;
      margin-bottom:18px;
    }

    .back-btn{
      width:44px;height:44px;border-radius:14px;
      border:none;
      background: rgba(255,255,255,.06);
      color:#fff;
      border:1px solid rgba(255,255,255,.08);
      cursor:pointer;
    }

    .page-title{
      margin:0;
      font-size:20px;
      font-weight:800;
    }

    .detail-grid{
      display:grid;
      gap:14px;
    }

    .detail-card{
      border-radius:18px;
      padding:16px;
      background: rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
    }

    .detail-card h4{
      margin:0 0 12px;
      font-size:15px;
      font-weight:800;
    }

    .detail-card p{
      margin:0;
      color:var(--muted);
      line-height:1.7;
      font-size:14px;
    }

    .profile-list{
      display:grid;
      gap:10px;
      margin-bottom:14px;
    }

    .profile-row{
      display:flex;
      justify-content:space-between;
      gap:14px;
      padding:12px 14px;
      border-radius:14px;
      background: rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      font-size:14px;
    }

    .profile-row span:first-child{color:var(--muted)}

    .referral-box{
      display:grid;
      gap:14px;
    }

    .ref-link-wrap{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .ref-link-wrap .form-control{
      flex:1;
      min-width: 240px;
    }

    .terms-box{
      border-radius:18px;
      padding:16px;
      background: rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      color:#dfe6ff;
      line-height:1.8;
      max-height: 70vh;
      overflow:auto;
      white-space:pre-line;
    }

    .tx-table-wrap{
      overflow:auto;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.08);
      background: rgba(255,255,255,.03);
    }

    table{
      width:100%;
      border-collapse:collapse;
      min-width:760px;
    }

    th,td{
      padding:14px 16px;
      text-align:left;
      border-bottom:1px solid rgba(255,255,255,.06);
      font-size:14px;
    }

    th{
      color:#dfe6ff;
      background: rgba(255,255,255,.04);
      font-size:13px;
      letter-spacing:.3px;
      white-space:nowrap;
    }

    td{
      color:var(--muted);
      vertical-align:top;
    }

    .logout-wrap{
      margin-top:18px;
      display:flex;
      justify-content:flex-end;
    }

    /* bottom nav */
    .bottom-nav{
      position:fixed;
      left:0;right:0;bottom:0;
      z-index:50;
      padding:14px 16px calc(14px + env(safe-area-inset-bottom));
      background:
        linear-gradient(180deg, rgba(11,16,32,.05), rgba(11,16,32,.88) 25%),
        rgba(11,16,32,.95);
      backdrop-filter: blur(16px);
      border-top:1px solid rgba(255,255,255,.08);
    }

    .bottom-nav-inner{
      max-width:1180px;
      margin:0 auto;
      display:grid;
      grid-template-columns:repeat(5,1fr);
      gap:10px;
    }

    .nav-btn{
      border:none;
      background: transparent;
      color:#97a3c5;
      border-radius:18px;
      padding:10px 8px;
      display:grid;
      justify-items:center;
      gap:8px;
      cursor:pointer;
      transition:.2s ease;
      font-size:12px;
      font-weight:700;
    }

    .nav-btn i{
      width:42px;height:42px;border-radius:14px;
      display:grid;place-items:center;
      background: rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.06);
      font-size:18px;
      transition:.2s ease;
    }

    .nav-btn.active{
      color:#fff;
    }

    .nav-btn.active i{
      background: linear-gradient(135deg, rgba(79,140,255,.3), rgba(124,92,255,.26));
      border-color: rgba(79,140,255,.28);
      box-shadow: 0 14px 28px rgba(79,140,255,.18);
    }

    .empty-state{
      border-radius:20px;
      padding:22px;
      text-align:center;
      background: rgba(255,255,255,.04);
      border:1px dashed rgba(255,255,255,.12);
      color:var(--muted);
      line-height:1.7;
    }

    .muted{
      color:var(--muted);
      font-size:13px;
    }

    .inline-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .small-btn{
      padding:11px 14px;
      border-radius:14px;
      font-size:13px;
      font-weight:800;
    }

    .hidden{display:none !important}

    @media (max-width: 980px){
      .stats-grid{grid-template-columns:1fr}
      .section-grid{grid-template-columns:1fr}
      .spin-wrap{grid-template-columns:1fr}
      .menu-list{grid-template-columns:1fr}
      .card-grid-2{grid-template-columns:1fr}
      .top-banner{
        flex-direction:column;
        align-items:flex-start;
      }
    }

    @media (max-width: 640px){
      .app-shell{padding:16px 14px 110px}
      .auth-card{padding:26px 18px}
      .brand-title{font-size:18px}
      .brand-sub{font-size:12px}
      .top-banner{padding:16px}
      .panel{padding:16px}
      .task-card{min-height:auto}
      .wheel-circle{width:240px;height:240px}
      .bottom-nav-inner{gap:6px}
      .nav-btn i{width:38px;height:38px}
      .city-metrics{grid-template-columns:1fr}
      .ref-link-wrap{flex-direction:column}
      .phone-chip{width:100%;justify-content:center}
    }
  </style>
</head>
<body>

<% const loggedIn = !!user; %>

<% if (!loggedIn) { %>
  <!-- ================= LOGIN / AUTH PAGE ================= -->
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-header">
        <div class="auth-logo"><i class="fa-solid fa-chart-line"></i></div>
        <h1 class="auth-title">BITREX-722</h1>
        <p class="auth-sub">Secure access to your investment dashboard, tasks, cities, withdrawals and rewards.</p>
      </div>

      <% if (message || error) { %>
        <div class="alert-stack">
          <% if (message) { %>
            <div class="alert alert-success">
              <i class="fa-solid fa-circle-check"></i>
              <div><%= message %></div>
            </div>
          <% } %>
          <% if (error) { %>
            <div class="alert alert-error">
              <i class="fa-solid fa-triangle-exclamation"></i>
              <div><%= error %></div>
            </div>
          <% } %>
        </div>
      <% } %>

      <div class="auth-tabs">
        <button class="auth-tab-btn <%= authMode === 'login' ? 'active' : '' %>" type="button" data-auth-tab="login">Login</button>
        <button class="auth-tab-btn <%= authMode === 'signup' ? 'active' : '' %>" type="button" data-auth-tab="signup">Sign Up</button>
        <button class="auth-tab-btn <%= authMode === 'forgot' ? 'active' : '' %>" type="button" data-auth-tab="forgot">Forgot</button>
      </div>

      <!-- LOGIN -->
      <div class="auth-panel <%= authMode === 'login' ? 'active' : '' %>" id="auth-login">
        <form method="POST" action="/login">
          <div class="form-group">
            <label class="form-label">Phone Number</label>
            <input class="form-control" type="tel" name="phone" placeholder="0712345678" required />
          </div>

          <div class="form-group">
            <label class="form-label">Password</label>
            <div class="input-wrap">
              <input class="form-control password-input" type="password" name="password" placeholder="Enter your password" required />
              <button type="button" class="password-toggle"><i class="fa-regular fa-eye"></i></button>
            </div>
          </div>

          <button class="btn btn-primary" type="submit">
            <i class="fa-solid fa-right-to-bracket"></i> Login
          </button>
        </form>

        <div class="auth-actions">
          <span>Don't have account? <span class="auth-link" data-auth-tab-link="signup">Sign up</span></span>
          <span class="auth-link" data-auth-tab-link="forgot">Forgot password?</span>
        </div>
      </div>

      <!-- SIGNUP -->
      <div class="auth-panel <%= authMode === 'signup' ? 'active' : '' %>" id="auth-signup">
        <form method="POST" action="/signup">
          <div class="form-group">
            <label class="form-label">Full Name</label>
            <input class="form-control" type="text" name="name" placeholder="Enter your name" />
          </div>

          <div class="form-group">
            <label class="form-label">Phone Number</label>
            <input class="form-control" type="tel" name="phone" placeholder="0712345678" required />
          </div>

          <div class="form-group">
            <label class="form-label">Email Address</label>
            <input class="form-control" type="email" name="email" placeholder="you@example.com" required />
          </div>

          <div class="form-group">
            <label class="form-label">Password (6 - 8 characters)</label>
            <div class="input-wrap">
              <input class="form-control password-input" type="password" name="password" placeholder="Create password" minlength="6" maxlength="8" required />
              <button type="button" class="password-toggle"><i class="fa-regular fa-eye"></i></button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Referral Code (Optional)</label>
            <input class="form-control" type="text" name="referralCode" value="<%= referralFromQuery || '' %>" placeholder="Enter referral code if any" />
          </div>

          <button class="btn btn-primary" type="submit">
            <i class="fa-solid fa-user-plus"></i> Create Account
          </button>
        </form>

        <div class="auth-actions">
          <span>Already have account? <span class="auth-link" data-auth-tab-link="login">Login</span></span>
        </div>
      </div>

      <!-- FORGOT -->
      <div class="auth-panel <%= authMode === 'forgot' ? 'active' : '' %>" id="auth-forgot">
        <form method="POST" action="/forgot-password">
          <div class="form-group">
            <label class="form-label">Registered Email Address</label>
            <input class="form-control" type="email" name="email" placeholder="Enter your registered email" required />
          </div>

          <div class="form-group">
            <label class="form-label">New Password</label>
            <div class="input-wrap">
              <input class="form-control password-input" type="password" name="newPassword" minlength="6" maxlength="8" placeholder="New password" required />
              <button type="button" class="password-toggle"><i class="fa-regular fa-eye"></i></button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Confirm New Password</label>
            <div class="input-wrap">
              <input class="form-control password-input" type="password" name="confirmNewPassword" minlength="6" maxlength="8" placeholder="Confirm new password" required />
              <button type="button" class="password-toggle"><i class="fa-regular fa-eye"></i></button>
            </div>
          </div>

          <button class="btn btn-primary" type="submit">
            <i class="fa-solid fa-key"></i> Reset Password
          </button>
        </form>

        <div class="auth-actions">
          <span>Remembered password? <span class="auth-link" data-auth-tab-link="login">Login</span></span>
          <span>Need an account? <span class="auth-link" data-auth-tab-link="signup">Sign up</span></span>
        </div>
      </div>

      <div class="auth-note">
        Use your registered phone number and password to access the dashboard. Admin access only appears for approved admin phone numbers after successful login.
      </div>
    </div>
  </div>

<% } else { %>

  <!-- ================= DASHBOARD ================= -->
  <div class="app-shell">
    <div class="top-banner">
      <div class="brand-wrap">
        <div class="brand-logo"><i class="fa-solid fa-chart-line"></i></div>
        <div>
          <h1 class="brand-title">BITREX-722 Dashboard</h1>
          <p class="brand-sub">Manage your cities, tasks, deposits, withdrawals, rewards and account activity in one place.</p>
        </div>
      </div>

      <div class="phone-chip">
        <i class="fa-solid fa-phone"></i>
        <span><%= user.phone %></span>
      </div>
    </div>

    <% if (message || error) { %>
      <div class="alert-stack">
        <% if (message) { %>
          <div class="alert alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <div><%= message %></div>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-error">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div><%= error %></div>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- HOME TAB -->
    <section class="tab-view <%= activeTab === 'home' ? 'active' : '' %>" id="tab-home">
      <div class="dashboard-grid">
        <div class="stats-grid">
          <div class="stat-card balance">
            <div class="stat-top">
              <div>
                <div class="stat-label">Wallet Balance</div>
                <h2 class="stat-value">KSH <%= Number(user.balance || 0).toLocaleString() %></h2>
              </div>
              <div class="stat-icon"><i class="fa-solid fa-wallet"></i></div>
            </div>
            <div class="muted">Available balance for investments, withdrawals and rewards.</div>
          </div>

          <div class="stat-card income">
            <div class="stat-top">
              <div>
                <div class="stat-label">Today's Income</div>
                <h2 class="stat-value">KSH <%= Number(user.todayIncome || 0).toLocaleString() %></h2>
              </div>
              <div class="stat-icon"><i class="fa-solid fa-coins"></i></div>
            </div>
            <div class="muted">Income earned from today's completed tasks and rewards.</div>
          </div>

          <div class="stat-card earnings">
            <div class="stat-top">
              <div>
                <div class="stat-label">Total Earnings</div>
                <h2 class="stat-value">KSH <%= Number(user.totalEarnings || 0).toLocaleString() %></h2>
              </div>
              <div class="stat-icon"><i class="fa-solid fa-sack-dollar"></i></div>
            </div>
            <div class="muted">Total accumulated earnings across all activities on the platform.</div>
          </div>
        </div>

        <div class="section-grid">
          <div class="panel">
            <div class="panel-title">
              <div>
                <h3>Wallet Actions</h3>
                <p>Deposit to your wallet or request a withdrawal to your number.</p>
              </div>
            </div>

            <div class="card-grid-2">
              <!-- Deposit -->
              <div class="action-card">
                <div class="action-head">
                  <div class="action-icon"><i class="fa-solid fa-arrow-down"></i></div>
                  <div>
                    <h4 class="action-title">Deposit</h4>
                    <p class="action-sub">Minimum deposit is KSH 200 via M-Pesa / IntaSend.</p>
                  </div>
                </div>

                <form method="POST" action="/deposit" class="mini-inputs">
                  <input class="form-control" type="number" min="200" name="amount" placeholder="Amount (e.g 500)" required />
                  <input class="form-control" type="tel" name="phone" value="<%= user.phone %>" placeholder="Phone number" required />
                  <button class="btn btn-success" type="submit">
                    <i class="fa-solid fa-mobile-screen-button"></i> Deposit Now
                  </button>
                </form>
              </div>

              <!-- Withdrawal -->
              <div class="action-card">
                <div class="action-head">
                  <div class="action-icon"><i class="fa-solid fa-arrow-up"></i></div>
                  <div>
                    <h4 class="action-title">Withdraw</h4>
                    <p class="action-sub">Minimum withdrawal is KSH 300. Admin approval required.</p>
                  </div>
                </div>

                <form method="POST" action="/withdraw" class="mini-inputs">
                  <input class="form-control" type="number" min="300" name="amount" placeholder="Amount (e.g 1000)" required />
                  <input class="form-control" type="tel" name="phone" value="<%= user.phone %>" placeholder="Phone number" required />
                  <input class="form-control" type="password" name="withdrawalPassword" placeholder="Withdrawal password" required />
                  <button class="btn btn-warning" type="submit">
                    <i class="fa-solid fa-paper-plane"></i> Request Withdrawal
                  </button>
                </form>
              </div>
            </div>
          </div>

          <div class="panel">
            <div class="panel-title">
              <div>
                <h3>Active Investments</h3>
                <p>Your currently joined city packages and their daily limits.</p>
              </div>
            </div>

            <% if (user.activeCities && user.activeCities.length) { %>
              <div class="investments-list">
                <% user.activeCities.forEach(function(code){ 
                     const city = cityConfig[code];
                     const joinedAt = user.cityJoinDates && user.cityJoinDates[code];
                     const days = joinedAt ? Math.floor((Date.now() - new Date(joinedAt).getTime()) / (1000*60*60*24)) + 1 : 0;
                %>
                  <div class="investment-item">
                    <div class="investment-left">
                      <h4><%= city.city %> <small style="color:var(--muted);font-weight:700;">(<%= code %>)</small></h4>
                      <div class="meta-list">
                        <div>Investment: KSH <%= Number(city.amount || 0).toLocaleString() %></div>
                        <div>Tasks per day: <%= city.tasksPerDay %></div>
                        <div>Daily income: KSH <%= Number(city.dailyIncome || 0).toLocaleString() %></div>
                        <div>Days active: <%= days %> / <%= city.durationDays || 365 %></div>
                      </div>
                    </div>
                    <span class="badge active"><i class="fa-solid fa-circle-check"></i> Active</span>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="empty-state">
                You do not have any active city investments yet. Open the <strong>Cities</strong> tab and join a city package to unlock tasks and daily rewards.
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <!-- TASK TAB -->
    <section class="tab-view <%= activeTab === 'task' ? 'active' : '' %>" id="tab-task">
      <div class="panel" style="margin-bottom:18px;">
        <div class="panel-title">
          <div>
            <h3>Daily Tasks</h3>
            <p>Tap claim on any available task. A 1-minute countdown will run, then the task becomes claimed automatically and cannot be claimed again.</p>
          </div>
          <span class="badge pending">
            <i class="fa-solid fa-list-check"></i>
            <%= user.tasksCompletedToday || 0 %> / <%= taskLimitToday || 0 %> Claimed Today
          </span>
        </div>

        <% if (!user.activeCities || !user.activeCities.length) { %>
          <div class="empty-state">
            No task allowed without city investments. Join a city package first from the <strong>Cities</strong> tab.
          </div>
        <% } else if ((taskLimitToday || 0) <= 0) { %>
          <div class="empty-state">
            No available tasks right now. Your active package may have expired or the daily task limit is unavailable.
          </div>
        <% } else { %>
          <div class="task-grid">
            <% tasks.forEach(function(taskName, idx){ 
                const alreadyClaimed = (user.claimedTasksToday || []).includes(taskName);
                const limitReached = (user.tasksCompletedToday || 0) >= (taskLimitToday || 0);
            %>
              <div class="task-card" data-task-card data-task-name="<%= taskName %>" data-claimed="<%= alreadyClaimed ? 'true' : 'false' %>">
                <div class="task-top">
                  <div>
                    <h4 class="task-name"><%= taskName %></h4>
                    <p class="task-price">Task #<%= idx + 1 %></p>
                  </div>
                  <% if (alreadyClaimed) { %>
                    <span class="badge claimed"><i class="fa-solid fa-check"></i> Claimed</span>
                  <% } else { %>
                    <span class="badge pending"><i class="fa-solid fa-bolt"></i> Ready</span>
                  <% } %>
                </div>

                <div class="reward-pill">
                  <i class="fa-solid fa-gift"></i> Reward: KSH 50
                </div>

                <div class="muted">
                  Complete the 1-minute order countdown to receive your reward directly to your wallet balance.
                </div>

                <div class="task-progress">
                  <div class="countdown-box">
                    <span><i class="fa-regular fa-clock"></i> Countdown</span>
                    <strong class="countdown-text"><%= alreadyClaimed ? 'Completed' : '01:00' %></strong>
                  </div>

                  <% if (alreadyClaimed) { %>
                    <button class="btn btn-dark" type="button" disabled>
                      <i class="fa-solid fa-check"></i> Claimed
                    </button>
                  <% } else { %>
                    <button
                      class="btn btn-primary task-claim-btn"
                      type="button"
                      data-task="<%= taskName %>"
                      <%= limitReached ? 'disabled' : '' %>>
                      <i class="fa-solid fa-hand-holding-dollar"></i> Claim
                    </button>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

    <!-- CITIES TAB -->
    <section class="tab-view <%= activeTab === 'city' ? 'active' : '' %>" id="tab-city">
      <div class="panel" style="margin-bottom:18px;">
        <div class="panel-title">
          <div>
            <h3>City Packages</h3>
            <p>Join a city to unlock daily tasks and income. Sign the city contract before activating a package.</p>
          </div>
        </div>

        <div class="cities-grid">
          <% Object.keys(cityConfig).forEach(function(code){ 
               const city = cityConfig[code];
               const joined = user.activeCities && user.activeCities.includes(code);
          %>
            <div class="city-card">
              <div class="city-cover" style="background-image:url('<%= city.image %>');">
                <span class="city-chip"><%= code %></span>
              </div>

              <div class="city-body">
                <h3 class="city-title"><%= city.city %></h3>

                <div class="city-metrics">
                  <div class="city-metric">
                    <small>Investment</small>
                    <strong>KSH <%= Number(city.amount || 0).toLocaleString() %></strong>
                  </div>
                  <div class="city-metric">
                    <small>Tasks / Day</small>
                    <strong><%= city.tasksPerDay %></strong>
                  </div>
                  <div class="city-metric">
                    <small>Daily Income</small>
                    <strong>KSH <%= Number(city.dailyIncome || 0).toLocaleString() %></strong>
                  </div>
                  <div class="city-metric">
                    <small>Duration</small>
                    <strong><%= city.durationDays || 365 %> days</strong>
                  </div>
                </div>

                <% if (joined) { %>
                  <div class="badge active">
                    <i class="fa-solid fa-circle-check"></i> Already Joined
                  </div>
                <% } else { %>
                  <form class="city-form" method="POST" action="/invest/<%= code %>">
                    <input
                      class="form-control"
                      type="text"
                      name="signature"
                      placeholder="Type your full name as contract signature"
                      required
                    />
                    <button class="btn btn-primary" type="submit">
                      <i class="fa-solid fa-building"></i>
                      Join <%= city.city %>
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- SPIN TAB -->
    <section class="tab-view <%= activeTab === 'spin' ? 'active' : '' %>" id="tab-spin">
      <div class="spin-wrap">
        <div class="wheel-card">
          <div class="panel-title" style="justify-content:center;margin-bottom:18px;">
            <div>
              <h3 style="text-align:center;">Lucky Spin Wheel</h3>
              <p style="text-align:center;">Every spin wins a reward. Use your free spin first, then 2 gems per spin.</p>
            </div>
          </div>

          <div class="wheel-pointer"></div>
          <div class="wheel-circle" id="wheelCircle">
            <div class="wheel-center"><i class="fa-solid fa-star"></i></div>
          </div>

          <div class="inline-actions" style="justify-content:center;">
            <button class="btn btn-primary" id="spinWheelBtn" type="button">
              <i class="fa-solid fa-dharmachakra"></i> Spin Now
            </button>
          </div>

          <div class="spin-result" id="spinResultBox" style="margin-top:18px;">
            Tap <strong>Spin Now</strong> to win a reward. Possible rewards include Gems and cash prizes.
