        <button onclick="switchTab('spin')">🎡 Spin</button>
        <button onclick="switchTab('menu')">☰ Menu</button>
      </nav>
      <script>
        const claimedToday = new Set();
        function switchTab(id){
          document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
          document.getElementById(id).classList.add('active');
          if(id==='menu'){backToMenu();}
        }
        function togglePanel(id){
          document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
          document.getElementById(id).classList.add('active');
        }
        function openMenuPage(id){
          document.getElementById('menuListPage').style.display='none';
          document.querySelectorAll('.menu-detail').forEach(p=>p.classList.remove('active'));
          document.getElementById(id).classList.add('active');
          window.scrollTo({top:0,behavior:'smooth'});
        }
        function backToMenu(){
          document.querySelectorAll('.menu-detail').forEach(p=>p.classList.remove('active'));
          document.getElementById('menuListPage').style.display='block';
          window.scrollTo({top:0,behavior:'smooth'});
        }
        function showToast(text, type='ok'){
          const toast=document.createElement('div');
          toast.className='msg '+(type==='ok'?'ok':'err');
          toast.textContent=text;
          document.querySelector('.container').prepend(toast);
          setTimeout(()=>{toast.style.opacity='0';toast.style.transform='translateY(-6px)';},2500);
          setTimeout(()=>toast.remove(),3000);
        }
        async function startClaim(btn){
          const taskName=btn.dataset.task;
          if(claimedToday.has(taskName)) return;
          btn.disabled=true;
          let sec=59;
          btn.textContent='Wait 00:'+String(sec).padStart(2,'0');
          const timer=setInterval(()=>{sec--;btn.textContent='Wait 00:'+String(Math.max(sec,0)).padStart(2,'0');if(sec<=0){clearInterval(timer);finishClaim(btn,taskName);}},1000);
        }
        async function finishClaim(btn,taskName){
          try{
            const res=await fetch('/api/task/claim',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({taskName})});
            const data=await res.json();
            if(!data.ok){btn.disabled=false;btn.textContent='Claim';showToast(data.error||'Task failed','err');return;}
            claimedToday.add(taskName);
            btn.textContent='Claimed';
            btn.disabled=true;
            const item=document.querySelector(`[data-task-item=\"${CSS.escape(taskName)}\"]`);
            if(item){item.style.opacity='.7';}
            showToast(data.message,'ok');
            const info=document.querySelector('#task .small:last-child');
            if(info){info.textContent=`Tasks completed today: ${data.tasksCompletedToday} / ${data.taskLimitToday}`;}
          }catch(e){
            btn.disabled=false;btn.textContent='Claim';showToast('Network error while claiming task','err');
          }
        }
        function copyReferral(link){
          navigator.clipboard.writeText(link).then(()=>alert('Referral link copied'));
        }
        async function shareReferral(link){
          if (navigator.share){
            await navigator.share({title:'Join BITREX', text:'Use my referral link', url:link});
          } else {
            copyReferral(link);
          }
        }
        let currentRotation = 0;
        const prizeAngle = { '3 Gems':30, 'KSH 150':90, '1 Gem':150, '2 Gems':210, 'KSH 100':270, 'KSH 50':330 };
        async function spinWheel(){
          const btn=document.getElementById('spinBtn');
          const wheel=document.getElementById('wheel');
          if(!btn || !wheel || btn.disabled) return;
          btn.disabled=true; btn.textContent='Spinning...';
          try{
            const res=await fetch('/api/spin-roulette',{method:'POST'});
            const data=await res.json();
            if(!data.ok){showToast(data.error || 'Spin failed','err');btn.disabled=false;btn.textContent='🎡 Spin';return;}
            const target = prizeAngle[data.prize.label] ?? 30;
            currentRotation += 360*6 + (360-target);
            wheel.style.transform = `rotate(${currentRotation}deg)`;
            setTimeout(()=>{
              showToast(data.message,'ok');
              btn.disabled=false;btn.textContent='🎡 Spin';
              const gems=document.getElementById('spinGems');
              const freeSpins=document.getElementById('spinFreeSpins');
              if(gems){gems.textContent=data.gems;}
              if(freeSpins){freeSpins.textContent=data.freeSpins;}
            },5200);
          }catch(e){
            showToast('Network error while spinning','err');btn.disabled=false;btn.textContent='🎡 Spin';
          }
        }
        window.addEventListener('DOMContentLoaded',()=>{
          document.querySelectorAll('.msg').forEach((m)=>setTimeout(()=>{m.style.opacity='0';m.style.transform='translateY(-6px)';setTimeout(()=>m.remove(),450);},3000));
          if (document.getElementById('depositPanel')) {
            togglePanel('depositPanel');
          }
        });
      </script>
    <% } %>
  </div>
</body>
</html>
