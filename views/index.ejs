<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bitrex 722</title>
  <style>
    :root{
      --bg:#0b1220;
      --bg-soft:#101a2e;
      --card:#111c31;
      --card-2:#162540;
      --line:rgba(255,255,255,.08);
      --text:#f4f7fb;
      --muted:#98a7c7;
      --primary:#16a34a;
      --primary-2:#22c55e;
      --danger:#ef4444;
      --warning:#f59e0b;
      --blue:#2563eb;
      --purple:#8b5cf6;
      --gold:#facc15;
      --shadow:0 18px 40px rgba(0,0,0,.35);
      --radius:20px;
    }

    *{box-sizing:border-box}
    html,body{margin:0;padding:0;background:linear-gradient(180deg,#08101d,#0c1627 35%,#0a1323 100%);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--text)}
    a{text-decoration:none;color:inherit}
    button,input,select,textarea{font:inherit}
    img{max-width:100%;display:block}

    .container{
      width:min(1180px, 100%);
      margin:0 auto;
      padding:18px 14px 110px;
    }

    .app-shell{
      min-height:100vh;
      position:relative;
    }

    .flash{
      margin:0 0 16px;
      padding:14px 16px;
      border-radius:14px;
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      font-weight:700;
      font-size:14px;
    }
    .flash.success{
      background:rgba(34,197,94,.12);
      color:#c9ffd9;
      border-color:rgba(34,197,94,.35);
    }
    .flash.error{
      background:rgba(239,68,68,.12);
      color:#ffd3d3;
      border-color:rgba(239,68,68,.35);
    }

    /* AUTH */
    .auth-wrap{
      min-height:100vh;
      display:grid;
      place-items:center;
      padding:20px;
    }

    .auth-shell{
      width:min(1120px,100%);
      display:grid;
      grid-template-columns: 1.08fr .92fr;
      background:linear-gradient(180deg,rgba(18,29,51,.95),rgba(12,20,36,.98));
      border:1px solid var(--line);
      border-radius:30px;
      overflow:hidden;
      box-shadow:var(--shadow);
    }

    .auth-hero{
      position:relative;
      padding:38px;
      background:
        radial-gradient(circle at top right, rgba(34,197,94,.18), transparent 30%),
        radial-gradient(circle at bottom left, rgba(37,99,235,.20), transparent 28%),
        linear-gradient(180deg,#0d1830,#0a1323);
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      min-height:680px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:14px;
    }
    .brand-logo{
      width:52px;height:52px;border-radius:16px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,var(--primary),var(--blue));
      font-weight:900;font-size:20px;color:#fff;
      box-shadow:0 10px 30px rgba(22,163,74,.35);
    }
    .brand h1{
      margin:0;font-size:28px;letter-spacing:.4px;
    }
    .brand p{
      margin:4px 0 0;color:var(--muted);font-size:14px;
    }

    .hero-copy{
      margin-top:30px;
    }
    .hero-copy h2{
      margin:0 0 14px;
      font-size:44px;
      line-height:1.08;
    }
    .hero-copy p{
      margin:0;
      color:#c9d6ef;
      max-width:560px;
      line-height:1.65;
      font-size:15px;
    }

    .hero-cards{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:14px;
      margin-top:28px;
    }
    .hero-card{
      padding:18px;
      border-radius:20px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      backdrop-filter: blur(8px);
    }
    .hero-card .label{
      color:var(--muted);
      font-size:13px;
      margin-bottom:8px;
    }
    .hero-card .value{
      font-size:24px;
      font-weight:800;
    }

    .hero-footer{
      display:flex;
      gap:14px;
      flex-wrap:wrap;
      margin-top:24px;
    }
    .pill{
      padding:10px 14px;
      border-radius:999px;
      background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.08);
      color:#dbe7ff;
      font-size:13px;
      font-weight:700;
    }

    .auth-panel{
      padding:28px;
      background:linear-gradient(180deg,#111b2f,#0f182a);
      display:flex;
      flex-direction:column;
      justify-content:center;
    }

    .auth-tabs{
      display:flex;
      gap:10px;
      margin-bottom:20px;
      flex-wrap:wrap;
    }
    .auth-tab{
      padding:11px 16px;
      border-radius:999px;
      background:rgba(255,255,255,.05);
      border:1px solid var(--line);
      color:#cdd9f1;
      font-weight:700;
      cursor:pointer;
      transition:.2s ease;
    }
    .auth-tab.active{
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      color:#fff;
      border-color:transparent;
    }

    .auth-card{
      background:linear-gradient(180deg,#121f36,#101a2f);
      border:1px solid var(--line);
      border-radius:24px;
      padding:24px;
      box-shadow:var(--shadow);
    }

    .auth-card h3{
      margin:0 0 8px;
      font-size:28px;
    }
    .auth-card p{
      margin:0 0 18px;
      color:var(--muted);
      line-height:1.55;
      font-size:14px;
    }

    .form-grid{
      display:grid;
      gap:14px;
    }

    .field{
      display:grid;
      gap:8px;
    }
    .field label{
      font-size:13px;
      color:#cdd9f1;
      font-weight:700;
    }
    .field input,
    .field textarea{
      width:100%;
      background:#0d1526;
      border:1px solid rgba(255,255,255,.08);
      color:#fff;
      border-radius:14px;
      padding:14px 15px;
      outline:none;
    }
    .field input::placeholder,
    .field textarea::placeholder{
      color:#7f92b8;
    }
    .field textarea{
      min-height:110px;
      resize:vertical;
    }

    .btn{
      border:none;
      cursor:pointer;
      padding:14px 16px;
      border-radius:14px;
      font-weight:800;
      transition:.2s ease;
    }
    .btn:hover{transform:translateY(-1px)}
    .btn-primary{
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      color:#fff;
      box-shadow:0 14px 30px rgba(34,197,94,.24);
    }
    .btn-blue{
      background:linear-gradient(135deg,#2563eb,#3b82f6);
      color:#fff;
      box-shadow:0 14px 30px rgba(37,99,235,.22);
    }
    .btn-danger{
      background:linear-gradient(135deg,#ef4444,#f87171);
      color:#fff;
    }
    .btn-gold{
      background:linear-gradient(135deg,#f59e0b,#facc15);
      color:#1a1302;
      font-weight:900;
    }
    .btn-soft{
      background:rgba(255,255,255,.06);
      color:#fff;
      border:1px solid var(--line);
    }
    .btn-block{width:100%}

    .small-note{
      margin-top:14px;
      color:var(--muted);
      font-size:13px;
      line-height:1.5;
    }

    .auth-section{display:none}
    .auth-section.active{display:block}

    /* DASHBOARD */
    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      margin-bottom:16px;
      position:sticky;
      top:0;
      z-index:10;
      padding:10px 0;
      backdrop-filter: blur(8px);
      background:linear-gradient(180deg,rgba(10,18,33,.94),rgba(10,18,33,.70));
    }

    .topbar-left{
      display:flex;
      align-items:center;
      gap:14px;
      min-width:0;
    }

    .avatar{
      width:52px;height:52px;border-radius:18px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,#1d4ed8,#22c55e);
      font-size:18px;
      font-weight:900;
      color:#fff;
      box-shadow:0 12px 24px rgba(34,197,94,.2);
      flex-shrink:0;
    }

    .topbar h2{
      margin:0;
      font-size:22px;
    }
    .topbar p{
      margin:4px 0 0;
      color:var(--muted);
      font-size:13px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      max-width:260px;
    }

    .topbar-actions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .hero-balance{
      background:
        radial-gradient(circle at top right, rgba(250,204,21,.16), transparent 26%),
        radial-gradient(circle at bottom left, rgba(34,197,94,.18), transparent 26%),
        linear-gradient(135deg,#111f37,#0d1627 70%);
      border:1px solid var(--line);
      border-radius:28px;
      padding:22px;
      box-shadow:var(--shadow);
      margin-bottom:16px;
    }

    .hero-balance-top{
      display:flex;
      justify-content:space-between;
      gap:18px;
      align-items:flex-start;
      flex-wrap:wrap;
    }

    .hero-balance h3{
      margin:0 0 10px;
      color:#dce6fb;
      font-size:14px;
      letter-spacing:.4px;
      text-transform:uppercase;
    }

    .big-balance{
      font-size:42px;
      font-weight:900;
      line-height:1;
      margin:0;
    }

    .sub-balance{
      margin-top:10px;
      color:var(--muted);
      font-size:14px;
      display:flex;
      gap:18px;
      flex-wrap:wrap;
    }

    .hero-side{
      display:grid;
      gap:10px;
      min-width:220px;
    }
    .mini-badge{
      padding:12px 14px;
      border-radius:16px;
      background:rgba(255,255,255,.06);
      border:1px solid rgba(255,255,255,.08);
      font-size:13px;
      color:#dbe6fb;
    }
    .mini-badge strong{
      display:block;
      font-size:18px;
      color:#fff;
      margin-top:6px;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:14px;
      margin-bottom:16px;
    }

    .stat-card{
      background:linear-gradient(180deg,#111c31,#0e182b);
      border:1px solid var(--line);
      border-radius:22px;
      padding:18px;
      box-shadow:var(--shadow);
    }
    .stat-icon{
      width:42px;height:42px;border-radius:14px;
      display:grid;place-items:center;
      margin-bottom:14px;
      font-size:18px;
      background:rgba(255,255,255,.06);
      border:1px solid rgba(255,255,255,.08);
    }
    .stat-label{
      color:var(--muted);
      font-size:13px;
      margin-bottom:8px;
    }
    .stat-value{
      font-size:28px;
      font-weight:900;
      line-height:1;
      margin-bottom:6px;
    }
    .stat-note{
      color:#c7d4ef;
      font-size:12px;
    }

    .tab-page{display:none}
    .tab-page.active{display:block}

    .section{
      margin-bottom:18px;
    }
    .section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      margin-bottom:12px;
    }
    .section-head h3{
      margin:0;
      font-size:20px;
    }
    .section-head p{
      margin:4px 0 0;
      color:var(--muted);
      font-size:13px;
    }

    .grid-2{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:16px;
    }
    .grid-3{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:16px;
    }

    .panel{
      background:linear-gradient(180deg,#111c31,#0e182b);
      border:1px solid var(--line);
      border-radius:24px;
      padding:18px;
      box-shadow:var(--shadow);
    }

    .panel h4{
      margin:0 0 6px;
      font-size:18px;
    }
    .panel p{
      margin:0;
      color:var(--muted);
      font-size:13px;
      line-height:1.6;
    }

    .quick-actions{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
      margin-top:16px;
    }

    .quick-card{
      border-radius:22px;
      padding:18px;
      background:linear-gradient(180deg,#14223b,#0f182a);
      border:1px solid var(--line);
    }

    .quick-card h4{margin:0 0 6px}
    .quick-card p{margin:0 0 14px;color:var(--muted);font-size:13px}

    .city-grid,
    .task-grid,
    .menu-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:16px;
    }

    .city-card{
      overflow:hidden;
      border-radius:24px;
      background:linear-gradient(180deg,#111c31,#0e182b);
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      display:flex;
      flex-direction:column;
    }

    .city-image{
      height:170px;
      background-size:cover;
      background-position:center;
      position:relative;
    }
    .city-overlay{
      position:absolute;inset:0;
      background:linear-gradient(180deg,transparent,rgba(0,0,0,.7));
      display:flex;
      align-items:flex-end;
      padding:18px;
    }
    .city-name{
      font-size:24px;
      font-weight:900;
      margin:0;
    }
    .city-body{
      padding:18px;
      display:grid;
      gap:14px;
    }

    .city-meta{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:10px;
    }
    .meta-box{
      padding:12px;
      border-radius:16px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
    }
    .meta-box .k{
      color:var(--muted);
      font-size:12px;
      margin-bottom:6px;
    }
    .meta-box .v{
      font-size:17px;
      font-weight:800;
    }

    .badge-row{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }
    .tag{
      padding:8px 10px;
      border-radius:999px;
      background:rgba(34,197,94,.12);
      color:#b8ffd0;
      border:1px solid rgba(34,197,94,.25);
      font-size:12px;
      font-weight:700;
    }
    .tag.warn{
      background:rgba(245,158,11,.12);
      color:#ffe6b0;
      border-color:rgba(245,158,11,.25);
    }
    .tag.blue{
      background:rgba(37,99,235,.12);
      color:#cde0ff;
      border-color:rgba(37,99,235,.25);
    }

    .task-card{
      border-radius:24px;
      background:linear-gradient(180deg,#111c31,#0e182b);
      border:1px solid var(--line);
      padding:18px;
      box-shadow:var(--shadow);
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .task-top{
      display:flex;
      justify-content:space-between;
      gap:10px;
      align-items:flex-start;
    }

    .task-title{
      font-size:18px;
      font-weight:800;
      margin:0;
    }

    .task-badge{
      padding:8px 12px;
      border-radius:999px;
      background:rgba(34,197,94,.12);
      border:1px solid rgba(34,197,94,.25);
      color:#b8ffd0;
      font-size:12px;
      font-weight:800;
      white-space:nowrap;
    }

    .task-card p{
      margin:0;
      color:var(--muted);
      font-size:13px;
      line-height:1.6;
    }

    .task-actions{
      display:flex;
      flex-direction:column;
      gap:10px;
      margin-top:auto;
    }

    .countdown{
      font-size:14px;
      font-weight:800;
      color:#dbe7ff;
      min-height:20px;
    }

    .wheel-wrap{
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:16px;
    }

    .wheel-panel{
      background:
        radial-gradient(circle at top right, rgba(250,204,21,.14), transparent 26%),
        linear-gradient(180deg,#111c31,#0e182b);
      border:1px solid var(--line);
      border-radius:26px;
      padding:22px;
      box-shadow:var(--shadow);
    }

    .wheel{
      width:min(360px,100%);
      aspect-ratio:1/1;
      margin:10px auto 20px;
      border-radius:50%;
      border:12px solid rgba(255,255,255,.08);
      background:
        conic-gradient(
          #22c55e 0 60deg,
          #2563eb 60deg 120deg,
          #f59e0b 120deg 180deg,
          #8b5cf6 180deg 240deg,
          #ef4444 240deg 300deg,
          #14b8a6 300deg 360deg
        );
      position:relative;
      box-shadow:0 30px 60px rgba(0,0,0,.35);
      transition:transform 4s cubic-bezier(.12,.8,.12,1);
    }

    .wheel::before{
      content:"";
      position:absolute;
      inset:22%;
      border-radius:50%;
      background:linear-gradient(180deg,#101b31,#0b1322);
      border:10px solid rgba(255,255,255,.08);
      z-index:1;
    }

    .wheel::after{
      content:"SPIN";
      position:absolute;
      inset:39%;
      border-radius:50%;
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      display:grid;
      place-items:center;
      font-weight:900;
      letter-spacing:1px;
      z-index:2;
      box-shadow:0 10px 30px rgba(34,197,94,.28);
    }

    .wheel-pointer{
      width:0;height:0;
      border-left:16px solid transparent;
      border-right:16px solid transparent;
      border-top:28px solid #fff;
      margin:0 auto -8px;
      filter:drop-shadow(0 10px 16px rgba(0,0,0,.4));
    }

    .reward-list{
      display:grid;
      gap:12px;
      margin-top:14px;
    }
    .reward-item{
      padding:14px;
      border-radius:18px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      display:flex;
      justify-content:space-between;
      gap:10px;
      font-size:14px;
    }

    .menu-card{
      border-radius:24px;
      background:linear-gradient(180deg,#111c31,#0e182b);
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      overflow:hidden;
    }

    .menu-card-head{
      padding:18px;
      border-bottom:1px solid var(--line);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
    }

    .menu-card-body{
      padding:18px;
      display:grid;
      gap:14px;
    }

    .menu-link{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:14px 16px;
      border-radius:16px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      color:#e6efff;
      font-weight:700;
    }

    .tx-table-wrap{
      overflow:auto;
      border-radius:18px;
      border:1px solid var(--line);
    }

    table{
      width:100%;
      border-collapse:collapse;
      min-width:720px;
      background:#0e182b;
    }
    th,td{
      padding:14px 14px;
      text-align:left;
      border-bottom:1px solid rgba(255,255,255,.06);
      font-size:14px;
      vertical-align:top;
    }
    th{
      color:#b9c7e6;
      background:#101c31;
      font-size:13px;
      text-transform:uppercase;
      letter-spacing:.4px;
    }
    td{
      color:#f0f5ff;
    }

    .status{
      display:inline-flex;
      padding:7px 10px;
      border-radius:999px;
      font-size:12px;
      font-weight:800;
      border:1px solid transparent;
    }
    .status.APPROVED{
      background:rgba(34,197,94,.12);
      color:#b9ffd0;
      border-color:rgba(34,197,94,.25);
    }
    .status.PENDING{
      background:rgba(245,158,11,.12);
      color:#ffe6b0;
      border-color:rgba(245,158,11,.25);
    }
    .status.REJECTED{
      background:rgba(239,68,68,.12);
      color:#ffd0d0;
      border-color:rgba(239,68,68,.25);
    }

    .bottom-nav{
      position:fixed;
      left:50%;
      transform:translateX(-50%);
      bottom:16px;
      width:min(980px, calc(100% - 20px));
      background:rgba(12,20,36,.92);
      border:1px solid rgba(255,255,255,.08);
      box-shadow:0 20px 50px rgba(0,0,0,.45);
      border-radius:24px;
      padding:10px;
      display:grid;
      grid-template-columns:repeat(5,1fr);
      gap:8px;
      backdrop-filter: blur(12px);
      z-index:100;
    }

    .nav-btn{
      border:none;
      cursor:pointer;
      background:transparent;
      color:#9fb0d1;
      border-radius:18px;
      padding:12px 10px;
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:6px;
      transition:.2s ease;
      font-weight:800;
    }
    .nav-btn:hover{background:rgba(255,255,255,.04)}
    .nav-btn.active{
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      color:#fff;
      box-shadow:0 14px 28px rgba(34,197,94,.25);
    }
    .nav-icon{font-size:22px;line-height:1}
    .nav-label{font-size:12px}

    .muted{color:var(--muted)}
    .center{text-align:center}
    .mt-12{margin-top:12px}
    .mt-16{margin-top:16px}
    .mt-20{margin-top:20px}
    .hidden{display:none !important}

    @media (max-width: 1080px){
      .stats-grid{grid-template-columns:repeat(2,1fr)}
      .grid-2,.grid-3,.wheel-wrap{grid-template-columns:1fr}
      .city-grid,.task-grid,.menu-grid{grid-template-columns:repeat(2,1fr)}
      .auth-shell{grid-template-columns:1fr}
      .auth-hero{min-height:auto}
    }

    @media (max-width: 720px){
      .container{padding:14px 12px 110px}
      .hero-copy h2{font-size:32px}
      .hero-cards{grid-template-columns:1fr}
      .city-grid,.task-grid,.menu-grid,.stats-grid,.quick-actions{grid-template-columns:1fr}
      .hero-balance-top{flex-direction:column}
      .big-balance{font-size:34px}
      .topbar{
        align-items:flex-start;
        flex-direction:column;
      }
      .topbar-actions{
        width:100%;
        justify-content:flex-start;
      }
      .bottom-nav{
        border-radius:20px;
        padding:8px;
      }
      .nav-btn{
        padding:10px 4px;
      }
      .nav-label{
        font-size:11px;
      }
      .topbar p{max-width:100%}
    }
  </style>
</head>
<body>
  <% const hasUser = !!user; %>
  <% const userName = user ? (user.name || (user.email ? user.email.split('@')[0] : 'Investor')) : 'Investor'; %>
  <% const firstLetter = userName ? userName.charAt(0).toUpperCase() : 'B'; %>
  <% const totalTasks = hasUser ? taskLimitToday : 0; %>
  <% const completedTasks = hasUser ? Number(user.tasksCompletedToday || 0) : 0; %>
  <% const taskProgress = totalTasks > 0 ? Math.min(100, Math.round((completedTasks / totalTasks) * 100)) : 0; %>
  <% const todayTasksClaimed = hasUser && Array.isArray(user.claimedTasksToday) ? user.claimedTasksToday : []; %>

  <% function formatMoney(amount){ return `KSH ${Number(amount || 0).toLocaleString()}`; } %>

  <% if (!hasUser) { %>
    <div class="auth-wrap">
      <div class="auth-shell">
        <div class="auth-hero">
          <div>
            <div class="brand">
              <div class="brand-logo">B7</div>
              <div>
                <h1>Bitrex 722</h1>
                <p>Investment • Tasks • Rewards • Withdrawals</p>
              </div>
            </div>

            <div class="hero-copy">
              <h2>Grow daily income with tasks, cities and rewards.</h2>
              <p>
                Welcome to Bitrex 722. Join investment cities, complete daily tasks, deposit and withdraw,
                spin for extra rewards, and manage your referrals from one dashboard.
              </p>

              <div class="hero-cards">
                <div class="hero-card">
                  <div class="label">Daily task rewards</div>
                  <div class="value">KSH 50</div>
                </div>
                <div class="hero-card">
                  <div class="label">Minimum deposit</div>
                  <div class="value">KSH 200</div>
                </div>
                <div class="hero-card">
                  <div class="label">Minimum withdrawal</div>
                  <div class="value">KSH 300</div>
                </div>
              </div>
            </div>
          </div>

          <div>
            <div class="hero-footer">
              <div class="pill">City investments</div>
              <div class="pill">M-Pesa deposits</div>
              <div class="pill">Referral rewards</div>
              <div class="pill">Roulette spin</div>
            </div>
          </div>
        </div>

        <div class="auth-panel">
          <% if (message) { %>
            <div class="flash success"><%= message %></div>
          <% } %>
          <% if (error) { %>
            <div class="flash error"><%= error %></div>
          <% } %>

          <div class="auth-tabs">
            <button class="auth-tab <%= authMode === 'login' ? 'active' : '' %>" type="button" data-auth-target="login">Login</button>
            <button class="auth-tab <%= authMode === 'signup' ? 'active' : '' %>" type="button" data-auth-target="signup">Sign up</button>
            <button class="auth-tab <%= authMode === 'forgot' ? 'active' : '' %>" type="button" data-auth-target="forgot">Forgot</button>
            <button class="auth-tab <%= authMode === 'verify' ? 'active' : '' %>" type="button" data-auth-target="verify">Verify</button>
          </div>

          <!-- LOGIN -->
          <section class="auth-section <%= authMode === 'login' ? 'active' : '' %>" id="auth-login">
            <div class="auth-card">
              <h3>Welcome back</h3>
              <p>Log in to access your dashboard, tasks, investments, and wallet.</p>

              <form action="/login" method="POST" class="form-grid">
                <div class="field">
                  <label>Phone number</label>
                  <input type="text" name="phone" placeholder="e.g. 0727814209" required />
                </div>

                <div class="field">
                  <label>Password</label>
                  <input type="password" name="password" placeholder="Enter your password" required />
                </div>

                <button class="btn btn-primary btn-block" type="submit">Log In</button>
              </form>

              <div class="small-note">
                Don’t have an account? Use the <strong>Sign up</strong> tab above.
              </div>
            </div>
          </section>

          <!-- SIGNUP -->
          <section class="auth-section <%= authMode === 'signup' ? 'active' : '' %>" id="auth-signup">
            <div class="auth-card">
              <h3>Create account</h3>
              <p>Register with your phone number, email, password and optional referral code.</p>

              <form action="/signup" method="POST" class="form-grid">
                <div class="field">
                  <label>Full name</label>
                  <input type="text" name="name" placeholder="Enter your full name" />
                </div>

                <div class="field">
                  <label>Phone number</label>
                  <input type="text" name="phone" placeholder="e.g. 0727814209" required />
                </div>

                <div class="field">
                  <label>Email address</label>
                  <input type="email" name="email" placeholder="Enter your email" required />
                </div>

                <div class="field">
                  <label>Password (6 - 8 characters)</label>
                  <input type="password" name="password" minlength="6" maxlength="8" placeholder="Create password" required />
                </div>

                <div class="field">
                  <label>Referral code (optional)</label>
                  <input
                    type="text"
                    name="referralCode"
                    placeholder="Enter referral code"
                    value="<%= referralFromQuery || '' %>"
                  />
                </div>

                <button class="btn btn-primary btn-block" type="submit">Create Account</button>
              </form>
            </div>
          </section>

          <!-- FORGOT -->
          <section class="auth-section <%= authMode === 'forgot' ? 'active' : '' %>" id="auth-forgot">
            <div class="auth-card">
              <h3>Reset password</h3>
              <p>Use your registered email address to reset your password.</p>

              <form action="/forgot-password" method="POST" class="form-grid">
                <div class="field">
                  <label>Registered email</label>
                  <input type="email" name="email" placeholder="Enter your registered email" required />
                </div>

                <div class="field">
                  <label>New password</label>
                  <input type="password" name="newPassword" minlength="6" maxlength="8" placeholder="New password" required />
                </div>

                <div class="field">
                  <label>Confirm new password</label>
                  <input type="password" name="confirmNewPassword" minlength="6" maxlength="8" placeholder="Confirm password" required />
                </div>

                <button class="btn btn-blue btn-block" type="submit">Reset Password</button>
              </form>
            </div>
          </section>

          <!-- VERIFY -->
          <section class="auth-section <%= authMode === 'verify' ? 'active' : '' %>" id="auth-verify">
            <div class="auth-card">
              <h3>Verify email</h3>
              <p>Complete account setup by confirming your email verification.</p>

              <form action="/verify-email" method="POST" class="form-grid">
                <button class="btn btn-primary btn-block" type="submit">Verify My Email</button>
              </form>

              <div class="small-note">
                If you already verified, you can go back to the <strong>Login</strong> tab and sign in.
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

  <% } else { %>
    <div class="app-shell">
      <div class="container">
        <% if (message) { %>
          <div class="flash success"><%= message %></div>
        <% } %>
        <% if (error) { %>
          <div class="flash error"><%= error %></div>
        <% } %>

        <header class="topbar">
          <div class="topbar-left">
            <div class="avatar"><%= firstLetter %></div>
            <div>
              <h2>Hello, <%= userName %></h2>
              <p><%= user.phone %> • <%= user.email || 'No email' %></p>
            </div>
          </div>

          <div class="topbar-actions">
            <% if (isAdminPhone) { %>
              <a href="/admin/dashboard" class="btn btn-blue">Admin Dashboard</a>
            <% } %>
            <form action="/logout" method="POST">
              <button type="submit" class="btn btn-soft">Logout</button>
            </form>
          </div>
        </header>

        <!-- HOME TAB -->
        <section class="tab-page active" id="tab-home">
          <div class="hero-balance">
            <div class="hero-balance-top">
              <div>
                <h3>Total wallet balance</h3>
                <p class="big-balance"><%= formatMoney(user.balance) %></p>
                <div class="sub-balance">
                  <span>Referral code: <strong><%= user.referralCode %></strong></span>
                  <span>Joined cities: <strong><%= (user.activeCities || []).length %></strong></span>
                  <span>Tasks done today: <strong><%= completedTasks %>/<%= totalTasks %></strong></span>
                </div>
              </div>

              <div class="hero-side">
                <div class="mini-badge">
                  Today income
                  <strong><%= formatMoney(user.todayIncome) %></strong>
                </div>
                <div class="mini-badge">
                  Total earnings
                  <strong><%= formatMoney(user.totalEarnings) %></strong>
                </div>
              </div>
            </div>
          </div>

          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-icon">💰</div>
              <div class="stat-label">Wallet balance</div>
              <div class="stat-value"><%= formatMoney(user.balance) %></div>
              <div class="stat-note">Available for investing and withdrawals</div>
            </div>

            <div class="stat-card">
              <div class="stat-icon">📈</div>
              <div class="stat-label">Today income</div>
              <div class="stat-value"><%= formatMoney(user.todayIncome) %></div>
              <div class="stat-note">Task income earned today</div>
            </div>

            <div class="stat-card">
              <div class="stat-icon">📱</div>
              <div class="stat-label">User number</div>
              <div class="stat-value" style="font-size:20px"><%= user.phone %></div>
              <div class="stat-note">Registered phone number</div>
            </div>

            <div class="stat-card">
              <div class="stat-icon">📋</div>
              <div class="stat-label">Task progress</div>
              <div class="stat-value"><%= completedTasks %>/<%= totalTasks %></div>
              <div class="stat-note"><%= taskProgress %>% of today’s tasks completed</div>
            </div>
          </div>

          <div class="section">
            <div class="section-head">
              <div>
                <h3>Wallet actions</h3>
                <p>Deposit funds via M-Pesa or request a withdrawal.</p>
              </div>
            </div>

            <div class="grid-2">
              <div class="panel">
                <h4>Deposit funds</h4>
                <p>Minimum deposit is KSH 200. Enter the M-Pesa number to receive STK Push.</p>

                <form action="/deposit" method="POST" class="form-grid mt-16">
                  <div class="field">
                    <label>Amount</label>
                    <input type="number" name="amount" min="200" placeholder="Enter amount" required />
                  </div>
                  <div class="field">
                    <label>M-Pesa phone number</label>
                    <input type="text" name="phone" placeholder="e.g. 0727814209" required />
                  </div>
                  <button class="btn btn-primary btn-block" type="submit">Deposit now</button>
                </form>
              </div>

              <div class="panel">
                <h4>Withdraw funds</h4>
                <p>Minimum withdrawal is KSH 300. Enter your withdrawal password to submit request.</p>

                <form action="/withdraw" method="POST" class="form-grid mt-16">
                  <div class="field">
                    <label>Amount</label>
                    <input type="number" name="amount" min="300" placeholder="Enter amount" required />
                  </div>
                  <div class="field">
                    <label>M-Pesa phone number</label>
                    <input type="text" name="phone" placeholder="e.g. 0727814209" required />
                  </div>
                  <div class="field">
                    <label>Withdrawal password</label>
                    <input type="password" name="withdrawalPassword" placeholder="Enter withdrawal password" required />
                  </div>
                  <button class="btn btn-blue btn-block" type="submit">Request withdrawal</button>
                </form>
              </div>
            </div>
          </div>

          <div class="section">
            <div class="section-head">
              <div>
                <h3>Quick overview</h3>
                <p>Your account performance and rewards summary.</p>
              </div>
            </div>

            <div class="quick-actions">
              <div class="quick-card">
                <h4>Referral performance</h4>
                <p>Invite new users using your code and earn rewards when they join cities.</p>
                <div class="badge-row mt-16">
                  <span class="tag">Referred: <%= user.referredCount || 0 %></span>
                  <span class="tag blue">Gems: <%= user.gems || 0 %></span>
                  <span class="tag warn"><%= user.referralBonusEarned ? 'Bonus earned' : 'Bonus pending' %></span>
                </div>
              </div>

              <div class="quick-card">
                <h4>Account status</h4>
                <p>Monitor your email verification and active city packages.</p>
                <div class="badge-row mt-16">
                  <span class="tag"><%= user.emailVerified ? 'Email verified' : 'Email not verified' %></span>
                  <span class="tag blue">Cities: <%= (user.activeCities || []).length %></span>
                  <span class="tag warn">Free spins: <%= user.freeSpins || 0 %></span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- TASK TAB -->
        <section class="tab-page" id="tab-task">
          <div class="section">
            <div class="section-head">
              <div>
                <h3>Daily tasks</h3>
                <p>Tap a task, wait 1 minute countdown, then claim KSH 50 reward.</p>
              </div>
              <div class="tag blue">Completed <%= completedTasks %>/<%= totalTasks %></div>
            </div>

            <% if (!user.activeCities || !user.activeCities.length) { %>
              <div class="panel">
                <h4>No city investment yet</h4>
                <p>You need at least one active city investment before you can claim tasks.</p>
              </div>
            <% } else { %>
              <div class="task-grid">
                <% tasks.forEach((taskName, index) => { 
                  const claimed = todayTasksClaimed.includes(taskName);
                %>
                  <div class="task-card" data-task-card data-task-name="<%= taskName %>" data-claimed="<%= claimed ? 'true' : 'false' %>">
                    <div class="task-top">
                      <div>
                        <h4 class="task-title"><%= taskName %></h4>
                        <p>Task reward is fixed at KSH 50 after countdown completion.</p>
                      </div>
                      <span class="task-badge"><%= claimed ? 'Claimed' : 'Reward KSH 50' %></span>
                    </div>

                    <div class="badge-row">
                      <span class="tag">Task #<%= index + 1 %></span>
                      <span class="tag blue">1 minute timer</span>
                      <span class="tag warn">Daily claim</span>
                    </div>

                    <div class="task-actions">
                      <div class="countdown" data-countdown>
                        <%= claimed ? 'Already claimed today' : 'Ready to start countdown' %>
                      </div>

                      <button
                        class="btn <%= claimed ? 'btn-soft' : 'btn-primary' %> btn-block"
                        type="button"
                        data-start-task
                        <%= claimed ? 'disabled' : '' %>
                      >
                        <%= claimed ? 'Claimed' : 'Start task countdown' %>
                      </button>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </section>

        <!-- CITIES TAB -->
        <section class="tab-page" id="tab-cities">
          <div class="section">
            <div class="section-head">
              <div>
                <h3>City investments</h3>
                <p>Join a city package to unlock tasks and daily earning opportunities.</p>
              </div>
            </div>

            <div class="city-grid">
              <% Object.entries(cityConfig).forEach(([code, city]) => { 
                const joined = user.activeCities && user.activeCities.includes(code);
              %>
                <div class="city-card">
                  <div class="city-image" style="background-image:url('<%= city.image %>')">
                    <div class="city-overlay">
                      <div>
                        <p class="city-name"><%= city.city %></p>
                        <div class="badge-row mt-12">
                          <span class="tag"><%= code %></span>
                          <% if (city.free) { %>
                            <span class="tag blue">Free package</span>
                          <% } else { %>
                            <span class="tag warn">Investment package</span>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="city-body">
                    <div class="city-meta">
                      <div class="meta-box">
                        <div class="k">Amount</div>
                        <div class="v"><%= formatMoney(city.amount) %></div>
                      </div>
                      <div class="meta-box">
                        <div class="k">Daily income</div>
                        <div class="v"><%= formatMoney(city.dailyIncome) %></div>
                      </div>
                      <div class="meta-box">
                        <div class="k">Tasks / day</div>
                        <div class="v"><%= city.tasksPerDay %></div>
                      </div>
                      <div class="meta-box">
                        <div class="k">Duration</div>
                        <div class="v"><%= city.durationDays %> days</div>
                      </div>
                    </div>

                    <div class="badge-row">
                      <span class="tag">Unlocks task capacity</span>
                      <span class="tag blue">Daily reward flow</span>
                    </div>

                    <% if (joined) { %>
                      <div class="panel" style="padding:14px">
                        <h4 style="margin-bottom:8px">Already joined</h4>
                        <p>This city package is already active on your account.</p>
                      </div>
                    <% } else { %>
                      <form action="/invest/<%= code %>" method="POST" class="form-grid">
                        <div class="field">
                          <label>Contract signature</label>
                          <input
                            type="text"
                            name="signature"
                            placeholder="Type your full name as signature"
                            required
                          />
                        </div>
                        <button class="btn btn-primary btn-block" type="submit">
                          Join <%= city.city %>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </section>

        <!-- SPIN TAB -->
        <section class="tab-page" id="tab-spin">
          <div class="wheel-wrap">
            <div class="wheel-panel">
              <div class="section-head" style="margin-bottom:8px">
                <div>
                  <h3>Spin & win</h3>
                  <p>Use your free spin first, then 2 gems per spin afterwards.</p>
                </div>
              </div>

              <div class="wheel-pointer"></div>
              <div class="wheel" id="wheel"></div>

              <div class="grid-2">
                <div class="panel" style="padding:14px">
                  <h4>Your gems</h4>
                  <p id="gemsValue"><%= user.gems || 0 %></p>
                </div>
                <div class="panel" style="padding:14px">
                  <h4>Free spins</h4>
                  <p id="freeSpinsValue"><%= user.freeSpins || 0 %></p>
                </div>
              </div>

              <div class="mt-16">
                <button class="btn btn-gold btn-block" type="button" id="spinBtn">Spin now</button>
              </div>

              <div class="panel mt-16" style="padding:14px">
                <h4>Spin result</h4>
                <p id="spinResultText">Press spin to try your luck.</p>
              </div>
            </div>

            <div class="wheel-panel">
              <h3 style="margin-top:0">Reward board</h3>
              <p class="muted">Possible rewards from the roulette system.</p>

              <div class="reward-list">
                <div class="reward-item"><span>3 Gems</span><strong>Most common</strong></div>
                <div class="reward-item"><span>1 Gem</span><strong>Reward</strong></div>
                <div class="reward-item"><span>2 Gems</span><strong>Reward</strong></div>
                <div class="reward-item"><span>KSH 50</span><strong>Cash</strong></div>
                <div class="reward-item"><span>KSH 100</span><strong>Cash</strong></div>
                <div class="reward-item"><span>KSH 150</span><strong>Cash</strong></div>
              </div>

              <div class="panel mt-20">
                <h4>Spin rules</h4>
                <p>
                  First spin may be free if available. After that, each spin consumes 2 gems.
                  Cash prizes are added directly to your wallet balance.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- MENU TAB -->
        <section class="tab-page" id="tab-menu">
          <div class="menu-grid">
            <div class="menu-card">
              <div class="menu-card-head">
                <div>
                  <h4 style="margin:0">Profile details</h4>
                  <p class="muted" style="margin:4px 0 0">Your account information</p>
                </div>
              </div>
              <div class="menu-card-body">
                <div class="menu-link">
                  <span>Name</span>
                  <strong><%= userName %></strong>
                </div>
                <div class="menu-link">
                  <span>Phone</span>
                  <strong><%= user.phone %></strong>
                </div>
                <div class="menu-link">
                  <span>Email</span>
                  <strong><%= user.email || 'Not set' %></strong>
                </div>
                <div class="menu-link">
                  <span>Email verification</span>
                  <strong><%= user.emailVerified ? 'Verified' : 'Not verified' %></strong>
                </div>
              </div>
            </div>

            <div class="menu-card">
              <div class="menu-card-head">
                <div>
                  <h4 style="margin:0">Referral section</h4>
                  <p class="muted" style="margin:4px 0 0">Share and earn referral rewards</p>
                </div>
              </div>
              <div class="menu-card-body">
                <div class="field">
                  <label>Your referral code</label>
                  <input type="text" readonly value="<%= user.referralCode %>" />
                </div>

                <div class="field">
                  <label>Your referral link</label>
                  <input type="text" readonly value="<%= referralLink %>" id="referralLinkInput" />
                </div>

                <button class="btn btn-primary btn-block" type="button" id="copyReferralBtn">Copy referral link</button>

                <div class="badge-row">
                  <span class="tag">Referred users: <%= user.referredCount || 0 %></span>
                  <span class="tag blue">Gems: <%= user.gems || 0 %></span>
                  <span class="tag warn"><%= user.referralBonusEarned ? 'KSH 300 bonus earned' : '5 referrals unlock KSH 300 bonus' %></span>
                </div>
              </div>
            </div>

            <div class="menu-card">
              <div class="menu-card-head">
                <div>
                  <h4 style="margin:0">WhatsApp & support</h4>
                  <p class="muted" style="margin:4px 0 0">Manager contact and group access</p>
                </div>
              </div>
              <div class="menu-card-body">
                <a class="menu-link" href="https://wa.me/254727814209" target="_blank" rel="noopener">
                  <span>WhatsApp manager</span>
                  <strong>Open</strong>
                </a>
                <a class="menu-link" href="https://chat.whatsapp.com/" target="_blank" rel="noopener">
                  <span>Group WhatsApp</span>
                  <strong>Join</strong>
                </a>
                <div class="menu-link">
                  <span>Support note</span>
                  <strong>Use manager for payment issues</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="grid-2 mt-20">
            <div class="menu-card">
              <div class="menu-card-head">
                <div>
                  <h4 style="margin:0">Change password</h4>
                  <p class="muted" style="margin:4px 0 0">Update your login and withdrawal password</p>
                </div>
              </div>
              <div class="menu-card-body">
                <form action="/profile/password" method="POST" class="form-grid">
                  <div class="field">
                    <label>Current password</label>
                    <input type="password" name="currentPassword" placeholder="Current password" required />
                  </div>
                  <div class="field">
                    <label>New password (6 - 8 chars)</label>
                    <input type="password" name="newPassword" minlength="6" maxlength="8" placeholder="New password" required />
                  </div>
                  <button class="btn btn-blue btn-block" type="submit">Update password</button>
                </form>
              </div>
            </div>

            <div class="menu-card">
              <div class="menu-card-head">
                <div>
                  <h4 style="margin:0">Terms & conditions</h4>
                  <p class="muted" style="margin:4px 0 0">Platform usage rules</p>
                </div>
              </div>
              <div class="menu-card-body">
                <div class="panel" style="padding:14px">
                  <p>
                    1. Deposits and withdrawals are subject to platform approval rules.<br><br>
                    2. Task rewards depend on active city investments and daily limits.<br><br>
                    3. City packages cannot be duplicated while already active.<br><br>
                    4. Referral rewards are issued according to the configured system in your account.<br><br>
                    5. Misuse of payment or account details may lead to suspension.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="menu-card mt-20">
            <div class="menu-card-head">
              <div>
                <h4 style="margin:0">Transaction history</h4>
                <p class="muted" style="margin:4px 0 0">Deposits, withdrawals, tasks, referrals and rewards</p>
              </div>
            </div>
            <div class="menu-card-body">
              <div class="tx-table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Type</th>
                      <th>Amount</th>
                      <th>Detail</th>
                      <th>Date</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (user.transactions && user.transactions.length) { %>
                      <% user.transactions.forEach((tx) => { %>
                        <tr>
                          <td><strong><%= tx.type %></strong></td>
                          <td><%= formatMoney(tx.amount || 0) %></td>
                          <td><%= tx.detail || '-' %></td>
                          <td><%= new Date(tx.date).toLocaleString() %></td>
                          <td>
                            <span class="status <%= tx.status || 'APPROVED' %>">
                              <%= tx.status || 'APPROVED' %>
                            </span>
                          </td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="5" class="center muted">No transactions yet.</td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- BOTTOM NAV -->
      <nav class="bottom-nav" id="bottomNav">
        <button class="nav-btn active" type="button" data-tab="home">
          <span class="nav-icon">🏠</span>
          <span class="nav-label">Home</span>
        </button>
        <button class="nav-btn" type="button" data-tab="task">
          <span class="nav-icon">📋</span>
          <span class="nav-label">Task</span>
        </button>
        <button class="nav-btn" type="button" data-tab="cities">
          <span class="nav-icon">🏙️</span>
          <span class="nav-label">Cities</span>
        </button>
        <button class="nav-btn" type="button" data-tab="spin">
          <span class="nav-icon">🎡</span>
          <span class="nav-label">Spin</span>
        </button>
        <button class="nav-btn" type="button" data-tab="menu">
          <span class="nav-icon">☰</span>
          <span class="nav-label">Menu</span>
        </button>
      </nav>
    </div>
  <% } %>

  <script>
    // AUTH TABS
    (function(){
      const authTabs = document.querySelectorAll('[data-auth-target]');
      const authSections = document.querySelectorAll('.auth-section');
      if(authTabs.length){
        authTabs.forEach(btn=>{
          btn.addEventListener('click', ()=>{
            authTabs.forEach(b=>b.classList.remove('active'));
            btn.classList.add('active');
            const target = btn.getAttribute('data-auth-target');
            authSections.forEach(section=>{
              section.classList.toggle('active', section.id === 'auth-' + target);
            });
          });
        });
      }
    })();

    // DASHBOARD TAB NAVIGATION
    (function(){
      const navButtons = document.querySelectorAll('.nav-btn');
      const pages = {
        home: document.getElementById('tab-home'),
        task: document.getElementById('tab-task'),
        cities: document.getElementById('tab-cities'),
        spin: document.getElementById('tab-spin'),
        menu: document.getElementById('tab-menu')
      };

      if(navButtons.length){
        navButtons.forEach(btn=>{
          btn.addEventListener('click', ()=>{
            const tab = btn.dataset.tab;
            navButtons.forEach(b=>b.classList.remove('active'));
            btn.classList.add('active');

            Object.entries(pages).forEach(([key, page])=>{
              if(page) page.classList.toggle('active', key === tab);
            });

            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        });
      }
    })();

    // COPY REFERRAL LINK
    (function(){
      const copyBtn = document.getElementById('copyReferralBtn');
      const input = document.getElementById('referralLinkInput');
      if(copyBtn && input){
        copyBtn.addEventListener('click', async ()=>{
          try{
            await navigator.clipboard.writeText(input.value);
            copyBtn.textContent = 'Referral link copied';
            setTimeout(()=>copyBtn.textContent = 'Copy referral link', 1800);
          }catch(err){
            input.select();
            document.execCommand('copy');
            copyBtn.textContent = 'Referral link copied';
            setTimeout(()=>copyBtn.textContent = 'Copy referral link', 1800);
          }
        });
      }
    })();

    // TASK COUNTDOWN + CLAIM
    (function(){
      const taskCards = document.querySelectorAll('[data-task-card]');
      if(!taskCards.length) return;

      const TASK_DURATION = 60; // 1 minute
      let globalTaskLock = false;

      function setCardState(card, text, disabled, buttonText){
        const countdown = card.querySelector('[data-countdown]');
        const button = card.querySelector('[data-start-task]');
        if(countdown) countdown.textContent = text;
        if(button){
          button.disabled = !!disabled;
          button.textContent = buttonText;
          button.classList.toggle('btn-primary', !disabled || buttonText === 'Claiming...');
          button.classList.toggle('btn-soft', !!disabled && buttonText !== 'Claiming...');
        }
      }

      async function claimTask(taskName, card){
        setCardState(card, 'Submitting reward claim...', true, 'Claiming...');
        try{
          const res = await fetch('/api/task/claim', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ taskName })
          });

          const data = await res.json();
          if(!res.ok || !data.ok){
            throw new Error(data.error || 'Task claim failed');
          }

          setCardState(card, 'Reward claimed successfully', true, 'Claimed');
          const badge = card.querySelector('.task-badge');
          if(badge) badge.textContent = 'Claimed';
          alert(data.message || 'Task completed successfully.');
          window.location.reload();
        }catch(err){
          setCardState(card, err.message || 'Task claim failed', false, 'Start task countdown');
          globalTaskLock = false;
        }
      }

      taskCards.forEach(card=>{
        const claimed = card.dataset.claimed === 'true';
        const button = card.querySelector('[data-start-task]');
        const taskName = card.dataset.taskName;

        if(!button || claimed) return;

        button.addEventListener('click', ()=>{
          if(globalTaskLock){
            alert('Finish the current task countdown first.');
            return;
          }

          globalTaskLock = true;
          button.disabled = true;
          let remaining = TASK_DURATION;

          setCardState(card, `Countdown started: ${remaining}s remaining`, true, 'Counting down...');

          const interval = setInterval(()=>{
            remaining -= 1;
            if(remaining > 0){
              setCardState(card, `Countdown started: ${remaining}s remaining`, true, 'Counting down...');
            }else{
              clearInterval(interval);
              claimTask(taskName, card);
            }
          }, 1000);
        });
      });
    })();

    // SPIN WHEEL
    (function(){
      const spinBtn = document.getElementById('spinBtn');
      const wheel = document.getElementById('wheel');
      const resultText = document.getElementById('spinResultText');
      const gemsValue = document.getElementById('gemsValue');
      const freeSpinsValue = document.getElementById('freeSpinsValue');

      if(!spinBtn || !wheel) return;

      let spinning = false;
      let currentRotation = 0;

      spinBtn.addEventListener('click', async ()=>{
        if(spinning) return;
        spinning = true;
        spinBtn.disabled = true;
        resultText.textContent = 'Spinning... please wait';

        const extraRotation = 1800 + Math.floor(Math.random() * 1440);
        currentRotation += extraRotation;
        wheel.style.transform = `rotate(${currentRotation}deg)`;

        try{
          const res = await fetch('/api/spin-roulette', { method: 'POST' });
          const data = await res.json();

          setTimeout(()=>{
            if(!res.ok || !data.ok){
              resultText.textContent = data.error || 'Spin failed';
            }else{
              resultText.textContent = data.message || `You won ${data.prize?.label || 'a reward'}`;
              if(gemsValue) gemsValue.textContent = data.gems ?? gemsValue.textContent;
              if(freeSpinsValue) freeSpinsValue.textContent = data.freeSpins ?? freeSpinsValue.textContent;
            }
            spinning = false;
            spinBtn.disabled = false;
          }, 4200);
        }catch(err){
          setTimeout(()=>{
            resultText.textContent = 'Spin failed. Try again.';
            spinning = false;
            spinBtn.disabled = false;
          }, 4200);
        }
      });
    })();
  </script>
</body>
</html>
