          <div class="pill"><div class="small">💰Balance</div><div class="kpi">KSH <%= user.balance %></div></div>
          <div class="pill"><div class="small">🎫Today's Income</div><div class="kpi">KSH <%= user.todayIncome %></div></div>
          <div class="pill"><div class="small">💼Total Earnings</div><div class="kpi">KSH <%= user.totalEarnings %></div></div>
          <% if (isAdminPhone) { %><div class="pill"><div class="small">Admin</div><div class="kpi"><a href="/admin" class="badge-link">Portal</a></div></div><% } %>
        </div>

        <div class="card">
          <h3>Active Investments</h3>
          <% if (!user.activeCities.length) { %><p class="small">No city joined yet.</p><% } else { %>
          <table>
            <thead><tr><th>City</th><th>Days</th><th>Daily Income</th></tr></thead>
            <tbody>
              <% user.activeCities.forEach(code => { %>
                <tr>
                  <td><%= cityConfig[code].city %></td>
                  <td>
                    <% const daysActive = Math.floor((Date.now()-new Date(user.cityJoinDates[code]).getTime())/(1000*60*60*24))+1; const maxDays = cityConfig[code].durationDays || 365; const completed = daysActive >= maxDays; %>
                    <%= Math.min(daysActive, maxDays) %> / <%= maxDays %>
                    <% if (completed) { %><span class="status APPROVED">COMPLETED</span><% } %>
                  </td>
                  <td>KSH <%= completed ? 0 : cityConfig[code].dailyIncome %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>
        </div>

        <div class="card">
          <h3>Wallet Actions</h3>
          <div class="action-button">
            <a class="action-link" href="#" onclick="togglePanel('depositPanel');return false;">💳 Deposit</a>
          <h3>Deposit</h3>
          <div class="small">. Input the mobile number and Amount.</div>
