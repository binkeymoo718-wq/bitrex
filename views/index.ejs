    <script>
      function switchPage(pageId) {
        document.querySelectorAll('.page').forEach(el => el.classList.remove('active'));
        document.getElementById(pageId).classList.add('active');
        document.querySelectorAll('.nav-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.page === pageId);
        });
      }

      function switchPageAndCloseMenu(pageId) {
        switchPage(pageId);
        toggleMenu();
      }

      function toggleMenu() {
        document.getElementById('menu-modal').classList.toggle('hidden');
      }

      function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        input.type = input.type === 'password' ? 'text' : 'password';
      }

      function copyReferralLink() {
        const link = '<%= referralLink %>';
        navigator.clipboard.writeText(link).then(() => {
          alert('Referral link copied!');
        });
      }

      function shareReferralLink() {
        const link = '<%= referralLink %>';
        if (navigator.share) {
          navigator.share({
            title: 'Bitrex 722',
            text: 'Join me on Bitrex 722 and start earning!',
            url: link
          });
        } else {
          alert('Share feature not available on this browser');
        }
      }

      function spinWheel() {
        const wheel = document.getElementById('wheel');
        const prizeDisplay = document.getElementById('prize-display');

        if (wheel.style.transform && wheel.style.transform !== 'rotate(0deg)') {
          return;
        }

        const formData = new FormData();
        fetch('/api/spin-roulette', {
          method: 'POST',
          body: formData
        })
          .then(res => res.json())
          .then(data => {
            if (!data.ok) {
              alert(data.error);
              return;
            }

            const rotations = 3600 + Math.random() * 360;
            wheel.style.transform = `rotate(${rotations}deg)`;
            setTimeout(() => {
              prizeDisplay.innerHTML = `🎉 You Won: ${data.prize.label}`;
              setTimeout(() => {
                wheel.style.transform = 'rotate(0deg)';
                prizeDisplay.innerHTML = '';
              }, 3000);
            }, 4000);
          })
          .catch(err => alert('Error: ' + err.message));
      }
    </script>
  <% } %>
</body>
</html>
