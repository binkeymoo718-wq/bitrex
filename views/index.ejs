<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BITREX Platform</title>
  <style>
    :root{
      --bg:#0b1220;
      --bg-soft:#101a2f;
      --card:#111c34;
      --card-2:#162544;
      --text:#eef4ff;
      --muted:#9fb0d1;
      --line:rgba(255,255,255,.08);
      --primary:#4f8cff;
      --primary-2:#7b5cff;
      --success:#22c55e;
      --warning:#f59e0b;
      --danger:#ef4444;
      --cyan:#22d3ee;
      --shadow:0 20px 50px rgba(0,0,0,.28);
      --radius:20px;
    }

    *{box-sizing:border-box}
    html,body{margin:0;padding:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:
      radial-gradient(circle at top left, rgba(79,140,255,.18), transparent 24%),
      radial-gradient(circle at top right, rgba(123,92,255,.16), transparent 24%),
      linear-gradient(180deg,#08101d 0%, #0b1220 100%);
      color:var(--text);
      min-height:100%;
    }
    a{text-decoration:none;color:inherit}
    button,input,textarea,select{font:inherit}
    img{max-width:100%;display:block}

    .shell{
      max-width:1200px;
      margin:0 auto;
      padding:20px 16px 120px;
    }

    .glass{
      background:linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius:var(--radius);
    }

    .alert-stack{
      display:grid;
      gap:10px;
      margin-bottom:16px;
    }
    .alert{
      padding:14px 16px;
      border-radius:16px;
      font-size:.95rem;
      border:1px solid transparent;
    }
    .alert.success{
      background:rgba(34,197,94,.12);
      border-color:rgba(34,197,94,.3);
      color:#d9ffe7;
    }
    .alert.error{
      background:rgba(239,68,68,.12);
      border-color:rgba(239,68,68,.3);
      color:#ffe1e1;
    }

    .brand-row{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:12px;
      margin-bottom:24px;
    }
    .brand-badge{
      width:48px;height:48px;border-radius:16px;
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      display:grid;place-items:center;
      font-weight:900;font-size:1.2rem;
      box-shadow:0 14px 30px rgba(79,140,255,.35);
    }
    .brand-title{
      font-size:1.4rem;
      font-weight:800;
      letter-spacing:.4px;
    }
    .brand-sub{
      color:var(--muted);
      font-size:.92rem;
      margin-top:2px;
    }

    /* =========================
       AUTH (LOGGED OUT)
       ========================= */
    .auth-shell{
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:24px 16px;
    }
    .auth-card{
      width:100%;
      max-width:460px;
      padding:28px;
      position:relative;
      overflow:hidden;
    }
    .auth-card::before{
      content:"";
      position:absolute;
      inset:-100px auto auto -100px;
      width:220px;height:220px;border-radius:50%;
      background:radial-gradient(circle, rgba(79,140,255,.25), transparent 70%);
      pointer-events:none;
    }
    .auth-card::after{
      content:"";
      position:absolute;
      inset:auto -120px -120px auto;
      width:260px;height:260px;border-radius:50%;
      background:radial-gradient(circle, rgba(123,92,255,.22), transparent 70%);
      pointer-events:none;
    }
    .auth-head{
      position:relative;
      z-index:1;
      text-align:center;
      margin-bottom:24px;
    }
    .auth-head h1{
      margin:0 0 8px;
      font-size:1.8rem;
      font-weight:900;
      letter-spacing:.3px;
    }
    .auth-head p{
      margin:0;
      color:var(--muted);
      line-height:1.6;
      font-size:.95rem;
    }

    .auth-panel{display:none; position:relative; z-index:1;}
    .auth-panel.active{display:block;}

    .field{
      display:grid;
      gap:8px;
      margin-bottom:16px;
    }
    .field label{
      color:#d9e6ff;
      font-weight:700;
      font-size:.92rem;
    }
    .field input,
    .field textarea{
      width:100%;
      border:1px solid rgba(255,255,255,.08);
      background:rgba(8,16,29,.8);
      color:var(--text);
      border-radius:16px;
      padding:14px 16px;
      outline:none;
      transition:.2s ease;
    }
    .field input::placeholder,
    .field textarea::placeholder{
      color:#6f83aa;
    }
    .field input:focus,
    .field textarea:focus{
      border-color:rgba(79,140,255,.55);
      box-shadow:0 0 0 4px rgba(79,140,255,.14);
    }

    .password-wrap{
      position:relative;
    }
    .password-wrap input{
      padding-right:56px;
    }
    .eye-btn{
      position:absolute;
      top:50%;
      right:12px;
      transform:translateY(-50%);
      border:none;
      background:transparent;
      color:#b7c8ea;
      cursor:pointer;
      font-size:1.05rem;
      padding:8px;
      border-radius:10px;
    }
    .eye-btn:hover{background:rgba(255,255,255,.06)}

    .btn{
      border:none;
      cursor:pointer;
      border-radius:16px;
      padding:14px 18px;
      font-weight:800;
      transition:.2s ease;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      text-align:center;
    }
    .btn:disabled{
      opacity:.65;
      cursor:not-allowed;
    }
    .btn-primary{
      width:100%;
      color:white;
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      box-shadow:0 14px 28px rgba(79,140,255,.28);
    }
    .btn-primary:hover{transform:translateY(-1px)}
    .btn-secondary{
      background:rgba(255,255,255,.06);
      color:#dce8ff;
      border:1px solid rgba(255,255,255,.08);
    }
    .btn-success{
      background:linear-gradient(135deg,#16a34a,#22c55e);
      color:#fff;
    }
    .btn-danger{
      background:linear-gradient(135deg,#dc2626,#ef4444);
      color:#fff;
    }
    .btn-warning{
      background:linear-gradient(135deg,#d97706,#f59e0b);
      color:#fff;
    }

    .auth-links{
      margin-top:16px;
      display:grid;
      gap:10px;
      text-align:center;
      color:var(--muted);
      font-size:.95rem;
    }
    .auth-links a{
      color:#dce8ff;
      font-weight:700;
      cursor:pointer;
    }
    .auth-note{
      margin-top:14px;
      color:#9db2d9;
      font-size:.88rem;
      text-align:center;
      line-height:1.6;
    }

    /* =========================
       APP (LOGGED IN)
       ========================= */
    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      margin-bottom:18px;
      padding:18px 20px;
    }
    .topbar-left{
      display:flex;align-items:center;gap:14px;
    }
    .topbar-logo{
      width:48px;height:48px;border-radius:16px;
      display:grid;place-items:center;
      font-weight:900;
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      box-shadow:0 12px 28px rgba(79,140,255,.28);
    }
    .topbar h1{
      margin:0;
      font-size:1.2rem;
      font-weight:900;
    }
    .topbar p{
      margin:4px 0 0;
      color:var(--muted);
      font-size:.9rem;
    }
    .phone-pill{
      padding:12px 16px;
      border-radius:999px;
      background:rgba(255,255,255,.06);
      border:1px solid rgba(255,255,255,.08);
      font-weight:800;
      white-space:nowrap;
    }

    .page{
      display:none;
      animation:fadeUp .22s ease;
    }
    .page.active{display:block;}

    @keyframes fadeUp{
      from{opacity:0;transform:translateY(8px)}
      to{opacity:1;transform:translateY(0)}
    }

    .grid{
      display:grid;
      gap:16px;
    }
    .grid-3{
      grid-template-columns:repeat(3,minmax(0,1fr));
    }
    .grid-2{
      grid-template-columns:repeat(2,minmax(0,1fr));
    }
    .stack{display:grid;gap:16px}

    .card{
      padding:20px;
      border-radius:22px;
      background:linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.03));
      border:1px solid var(--line);
      box-shadow:var(--shadow);
    }
    .card h3,.card h4,.card h2{
      margin:0 0 8px;
    }
    .card-title{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:12px;
    }
    .card-title h2{
      font-size:1.05rem;
      font-weight:900;
    }
    .muted{
      color:var(--muted);
    }
    .tiny{font-size:.86rem}

    .wallet-card{
      position:relative;
      overflow:hidden;
      min-height:150px;
    }
    .wallet-card::after{
      content:"";
      position:absolute;
      inset:auto -30px -30px auto;
      width:120px;height:120px;border-radius:50%;
      background:radial-gradient(circle, rgba(255,255,255,.15), transparent 70%);
      pointer-events:none;
    }
    .wallet-card.balance{
      background:linear-gradient(135deg, rgba(79,140,255,.26), rgba(123,92,255,.22));
    }
    .wallet-card.today{
      background:linear-gradient(135deg, rgba(34,197,94,.24), rgba(22,163,74,.16));
    }
    .wallet-card.total{
      background:linear-gradient(135deg, rgba(245,158,11,.24), rgba(217,119,6,.16));
    }
    .wallet-label{
      color:#dce8ff;
      font-weight:700;
      font-size:.95rem;
      margin-bottom:14px;
    }
    .wallet-value{
      font-size:1.9rem;
      font-weight:900;
      letter-spacing:.2px;
      margin-bottom:8px;
    }
    .wallet-sub{
      color:#d9e4ff;
      opacity:.92;
      font-size:.9rem;
    }

    .actions-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:16px;
    }
    .action-card{
      padding:20px;
      border-radius:22px;
      background:linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
      border:1px solid var(--line);
      box-shadow:var(--shadow);
    }
    .action-card h3{margin:0 0 8px;font-size:1.08rem}
    .action-card p{margin:0 0 14px;color:var(--muted);line-height:1.6}
    .action-card form{display:grid;gap:12px}
    .action-card input{
      width:100%;
      border:1px solid rgba(255,255,255,.08);
      background:rgba(8,16,29,.8);
      color:var(--text);
      border-radius:14px;
      padding:13px 14px;
      outline:none;
    }

    .investments-list{
      display:grid;
      gap:14px;
    }
    .investment-item{
      padding:16px;
      border-radius:18px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.07);
      display:grid;
      gap:8px;
    }
    .investment-head{
      display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;
    }
    .pill{
      padding:8px 12px;border-radius:999px;font-size:.85rem;font-weight:800;
      display:inline-flex;align-items:center;gap:6px;
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.08);
    }
    .pill.green{background:rgba(34,197,94,.16);border-color:rgba(34,197,94,.25);color:#ddffe9}
    .pill.orange{background:rgba(245,158,11,.14);border-color:rgba(245,158,11,.22);color:#fff0d0}
    .pill.red{background:rgba(239,68,68,.14);border-color:rgba(239,68,68,.22);color:#ffe1e1}

    .tasks-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:16px;
    }
    .task-card{
      padding:18px;
      border-radius:22px;
      background:linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.03));
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      display:grid;
      gap:14px;
    }
    .task-card h3{
      margin:0;
      font-size:1.02rem;
      line-height:1.45;
    }
    .task-meta{
      display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;
      color:var(--muted);
      font-size:.92rem;
    }
    .task-actions{
      display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;
    }
    .countdown{
      font-weight:800;
      color:#dce8ff;
    }

    .cities-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:18px;
    }
    .city-card{
      overflow:hidden;
      padding:0;
    }
    .city-banner{
      position:relative;
      min-height:180px;
      background-size:cover;
      background-position:center;
    }
    .city-banner::after{
      content:"";
      position:absolute;inset:0;
      background:linear-gradient(180deg, rgba(8,16,29,.1), rgba(8,16,29,.82));
    }
    .city-top{
      position:absolute;
      inset:auto 18px 18px 18px;
      z-index:2;
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:14px;
    }
    .city-top h3{
      margin:0 0 6px;
      font-size:1.28rem;
      font-weight:900;
    }
    .city-top p{
      margin:0;
      color:#d9e6ff;
      opacity:.92;
    }
    .city-body{
      padding:18px;
      display:grid;
      gap:14px;
    }
    .city-stats{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:12px;
    }
    .mini-stat{
      padding:14px;
      border-radius:16px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
    }
    .mini-stat .label{
      color:var(--muted);
      font-size:.86rem;
      margin-bottom:6px;
    }
    .mini-stat .value{
      font-weight:900;
      font-size:1rem;
    }
    .city-form{
      display:grid;gap:12px;
    }
    .city-form input{
      width:100%;
      border:1px solid rgba(255,255,255,.08);
      background:rgba(8,16,29,.8);
      color:var(--text);
      border-radius:14px;
      padding:13px 14px;
      outline:none;
    }

    .spin-wrap{
      display:grid;
      gap:20px;
      justify-items:center;
      text-align:center;
    }
    .wheel{
      width:min(360px, 84vw);
      height:min(360px, 84vw);
      border-radius:50%;
      position:relative;
      border:12px solid rgba(255,255,255,.1);
      box-shadow:0 22px 50px rgba(0,0,0,.35);
      background:
        conic-gradient(
          #4f8cff 0deg 60deg,
          #22c55e 60deg 120deg,
          #f59e0b 120deg 180deg,
          #7b5cff 180deg 240deg,
          #ef4444 240deg 300deg,
          #06b6d4 300deg 360deg
        );
      transition:transform 5s cubic-bezier(.17,.67,.18,1);
    }
    .wheel::before{
      content:"";
      position:absolute;inset:22px;
      border-radius:50%;
      background:rgba(8,16,29,.92);
      border:2px solid rgba(255,255,255,.08);
    }
    .wheel-center{
      position:absolute;
      inset:50%;
      transform:translate(-50%,-50%);
      width:92px;height:92px;border-radius:50%;
      display:grid;place-items:center;
      font-weight:900;
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      z-index:2;
      box-shadow:0 10px 30px rgba(79,140,255,.35);
      text-align:center;
      padding:10px;
    }
    .wheel-pointer{
      width:0;height:0;
      border-left:16px solid transparent;
      border-right:16px solid transparent;
      border-top:28px solid #fff;
      filter:drop-shadow(0 8px 16px rgba(0,0,0,.3));
      margin-bottom:-8px;
      z-index:2;
    }
    .wheel-label{
      position:absolute;
      top:50%;left:50%;
      transform-origin:0 0;
      font-size:.82rem;
      font-weight:900;
      color:white;
      z-index:1;
      text-shadow:0 2px 8px rgba(0,0,0,.45);
      pointer-events:none;
    }
    .spin-result{
      min-height:26px;
      font-size:1rem;
      font-weight:800;
      color:#dce8ff;
    }

    .menu-list{
      display:grid;
      gap:14px;
    }
    .menu-item{
      width:100%;
      text-align:left;
      padding:18px 18px;
      border-radius:18px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      color:var(--text);
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      cursor:pointer;
      transition:.2s ease;
    }
    .menu-item:hover{transform:translateY(-1px);background:rgba(255,255,255,.06)}
    .menu-item .left{
      display:flex;align-items:center;gap:14px;
    }
    .menu-icon{
      width:46px;height:46px;border-radius:14px;
      display:grid;place-items:center;
      background:linear-gradient(135deg, rgba(79,140,255,.24), rgba(123,92,255,.24));
      border:1px solid rgba(255,255,255,.08);
      font-size:1.2rem;
    }

    .subpage{
      display:none;
    }
    .subpage.active{
      display:block;
      animation:fadeUp .2s ease;
    }
    .back-row{
      display:flex;
      align-items:center;
      gap:10px;
      margin-bottom:16px;
    }
    .back-btn{
      width:44px;height:44px;border-radius:14px;border:none;cursor:pointer;
      background:rgba(255,255,255,.06);color:var(--text);
      border:1px solid rgba(255,255,255,.08);
      font-size:1.15rem;
    }
    .section-title{
      font-size:1.2rem;
      font-weight:900;
      margin:0;
    }

    .profile-grid{
      display:grid;
      gap:14px;
    }
    .detail-row{
      display:flex;
      justify-content:space-between;
      gap:12px;
      padding:14px 0;
      border-bottom:1px solid rgba(255,255,255,.06);
      flex-wrap:wrap;
    }
    .detail-row:last-child{border-bottom:none}
    .detail-row .label{color:var(--muted);font-weight:700}
    .detail-row .value{font-weight:800}

    .support-links{
      display:grid;gap:14px;
    }
    .support-link{
      display:flex;align-items:center;justify-content:space-between;gap:12px;
      padding:18px;border-radius:18px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
      word-break:break-word;
    }

    .referral-box{
      display:grid;gap:16px;
    }
    .copy-wrap{
      display:flex;gap:10px;flex-wrap:wrap;
    }
    .copy-wrap input{
      flex:1 1 240px;
      border:1px solid rgba(255,255,255,.08);
      background:rgba(8,16,29,.8);
      color:var(--text);
      border-radius:14px;
      padding:13px 14px;
      outline:none;
    }

    .terms{
      display:grid;
      gap:14px;
      line-height:1.75;
      color:#e4eeff;
    }
    .terms h4{
      margin:6px 0 2px;
      font-size:1rem;
      font-weight:900;
    }

    .tx-list{
      display:grid;
      gap:12px;
    }
    .tx-item{
      padding:16px;
      border-radius:18px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      display:grid;
      gap:8px;
    }
    .tx-head{
      display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;
    }
    .tx-title{
      font-weight:900;
      letter-spacing:.2px;
    }
    .tx-detail{color:var(--muted);line-height:1.6}

    .download-card{
      display:grid;gap:16px;
      text-align:center;
      justify-items:center;
    }
    .download-icon{
      width:78px;height:78px;border-radius:24px;
      display:grid;place-items:center;
      font-size:2rem;
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      box-shadow:0 18px 34px rgba(79,140,255,.28);
    }

    .nav{
      position:fixed;
      left:0;right:0;bottom:0;
      z-index:50;
      padding:12px 14px calc(12px + env(safe-area-inset-bottom));
      background:linear-gradient(180deg, rgba(11,18,32,.15), rgba(11,18,32,.92));
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .nav-inner{
      max-width:920px;
      margin:0 auto;
      display:grid;
      grid-template-columns:repeat(5,minmax(0,1fr));
      gap:10px;
      padding:10px;
      border-radius:24px;
      background:rgba(8,16,29,.9);
      border:1px solid rgba(255,255,255,.08);
      box-shadow:0 18px 40px rgba(0,0,0,.32);
    }
    .nav-btn{
      border:none;
      cursor:pointer;
      border-radius:18px;
      background:transparent;
      color:#c9d8f5;
      padding:12px 8px;
      display:grid;
      justify-items:center;
      gap:6px;
      transition:.2s ease;
      font-weight:800;
    }
    .nav-btn .icon{
      width:42px;height:42px;border-radius:14px;
      display:grid;place-items:center;
      background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.06);
      font-size:1.18rem;
      transition:.2s ease;
    }
    .nav-btn.active{
      color:white;
    }
    .nav-btn.active .icon{
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      box-shadow:0 10px 24px rgba(79,140,255,.25);
      border-color:transparent;
    }

    .empty{
      padding:20px;
      border-radius:18px;
      background:rgba(255,255,255,.04);
      border:1px dashed rgba(255,255,255,.12);
      color:var(--muted);
      text-align:center;
      line-height:1.7;
    }

    .admin-link{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:12px 16px;
      border-radius:14px;
      background:rgba(245,158,11,.12);
      border:1px solid rgba(245,158,11,.22);
      color:#ffe9bf;
      font-weight:800;
      margin-top:10px;
    }

    @media (max-width: 980px){
      .grid-3{grid-template-columns:1fr}
      .grid-2{grid-template-columns:1fr}
      .tasks-grid,
      .cities-grid{grid-template-columns:1fr}
    }

    @media (max-width: 760px){
      .shell{padding:16px 12px 120px}
      .topbar{
        flex-direction:column;
        align-items:flex-start;
      }
      .phone-pill{
        width:100%;
        text-align:center;
      }
      .actions-grid{grid-template-columns:1fr}
      .wallet-value{font-size:1.65rem}
      .auth-card{padding:24px 18px}
    }

    @media (max-width: 520px){
      .nav-btn span.label{font-size:.78rem}
      .nav-btn .icon{width:38px;height:38px}
      .wallet-card{min-height:135px}
      .task-actions{align-items:flex-start}
    }
  </style>
</head>
<body>
  <% function formatMoney(value){ return Number(value || 0).toLocaleString('en-KE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }); } %>
  <% function cityStatus(code){ return internExpired && code === 'INTERN' ? 'Expired' : 'Active'; } %>

  <% if (!user) { %>
    <!-- =========================
         LOGGED OUT / AUTH PAGE
         ========================= -->
    <div class="auth-shell">
      <div class="auth-card glass">
        <div class="brand-row">
          <div class="brand-badge">B</div>
          <div>
            <div class="brand-title">BITREX</div>
            <div class="brand-sub">Investment & task rewards platform</div>
          </div>
        </div>

        <div class="alert-stack">
          <% if (message) { %>
            <div class="alert success"><%= message %></div>
          <% } %>
          <% if (error) { %>
            <div class="alert error"><%= error %></div>
          <% } %>
        </div>

        <!-- LOGIN PANEL -->
        <section class="auth-panel <%= authMode === 'signup' || authMode === 'forgot' ? '' : 'active' %>" id="auth-login">
          <div class="auth-head">
            <h1>Welcome back</h1>
            <p>Login to continue to your BITREX dashboard.</p>
          </div>

          <form action="/login" method="POST">
            <div class="field">
              <label for="loginPhone">Phone Number</label>
              <input id="loginPhone" type="tel" name="phone" placeholder="0712345678" required />
            </div>

            <div class="field">
              <label for="loginPassword">Password</label>
              <div class="password-wrap">
                <input id="loginPassword" type="password" name="password" placeholder="Enter password" required />
                <button type="button" class="eye-btn" data-toggle-password="loginPassword" aria-label="Show password">👁️</button>
              </div>
            </div>

            <button class="btn btn-primary" type="submit">Login</button>
          </form>

          <div class="auth-links">
            <div>Don’t have account? <a href="#" data-open-auth="signup">Sign up</a></div>
            <div><a href="#" data-open-auth="forgot">Forgot password?</a></div>
          </div>
        </section>

        <!-- SIGNUP PANEL -->
        <section class="auth-panel <%= authMode === 'signup' ? 'active' : '' %>" id="auth-signup">
          <div class="auth-head">
            <h1>Create account</h1>
            <p>Open your BITREX account to start city investments and task rewards.</p>
          </div>

          <form action="/signup" method="POST">
            <div class="field">
              <label for="signupName">Full Name</label>
              <input id="signupName" type="text" name="name" placeholder="Enter your name" />
            </div>

            <div class="field">
              <label for="signupPhone">Phone Number</label>
              <input id="signupPhone" type="tel" name="phone" placeholder="0712345678" required />
            </div>

            <div class="field">
              <label for="signupEmail">Email Address</label>
              <input id="signupEmail" type="email" name="email" placeholder="you@example.com" required />
            </div>

            <div class="field">
              <label for="signupPassword">Password</label>
              <div class="password-wrap">
                <input id="signupPassword" type="password" name="password" minlength="6" maxlength="8" placeholder="6-8 characters" required />
                <button type="button" class="eye-btn" data-toggle-password="signupPassword" aria-label="Show password">👁️</button>
              </div>
            </div>

            <div class="field">
              <label for="signupReferral">Referral Code (optional)</label>
              <input id="signupReferral" type="text" name="referralCode" value="<%= referralFromQuery || '' %>" placeholder="Enter referral code if any" />
            </div>

            <button class="btn btn-primary" type="submit">Create account</button>
          </form>

          <div class="auth-links">
            <div>Already have an account? <a href="#" data-open-auth="login">Login</a></div>
          </div>
          <div class="auth-note">
            Password must be between 6 and 8 characters.
          </div>
        </section>

        <!-- FORGOT PANEL -->
        <section class="auth-panel <%= authMode === 'forgot' ? 'active' : '' %>" id="auth-forgot">
          <div class="auth-head">
            <h1>Reset password</h1>
            <p>Use your registered email address to set a new password.</p>
          </div>

          <form action="/forgot-password" method="POST">
            <div class="field">
              <label for="forgotEmail">Registered Email</label>
              <input id="forgotEmail" type="email" name="email" placeholder="you@example.com" required />
            </div>

            <div class="field">
              <label for="forgotNewPassword">New Password</label>
              <div class="password-wrap">
                <input id="forgotNewPassword" type="password" name="newPassword" minlength="6" maxlength="8" placeholder="6-8 characters" required />
                <button type="button" class="eye-btn" data-toggle-password="forgotNewPassword" aria-label="Show password">👁️</button>
              </div>
            </div>

            <div class="field">
              <label for="forgotConfirmPassword">Confirm New Password</label>
              <div class="password-wrap">
                <input id="forgotConfirmPassword" type="password" name="confirmNewPassword" minlength="6" maxlength="8" placeholder="Repeat new password" required />
                <button type="button" class="eye-btn" data-toggle-password="forgotConfirmPassword" aria-label="Show password">👁️</button>
              </div>
            </div>

            <button class="btn btn-primary" type="submit">Reset password</button>
          </form>

          <div class="auth-links">
            <div>Remembered your password? <a href="#" data-open-auth="login">Back to login</a></div>
          </div>
        </section>
      </div>
    </div>

  <% } else { %>
    <!-- =========================
         LOGGED IN APP
         ========================= -->
    <div class="shell">
      <div class="alert-stack">
        <% if (message) { %>
          <div class="alert success"><%= message %></div>
        <% } %>
        <% if (error) { %>
          <div class="alert error"><%= error %></div>
        <% } %>
      </div>

      <header class="topbar glass">
        <div class="topbar-left">
          <div class="topbar-logo">B</div>
          <div>
            <h1>BITREX Dashboard</h1>
            <p>Manage tasks, investments, deposits and rewards.</p>
          </div>
        </div>
        <div class="phone-pill">📱 <%= user.phone %></div>
      </header>

      <!-- HOME PAGE -->
      <section class="page <%= activeTab === 'home' || !activeTab ? 'active' : '' %>" id="page-home">
        <div class="stack">
          <div class="grid grid-3">
            <div class="wallet-card card balance">
              <div class="wallet-label">Wallet Balance</div>
              <div class="wallet-value">KSH <%= formatMoney(user.balance) %></div>
              <div class="wallet-sub">Available balance for investments and withdrawals</div>
            </div>

            <div class="wallet-card card today">
              <div class="wallet-label">Today’s Income</div>
              <div class="wallet-value">KSH <%= formatMoney(user.todayIncome) %></div>
              <div class="wallet-sub"><%= user.tasksCompletedToday || 0 %> task(s) completed today</div>
            </div>

            <div class="wallet-card card total">
              <div class="wallet-label">Total Earnings</div>
              <div class="wallet-value">KSH <%= formatMoney(user.totalEarnings) %></div>
              <div class="wallet-sub">Lifetime earnings from tasks, bonuses and rewards</div>
            </div>
          </div>

          <div class="actions-grid">
            <div class="action-card">
              <div class="card-title">
                <h3>Deposit</h3>
                <span class="pill green">Minimum KSH 200</span>
              </div>
              <p>Fund your wallet instantly through IntaSend M-Pesa STK Push.</p>
              <form action="/deposit" method="POST">
                <input type="number" name="amount" min="200" step="1" placeholder="Enter amount" required />
                <input type="tel" name="phone" value="<%= user.phone %>" placeholder="Phone number" required />
                <button class="btn btn-success" type="submit">Deposit Now</button>
              </form>
            </div>

            <div class="action-card">
              <div class="card-title">
                <h3>Withdraw</h3>
                <span class="pill orange">Minimum KSH 300</span>
              </div>
              <p>Submit a withdrawal request to your registered M-Pesa number.</p>
              <form action="/withdraw" method="POST">
                <input type="number" name="amount" min="300" step="1" placeholder="Enter amount" required />
                <input type="tel" name="phone" value="<%= user.phone %>" placeholder="Phone number" required />
                <input type="password" name="withdrawalPassword" placeholder="Withdrawal password" required />
                <button class="btn btn-warning" type="submit">Request Withdrawal</button>
              </form>
            </div>
          </div>

          <div class="card">
            <div class="card-title">
              <h2>Active Investments</h2>
              <span class="pill"><%= user.activeCities.length %> active city(ies)</span>
            </div>

            <% if (!user.activeCities.length) { %>
              <div class="empty">
                You have not joined any city yet. Open the <strong>Cities</strong> tab to activate your first investment package.
              </div>
            <% } else { %>
              <div class="investments-list">
                <% user.activeCities.forEach(function(code){ 
                    const city = cityConfig[code];
                    if (!city) return;
                %>
                  <div class="investment-item">
                    <div class="investment-head">
                      <div>
                        <strong><%= city.city %></strong>
                        <div class="muted tiny">Package code: <%= code %></div>
                      </div>
                      <% if (code === 'INTERN' && internExpired) { %>
                        <span class="pill red">Expired</span>
                      <% } else { %>
                        <span class="pill green">Active</span>
                      <% } %>
                    </div>

                    <div class="grid grid-2">
                      <div class="mini-stat">
                        <div class="label">Investment Amount</div>
                        <div class="value">KSH <%= formatMoney(city.amount) %></div>
                      </div>
                      <div class="mini-stat">
                        <div class="label">Tasks Per Day</div>
                        <div class="value"><%= city.tasksPerDay %></div>
                      </div>
                      <div class="mini-stat">
                        <div class="label">Daily Income</div>
                        <div class="value">KSH <%= formatMoney(city.dailyIncome) %></div>
                      </div>
                      <div class="mini-stat">
                        <div class="label">Duration</div>
                        <div class="value"><%= city.durationDays %> day(s)</div>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <% if (isAdminPhone) { %>
              <a class="admin-link" href="/admin">🛡️ Open Admin Portal</a>
            <% } %>
          </div>
        </div>
      </section>

      <!-- TASK PAGE -->
      <section class="page <%= activeTab === 'task' ? 'active' : '' %>" id="page-task">
        <div class="card" style="margin-bottom:16px;">
          <div class="card-title">
            <h2>Task Center</h2>
            <span class="pill">
              Completed <strong style="margin-left:6px;"><%= user.tasksCompletedToday || 0 %>/<%= taskLimitToday || 0 %></strong>
            </span>
          </div>
          <p class="muted" style="margin:0;">
            Click <strong>Claim</strong> on a task. A 1 minute countdown starts. When it finishes, the task is submitted automatically and changes to <strong>Claimed</strong>.
          </p>
        </div>

        <% if (!user.activeCities.length) { %>
          <div class="empty">
            You need at least one active city investment before you can claim tasks.
          </div>
        <% } else if ((taskLimitToday || 0) <= 0) { %>
          <div class="empty">
            No tasks are available right now. Your INTERN package may have expired.
          </div>
        <% } else { %>
          <div class="tasks-grid" id="tasksGrid">
            <% tasks.forEach(function(taskName, index){ 
                const claimed = Array.isArray(user.claimedTasksToday) && user.claimedTasksToday.includes(taskName);
                const limitReached = (user.tasksCompletedToday || 0) >= (taskLimitToday || 0);
            %>
              <div class="task-card"
                   data-task-card
                   data-task-name="<%= taskName %>"
                   data-claimed="<%= claimed ? 'true' : 'false' %>"
                   data-disabled="<%= (claimed || limitReached) ? 'true' : 'false' %>">
                <div class="task-meta">
                  <span class="pill">Task #<%= index + 1 %></span>
                  <span class="pill green">Reward KSH 50</span>
                </div>
                <h3><%= taskName %></h3>
                <div class="task-actions">
                  <div class="countdown" data-countdown>
                    <%= claimed ? 'Claimed' : 'Ready to claim' %>
                  </div>
                  <button
                    class="btn <%= claimed ? 'btn-secondary' : 'btn-primary' %>"
                    type="button"
                    data-claim-btn
                    <%= (claimed || limitReached) ? 'disabled' : '' %>>
                    <%= claimed ? 'Claimed' : 'Claim' %>
                  </button>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

      <!-- CITIES PAGE -->
      <section class="page <%= activeTab === 'city' ? 'active' : '' %>" id="page-cities">
        <div class="cities-grid">
          <% Object.keys(cityConfig).forEach(function(code){ 
              const city = cityConfig[code];
              const joined = user.activeCities.includes(code);
              const expired = code === 'INTERN' && internExpired;
          %>
            <div class="city-card card">
              <div class="city-banner" style="background-image:url('<%= city.image %>')">
                <div class="city-top">
                  <div>
                    <h3><%= city.city %></h3>
                    <p>Package <strong><%= code %></strong></p>
                  </div>
                  <% if (joined) { %>
                    <% if (expired) { %>
                      <span class="pill red">Expired</span>
                    <% } else { %>
                      <span class="pill green">Joined</span>
                    <% } %>
                  <% } else { %>
                    <span class="pill">Available</span>
                  <% } %>
                </div>
              </div>

              <div class="city-body">
                <div class="city-stats">
                  <div class="mini-stat">
                    <div class="label">Amount</div>
                    <div class="value">KSH <%= formatMoney(city.amount) %></div>
                  </div>
                  <div class="mini-stat">
                    <div class="label">Tasks / Day</div>
                    <div class="value"><%= city.tasksPerDay %></div>
                  </div>
                  <div class="mini-stat">
                    <div class="label">Daily Income</div>
                    <div class="value">KSH <%= formatMoney(city.dailyIncome) %></div>
                  </div>
                  <div class="mini-stat">
                    <div class="label">Duration</div>
                    <div class="value"><%= city.durationDays %> days</div>
                  </div>
                </div>

                <% if (joined && !expired) { %>
                  <div class="empty" style="padding:16px;">
                    You have already joined this city.
                  </div>
                <% } else if (joined && expired) { %>
                  <div class="empty" style="padding:16px;">
                    This INTERN package has expired and cannot be rejoined from the same active slot.
                  </div>
                <% } else { %>
                  <form class="city-form" action="/invest/<%= code %>" method="POST">
                    <input type="text" name="signature" placeholder="Type your signature to accept city contract" required />
                    <button class="btn btn-primary" type="submit">
                      <%= city.amount > 0 ? `Invest KSH ${formatMoney(city.amount)}` : 'Join for Free' %>
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </section>

      <!-- SPIN PAGE -->
      <section class="page <%= activeTab === 'spin' ? 'active' : '' %>" id="page-spin">
        <div class="card">
          <div class="spin-wrap">
            <div class="wheel-pointer"></div>
            <div class="wheel" id="spinWheel">
              <div class="wheel-center">SPIN</div>

              <div class="wheel-label" style="transform: rotate(30deg) translate(108px) rotate(60deg);">3 Gems</div>
              <div class="wheel-label" style="transform: rotate(90deg) translate(108px) rotate(0deg);">1 Gem</div>
              <div class="wheel-label" style="transform: rotate(150deg) translate(108px) rotate(-60deg);">2 Gems</div>
              <div class="wheel-label" style="transform: rotate(210deg) translate(108px) rotate(-120deg);">KSH 50</div>
              <div class="wheel-label" style="transform: rotate(270deg) translate(108px) rotate(-180deg);">KSH 100</div>
              <div class="wheel-label" style="transform: rotate(330deg) translate(108px) rotate(-240deg);">KSH 150</div>
            </div>

            <div class="grid grid-2" style="width:100%;max-width:620px;">
              <div class="mini-stat">
                <div class="label">Gems</div>
                <div class="value" id="spinGems"><%= Number(user.gems || 0) %></div>
              </div>
              <div class="mini-stat">
                <div class="label">Free Spins</div>
                <div class="value" id="spinFree"><%= Number(user.freeSpins || 0) %></div>
              </div>
            </div>

            <div class="muted" style="max-width:720px;line-height:1.7;">
              Every spin gives a reward. If you have a free spin it is used first. Otherwise 2 Gems are used automatically.
            </div>

            <div class="spin-result" id="spinResult">Tap the button below to spin and win a reward.</div>
            <button class="btn btn-primary" id="spinBtn" type="button">Spin the Wheel</button>
          </div>
        </div>
      </section>

      <!-- MENU PAGE -->
      <section class="page <%= activeTab === 'menu' ? 'active' : '' %>" id="page-menu">
        <!-- MENU ROOT -->
        <div class="subpage active" data-subpage="menu-root">
          <div class="card">
            <div class="card-title">
              <h2>Menu</h2>
              <span class="pill">Account & platform settings</span>
            </div>

            <div class="menu-list">
              <button class="menu-item" type="button" data-open-subpage="profile">
                <div class="left">
                  <div class="menu-icon">👤</div>
                  <div>
                    <strong>User Profile</strong>
                    <div class="muted tiny">Phone, email and change password</div>
                  </div>
                </div>
                <span>›</span>
              </button>

              <button class="menu-item" type="button" data-open-subpage="support">
                <div class="left">
                  <div class="menu-icon">💬</div>
                  <div>
                    <strong>Contact Support</strong>
                    <div class="muted tiny">WhatsApp manager and WhatsApp group</div>
                  </div>
                </div>
                <span>›</span>
              </button>

              <button class="menu-item" type="button" data-open-subpage="referrals">
                <div class="left">
                  <div class="menu-icon">🔗</div>
                  <div>
                    <strong>Referrals</strong>
                    <div class="muted tiny">Copy link, share and referral count</div>
                  </div>
                </div>
                <span>›</span>
              </button>

              <button class="menu-item" type="button" data-open-subpage="terms">
                <div class="left">
                  <div class="menu-icon">📜</div>
                  <div>
                    <strong>Terms & Conditions</strong>
                    <div class="muted tiny">Read the platform terms and policies</div>
                  </div>
                </div>
                <span>›</span>
              </button>

              <button class="menu-item" type="button" data-open-subpage="transactions">
                <div class="left">
                  <div class="menu-icon">🧾</div>
                  <div>
                    <strong>Transaction History</strong>
                    <div class="muted tiny">View all your account transactions</div>
                  </div>
                </div>
                <span>›</span>
              </button>

              <button class="menu-item" type="button" data-open-subpage="download">
                <div class="left">
                  <div class="menu-icon">⬇️</div>
                  <div>
                    <strong>Download Application</strong>
                    <div class="muted tiny">Download the platform application to your device</div>
                  </div>
                </div>
                <span>›</span>
              </button>
            </div>

            <form action="/logout" method="POST" style="margin-top:18px;">
              <button class="btn btn-danger" type="submit" style="width:100%;">Logout</button>
            </form>
          </div>
        </div>

        <!-- PROFILE -->
        <div class="subpage" data-subpage="profile">
          <div class="back-row">
            <button class="back-btn" type="button" data-back-menu>←</button>
            <h2 class="section-title">User Profile</h2>
          </div>

          <div class="card">
            <div class="profile-grid">
              <div class="detail-row">
                <div class="label">Full Name</div>
                <div class="value"><%= user.name || 'Investor' %></div>
              </div>
              <div class="detail-row">
                <div class="label">Phone Number</div>
                <div class="value"><%= user.phone %></div>
              </div>
              <div class="detail-row">
                <div class="label">Email Address</div>
                <div class="value"><%= user.email || 'Not set' %></div>
              </div>
              <div class="detail-row">
                <div class="label">Referral Code</div>
                <div class="value"><%= user.referralCode || 'N/A' %></div>
              </div>
            </div>
          </div>

          <div class="card" style="margin-top:16px;">
            <div class="card-title">
              <h2>Change Password</h2>
            </div>
            <form action="/profile/password" method="POST" class="stack">
              <div class="field" style="margin:0;">
                <label for="currentPassword">Current Password</label>
                <div class="password-wrap">
                  <input id="currentPassword" type="password" name="currentPassword" required />
                  <button type="button" class="eye-btn" data-toggle-password="currentPassword">👁️</button>
                </div>
              </div>

              <div class="field" style="margin:0;">
                <label for="newPasswordProfile">New Password</label>
                <div class="password-wrap">
                  <input id="newPasswordProfile" type="password" name="newPassword" minlength="6" maxlength="8" required />
                  <button type="button" class="eye-btn" data-toggle-password="newPasswordProfile">👁️</button>
                </div>
              </div>

              <button class="btn btn-primary" type="submit">Update Password</button>
            </form>
          </div>
        </div>

        <!-- SUPPORT -->
        <div class="subpage" data-subpage="support">
          <div class="back-row">
            <button class="back-btn" type="button" data-back-menu>←</button>
            <h2 class="section-title">Contact Support</h2>
          </div>

          <div class="card">
            <div class="support-links">
              <a class="support-link" href="https://wa.me/254780535898" target="_blank" rel="noopener noreferrer">
                <div>
                  <strong>WhatsApp Manager</strong>
                  <div class="muted tiny">0780535898</div>
                </div>
                <span>Open</span>
              </a>

              <a class="support-link" href="https://chat.whatsapp.com/LLYrOJazzxsHqxnqdJrc2q" target="_blank" rel="noopener noreferrer">
                <div>
                  <strong>WhatsApp Group</strong>
                  <div class="muted tiny">Join the BITREX community group</div>
                </div>
                <span>Open</span>
              </a>
            </div>
          </div>
        </div>

        <!-- REFERRALS -->
        <div class="subpage" data-subpage="referrals">
          <div class="back-row">
            <button class="back-btn" type="button" data-back-menu>←</button>
            <h2 class="section-title">Referrals</h2>
          </div>

          <div class="card">
            <div class="referral-box">
              <div class="grid grid-2">
                <div class="mini-stat">
                  <div class="label">Referral Code</div>
                  <div class="value"><%= user.referralCode || 'N/A' %></div>
                </div>
                <div class="mini-stat">
                  <div class="label">Total Referrals</div>
                  <div class="value"><%= Number(user.referredCount || 0) %></div>
                </div>
              </div>

              <div>
                <div class="muted" style="margin-bottom:10px;">Your referral link</div>
                <div class="copy-wrap">
                  <input id="referralLinkInput" type="text" value="<%= referralLink || '' %>" readonly />
                  <button class="btn btn-secondary" type="button" id="copyReferralBtn">Copy Link</button>
                  <button class="btn btn-primary" type="button" id="shareReferralBtn">Share</button>
                </div>
              </div>

              <div class="empty" style="text-align:left;">
                Referral bonus: when you refer a friend who joins a city, you earn progress toward the one-time KSH 300 referral bonus after 5 qualifying referrals.
              </div>
            </div>
          </div>
        </div>

        <!-- TERMS -->
        <div class="subpage" data-subpage="terms">
          <div class="back-row">
            <button class="back-btn" type="button" data-back-menu>←</button>
            <h2 class="section-title">Terms & Conditions</h2>
          </div>

          <div class="card">
            <div class="terms">
              <div>
                <h4>1. Acceptance of Terms</h4>
                <div>By accessing and using this platform, you accept and agree to be bound by the terms and provision of this agreement. If you do not agree to abide by the above, please do not use this service.</div>
              </div>

              <div>
                <h4>2. Investment Risks</h4>
                <div>All investments carry risk. Past performance is not indicative of future results. You should carefully consider your investment objectives, level of experience, and risk appetite before making any investment decisions.</div>
              </div>

              <div>
                <h4>3. Account Responsibility</h4>
                <div>You are responsible for maintaining the confidentiality of your account and password. You agree to accept responsibility for all activities that occur under your account. Notify us immediately of any unauthorized use.</div>
              </div>

              <div>
                <h4>4. Deposits and Withdrawals</h4>
                <div>Minimum deposit amount is Ksh200. Minimum withdrawal amount is Ksh300. Withdrawals are processed within 24 hours. We reserve the right to request verification documents before processing withdrawals.</div>
              </div>

              <div>
                <h4>5. Referral Program</h4>
                <div>Referral bonuses are when you refer a friend to join a city you earn a one time bonus of ksh300.</div>
              </div>

              <div>
                <h4>6. Privacy Policy</h4>
                <div>We respect your privacy and are committed to protecting your personal data. We collect and process personal information in accordance with applicable data protection laws.</div>
              </div>

              <div>
                <h4>7. Prohibited Activities</h4>
                <div>Users are prohibited from: creating multiple accounts, using automated systems, engaging in fraudulent activities, or attempting to manipulate the platform in any way.</div>
              </div>

              <div>
                <h4>8. Termination</h4>
                <div>We may terminate or suspend your account immediately, without prior notice, for any breach of these Terms. Upon termination, your right to use the platform will immediately cease.</div>
              </div>

              <div>
                <h4>9. Contact Us</h4>
                <div>If you have any questions about these Terms, please contact our support team or hiring manager.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- TRANSACTIONS -->
        <div class="subpage" data-subpage="transactions">
          <div class="back-row">
            <button class="back-btn" type="button" data-back-menu>←</button>
            <h2 class="section-title">Transaction History</h2>
          </div>

          <div class="card">
            <% if (!Array.isArray(user.transactions) || !user.transactions.length) { %>
              <div class="empty">No transactions have been recorded yet.</div>
            <% } else { %>
              <div class="tx-list">
                <% user.transactions.forEach(function(tx){ %>
                  <div class="tx-item">
                    <div class="tx-head">
                      <div class="tx-title"><%= tx.type || 'Transaction' %></div>
                      <div class="pill <%= tx.status === 'APPROVED' ? 'green' : (tx.status === 'REJECTED' ? 'red' : '') %>">
                        <%= tx.status || 'APPROVED' %>
                      </div>
                    </div>
                    <div><strong>Amount:</strong> KSH <%= formatMoney(tx.amount || 0) %></div>
                    <div class="tx-detail"><%= tx.detail || 'No detail provided' %></div>
                    <div class="muted tiny"><%= tx.date ? new Date(tx.date).toLocaleString() : '' %></div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- DOWNLOAD -->
        <div class="subpage" data-subpage="download">
          <div class="back-row">
            <button class="back-btn" type="button" data-back-menu>←</button>
            <h2 class="section-title">Download Application</h2>
          </div>

          <div class="card">
            <div class="download-card">
              <div class="download-icon">📲</div>
              <div>
                <h3 style="margin:0 0 8px;">Download BITREX App</h3>
                <div class="muted" style="max-width:620px;line-height:1.7;">
                  Tap the button below to download the platform application to your device.
                  If you already host an APK or installable file in your public folder, update the link below to point to it.
                </div>
              </div>

              <!-- Change href to your actual app file if you upload one, e.g. /BITREX.apk -->
              <a class="btn btn-primary" href="/" download>Download Application</a>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- BOTTOM NAV -->
    <nav class="nav">
      <div class="nav-inner">
        <button class="nav-btn <%= activeTab === 'home' || !activeTab ? 'active' : '' %>" type="button" data-nav-target="home">
          <div class="icon">🏠</div>
          <span class="label">Home</span>
        </button>
        <button class="nav-btn <%= activeTab === 'task' ? 'active' : '' %>" type="button" data-nav-target="task">
          <div class="icon">📝</div>
          <span class="label">Task</span>
        </button>
        <button class="nav-btn <%= activeTab === 'city' ? 'active' : '' %>" type="button" data-nav-target="cities">
          <div class="icon">🏙️</div>
          <span class="label">Cities</span>
        </button>
        <button class="nav-btn <%= activeTab === 'spin' ? 'active' : '' %>" type="button" data-nav-target="spin">
          <div class="icon">🎡</div>
          <span class="label">Spin</span>
        </button>
        <button class="nav-btn <%= activeTab === 'menu' ? 'active' : '' %>" type="button" data-nav-target="menu">
          <div class="icon">☰</div>
          <span class="label">Menu</span>
        </button>
      </div>
    </nav>
  <% } %>

  <script>
    (function () {
      // =========================
      // AUTH PANEL SWITCHING
      // =========================
      const authPanels = {
        login: document.getElementById('auth-login'),
        signup: document.getElementById('auth-signup'),
        forgot: document.getElementById('auth-forgot')
      };

      function openAuthPanel(name) {
        if (!authPanels.login && !authPanels.signup && !authPanels.forgot) return;
        Object.keys(authPanels).forEach((key) => {
          if (authPanels[key]) authPanels[key].classList.toggle('active', key === name);
        });
      }

      document.querySelectorAll('[data-open-auth]').forEach((btn) => {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          const target = btn.getAttribute('data-open-auth');
          openAuthPanel(target);
        });
      });

      // =========================
      // PASSWORD TOGGLE
      // =========================
      document.querySelectorAll('[data-toggle-password]').forEach((btn) => {
        btn.addEventListener('click', function () {
          const id = btn.getAttribute('data-toggle-password');
          const input = document.getElementById(id);
          if (!input) return;
          input.type = input.type === 'password' ? 'text' : 'password';
        });
      });

      // If not logged in, stop here.
      const userLoggedIn = <%= user ? 'true' : 'false' %>;
      if (!userLoggedIn) return;

      // =========================
      // DASHBOARD PAGE NAVIGATION
      // =========================
      const navButtons = document.querySelectorAll('.nav-btn[data-nav-target]');
      const pages = {
        home: document.getElementById('page-home'),
        task: document.getElementById('page-task'),
        cities: document.getElementById('page-cities'),
        spin: document.getElementById('page-spin'),
        menu: document.getElementById('page-menu')
      };

      function showPage(name) {
        Object.keys(pages).forEach((key) => {
          if (pages[key]) pages[key].classList.toggle('active', key === name);
        });
        navButtons.forEach((btn) => {
          btn.classList.toggle('active', btn.getAttribute('data-nav-target') === name);
        });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      navButtons.forEach((btn) => {
        btn.addEventListener('click', function () {
          const target = btn.getAttribute('data-nav-target');
          showPage(target);
        });
      });

      // =========================
      // MENU SUBPAGES
      // =========================
      const menuSubpages = document.querySelectorAll('#page-menu .subpage');
      function openMenuSubpage(name) {
        menuSubpages.forEach((panel) => {
          panel.classList.toggle('active', panel.getAttribute('data-subpage') === name);
        });
      }

      document.querySelectorAll('[data-open-subpage]').forEach((btn) => {
        btn.addEventListener('click', function () {
          openMenuSubpage(btn.getAttribute('data-open-subpage'));
        });
      });

      document.querySelectorAll('[data-back-menu]').forEach((btn) => {
        btn.addEventListener('click', function () {
          openMenuSubpage('menu-root');
        });
      });

      // =========================
      // REFERRAL COPY / SHARE
      // =========================
      const referralInput = document.getElementById('referralLinkInput');
      const copyReferralBtn = document.getElementById('copyReferralBtn');
      const shareReferralBtn = document.getElementById('shareReferralBtn');

      if (copyReferralBtn && referralInput) {
        copyReferralBtn.addEventListener('click', async function () {
          try {
            await navigator.clipboard.writeText(referralInput.value || '');
            copyReferralBtn.textContent = 'Copied';
            setTimeout(() => { copyReferralBtn.textContent = 'Copy Link'; }, 1500);
          } catch (e) {
            referralInput.select();
            document.execCommand('copy');
            copyReferralBtn.textContent = 'Copied';
            setTimeout(() => { copyReferralBtn.textContent = 'Copy Link'; }, 1500);
          }
        });
      }

      if (shareReferralBtn && referralInput) {
        shareReferralBtn.addEventListener('click', async function () {
          const link = referralInput.value || '';
          if (!link) return;
          if (navigator.share) {
            try {
              await navigator.share({
                title: 'Join BITREX',
                text: 'Use my BITREX referral link to sign up.',
                url: link
              });
            } catch (e) {}
          } else {
            try {
              await navigator.clipboard.writeText(link);
              shareReferralBtn.textContent = 'Link Copied';
              setTimeout(() => { shareReferralBtn.textContent = 'Share'; }, 1500);
            } catch (e) {}
          }
        });
      }

      // =========================
      // TASK CLAIMING
      // Claim -> 1 minute countdown -> auto POST /api/task/claim -> Claimed
      // =========================
      const tasksGrid = document.getElementById('tasksGrid');
      let tasksCompletedToday = <%= Number(user.tasksCompletedToday || 0) %>;
      let taskLimitToday = <%= Number(taskLimitToday || 0) %>;

      function disableAllRemainingTaskButtonsIfLimitReached() {
        if (tasksCompletedToday < taskLimitToday) return;
        document.querySelectorAll('[data-task-card]').forEach((card) => {
          const claimed = card.getAttribute('data-claimed') === 'true';
          const btn = card.querySelector('[data-claim-btn]');
          const countdown = card.querySelector('[data-countdown]');
          if (!claimed && btn) {
            btn.disabled = true;
            btn.textContent = 'Limit Reached';
            btn.classList.remove('btn-primary');
            btn.classList.add('btn-secondary');
            if (countdown) countdown.textContent = 'Daily limit reached';
          }
        });
      }

      async function completeTaskClaim(taskName, card, btn, countdown) {
        try {
          const res = await fetch('/api/task/claim', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ taskName })
          });

          const data = await res.json();
          if (!res.ok || !data.ok) {
            throw new Error(data.error || 'Failed to claim task.');
          }

          card.setAttribute('data-claimed', 'true');
          btn.disabled = true;
          btn.textContent = 'Claimed';
          btn.classList.remove('btn-primary');
          btn.classList.add('btn-secondary');
          countdown.textContent = 'Claimed';

          tasksCompletedToday = Number(data.tasksCompletedToday || tasksCompletedToday + 1);
          taskLimitToday = Number(data.taskLimitToday || taskLimitToday);
          disableAllRemainingTaskButtonsIfLimitReached();

          // refresh home page income figures by reloading after short delay
          setTimeout(() => window.location.reload(), 900);
        } catch (error) {
          countdown.textContent = error.message || 'Claim failed';
          btn.disabled = false;
          btn.textContent = 'Claim';
          btn.classList.remove('btn-secondary');
          btn.classList.add('btn-primary');
        }
      }

      if (tasksGrid) {
        tasksGrid.querySelectorAll('[data-task-card]').forEach((card) => {
          const btn = card.querySelector('[data-claim-btn]');
          const countdown = card.querySelector('[data-countdown]');
          if (!btn || !countdown) return;

          btn.addEventListener('click', function () {
            if (btn.disabled) return;

            const taskName = card.getAttribute('data-task-name');
            if (!taskName) return;

            btn.disabled = true;
            btn.textContent = 'Counting...';
            btn.classList.remove('btn-primary');
            btn.classList.add('btn-secondary');

            let remaining = 60;
            countdown.textContent = `Claiming in ${remaining}s`;

            const timer = setInterval(() => {
              remaining -= 1;
              if (remaining > 0) {
                countdown.textContent = `Claiming in ${remaining}s`;
                return;
              }

              clearInterval(timer);
              countdown.textContent = 'Processing...';
              completeTaskClaim(taskName, card, btn, countdown);
            }, 1000);
          });
        });

        disableAllRemainingTaskButtonsIfLimitReached();
      }

      // =========================
      // SPIN WHEEL
      // =========================
      const spinBtn = document.getElementById('spinBtn');
      const spinWheel = document.getElementById('spinWheel');
      const spinResult = document.getElementById('spinResult');
      const spinGems = document.getElementById('spinGems');
      const spinFree = document.getElementById('spinFree');

      const wheelAngles = {
        '3 Gems': 30,
        '1 Gem': 90,
        '2 Gems': 150,
        'KSH 50': 210,
        'KSH 100': 270,
        'KSH 150': 330
      };
      let currentWheelRotation = 0;
      let spinning = false;

      if (spinBtn && spinWheel) {
        spinBtn.addEventListener('click', async function () {
          if (spinning) return;
          spinning = true;
          spinBtn.disabled = true;
          spinBtn.textContent = 'Spinning...';
          spinResult.textContent = 'Spinning the wheel...';

          try {
            const res = await fetch('/api/spin-roulette', { method: 'POST' });
            const data = await res.json();

            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Spin failed.');
            }

            const prizeLabel = data.prize && data.prize.label ? data.prize.label : 'Reward';
            const targetAngle = wheelAngles[prizeLabel] || 30;
            currentWheelRotation += 360 * 5 + (360 - targetAngle);
            spinWheel.style.transform = `rotate(${currentWheelRotation}deg)`;

            setTimeout(() => {
              spinResult.textContent = `You won ${prizeLabel}!`;
              if (spinGems) spinGems.textContent = String(data.gems ?? '');
              if (spinFree) spinFree.textContent = String(data.freeSpins ?? '');
              spinBtn.disabled = false;
              spinBtn.textContent = 'Spin Again';
              spinning = false;
            }, 5200);
          } catch (error) {
            spinResult.textContent = error.message || 'Spin failed.';
            spinBtn.disabled = false;
            spinBtn.textContent = 'Spin the Wheel';
            spinning = false;
          }
        });
      }
    })();
  </script>
</body>
</html>
