<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bitrex 722 Platform</title>
  <style>
    :root{
      --bg:#0b1020;
      --panel:#131a2d;
      --panel-2:#1a2340;
      --text:#ffffff;
      --muted:#b8c2d9;
      --primary:#3b82f6;
      --primary-2:#2563eb;
      --success:#16a34a;
      --danger:#dc2626;
      --warning:#f59e0b;
      --card:#0f172a;
      --border:rgba(255,255,255,0.08);
      --shadow:0 20px 45px rgba(0,0,0,0.35);
      --radius:18px;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Arial, Helvetica, sans-serif;
      background:linear-gradient(180deg,#08101f 0%,#0f172a 100%);
      color:var(--text);
      min-height:100vh;
    }

    a{color:inherit;text-decoration:none}
    button{cursor:pointer}
    img{max-width:100%;display:block}

    .container{
      width:min(1200px, 94%);
      margin:0 auto;
    }

    .topbar{
      position:sticky;
      top:0;
      z-index:50;
      backdrop-filter:blur(12px);
      background:rgba(8,16,31,0.75);
      border-bottom:1px solid var(--border);
    }

    .topbar-inner{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      padding:14px 0;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
      font-weight:800;
      font-size:1.15rem;
      letter-spacing:.5px;
    }

    .brand-badge{
      width:42px;height:42px;border-radius:14px;
      background:linear-gradient(135deg,var(--primary),#7c3aed);
      display:grid;place-items:center;
      font-weight:900;
      box-shadow:var(--shadow);
    }

    .nav{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }

    .nav a{
      padding:10px 14px;
      border-radius:999px;
      background:rgba(255,255,255,0.04);
      color:var(--muted);
      font-size:.95rem;
      border:1px solid transparent;
      transition:.2s ease;
    }

    .nav a:hover,
    .nav a.active{
      color:#fff;
      border-color:rgba(59,130,246,.45);
      background:rgba(59,130,246,.12);
    }

    .header-actions{
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }

    .btn{
      border:none;
      outline:none;
      padding:12px 16px;
      border-radius:12px;
      font-weight:700;
      transition:.2s ease;
    }

    .btn-primary{
      background:linear-gradient(135deg,var(--primary),var(--primary-2));
      color:#fff;
      box-shadow:0 10px 25px rgba(37,99,235,.28);
    }

    .btn-primary:hover{transform:translateY(-1px)}
    .btn-outline{
      background:transparent;
      color:#fff;
      border:1px solid rgba(255,255,255,.15);
    }

    .btn-danger{
      background:var(--danger);
      color:#fff;
    }

    .hero{
      padding:28px 0 20px;
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.25fr .95fr;
      gap:20px;
      align-items:stretch;
    }

    .hero-card,
    .card{
      background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.02));
      border:1px solid var(--border);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
    }

    .hero-card{
      padding:28px;
      min-height:340px;
      position:relative;
      overflow:hidden;
    }

    .hero-card::before{
      content:"";
      position:absolute;
      inset:auto -80px -80px auto;
      width:240px;height:240px;
      border-radius:50%;
      background:radial-gradient(circle, rgba(59,130,246,.32), transparent 70%);
      pointer-events:none;
    }

    .hero h1{
      margin:0 0 14px;
      font-size:2.3rem;
      line-height:1.1;
    }

    .hero p{
      color:var(--muted);
      max-width:760px;
      line-height:1.6;
      margin:0 0 18px;
    }

    .hero-pills{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin:18px 0 26px;
    }

    .pill{
      padding:10px 14px;
      border-radius:999px;
      background:rgba(255,255,255,.06);
      border:1px solid rgba(255,255,255,.08);
      color:#dbe7ff;
      font-size:.92rem;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:14px;
      padding:22px;
    }

    .stat{
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      border-radius:16px;
      padding:16px;
    }

    .stat h3{
      margin:0;
      font-size:1.4rem;
    }

    .stat p{
      margin:6px 0 0;
      color:var(--muted);
      font-size:.92rem;
    }

    .alerts{
      margin:18px 0 0;
      display:grid;
      gap:10px;
    }

    .alert{
      padding:14px 16px;
      border-radius:14px;
      font-weight:600;
      border:1px solid transparent;
    }

    .alert.success{
      background:rgba(22,163,74,.12);
      color:#d6ffe3;
      border-color:rgba(22,163,74,.3);
    }

    .alert.error{
      background:rgba(220,38,38,.12);
      color:#ffd9d9;
      border-color:rgba(220,38,38,.3);
    }

    .section{
      padding:18px 0 26px;
    }

    .grid{
      display:grid;
      gap:20px;
    }

    .grid-3{
      grid-template-columns:repeat(3,1fr);
    }

    .grid-2{
      grid-template-columns:repeat(2,1fr);
    }

    .card{
      padding:22px;
    }

    .card h2,
    .card h3{
      margin:0 0 12px;
    }

    .muted{
      color:var(--muted);
    }

    .kpi-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:14px;
      margin-top:14px;
    }

    .kpi{
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      border-radius:16px;
      padding:18px;
    }

    .kpi span{
      display:block;
      color:var(--muted);
      font-size:.92rem;
      margin-bottom:8px;
    }

    .kpi strong{
      font-size:1.35rem;
    }

    .city-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
      margin-top:14px;
    }

    .city-card{
      background:rgba(255,255,255,.03);
      border:1px solid rgba(255,255,255,.08);
      border-radius:18px;
      overflow:hidden;
      display:flex;
      flex-direction:column;
    }

    .city-card img{
      height:190px;
      width:100%;
      object-fit:cover;
    }

    .city-content{
      padding:18px;
      display:flex;
      flex-direction:column;
      gap:10px;
      flex:1;
    }

    .city-price{
      font-size:1.3rem;
      font-weight:800;
      color:#93c5fd;
    }

    .city-meta{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:10px;
      font-size:.95rem;
    }

    .meta-box{
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      border-radius:12px;
      padding:12px;
    }

    .input,
    .select,
    textarea{
      width:100%;
      background:#0b1326;
      color:#fff;
      border:1px solid rgba(255,255,255,.12);
      border-radius:12px;
      padding:14px 14px;
      outline:none;
      font-size:.96rem;
    }

    .input:focus,
    .select:focus,
    textarea:focus{
      border-color:rgba(59,130,246,.55);
      box-shadow:0 0 0 3px rgba(59,130,246,.14);
    }

    .form-grid{
      display:grid;
      gap:14px;
    }

    .form-grid.two{
      grid-template-columns:repeat(2,1fr);
    }

    .form-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin-top:8px;
    }

    .task-list{
      display:grid;
      gap:12px;
      margin-top:14px;
      max-height:460px;
      overflow:auto;
      padding-right:4px;
    }

    .task-item{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      padding:14px 16px;
      background:rgba(255,255,255,.03);
      border:1px solid rgba(255,255,255,.08);
      border-radius:14px;
    }

    .task-name{
      font-weight:700;
    }

    .task-badge{
      font-size:.85rem;
      color:#c7d2fe;
      background:rgba(99,102,241,.15);
      border:1px solid rgba(99,102,241,.22);
      padding:8px 12px;
      border-radius:999px;
    }

    .table-wrap{
      overflow:auto;
      margin-top:12px;
    }

    table{
      width:100%;
      border-collapse:collapse;
      min-width:780px;
    }

    th,td{
      padding:14px 12px;
      border-bottom:1px solid rgba(255,255,255,.08);
      text-align:left;
      font-size:.95rem;
    }

    th{
      color:#d7e3ff;
      background:rgba(255,255,255,.03);
    }

    .badge{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:8px 12px;
      border-radius:999px;
      font-size:.82rem;
      font-weight:800;
      letter-spacing:.2px;
    }

    .badge.ok{background:rgba(22,163,74,.16);color:#b9ffd0}
    .badge.pending{background:rgba(245,158,11,.16);color:#ffe4aa}
    .badge.no{background:rgba(220,38,38,.16);color:#ffc9c9}
    .badge.info{background:rgba(59,130,246,.16);color:#cfe0ff}

    .auth-wrap{
      min-height:100vh;
      display:grid;
      place-items:center;
      padding:30px 16px;
      background:
        radial-gradient(circle at top right, rgba(59,130,246,.2), transparent 30%),
        radial-gradient(circle at bottom left, rgba(124,58,237,.18), transparent 35%),
        linear-gradient(180deg,#07101d,#10192f);
    }

    .auth-card{
      width:min(520px,100%);
      background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.03));
      border:1px solid var(--border);
      border-radius:24px;
      padding:28px;
      box-shadow:var(--shadow);
    }

    .auth-card h1{
      margin:0 0 10px;
      font-size:2rem;
    }

    .auth-tabs{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:8px;
      margin:18px 0 20px;
    }

    .auth-tabs a{
      text-align:center;
      padding:12px;
      border-radius:12px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      color:var(--muted);
      font-weight:700;
    }

    .auth-tabs a.active{
      background:rgba(59,130,246,.14);
      border-color:rgba(59,130,246,.3);
      color:#fff;
    }

    .auth-note{
      color:var(--muted);
      margin-bottom:18px;
      line-height:1.6;
    }

    .small{
      font-size:.9rem;
      color:var(--muted);
    }

    .joined-cities{
      display:grid;
      gap:12px;
      margin-top:12px;
    }

    .joined-city{
      display:flex;
      justify-content:space-between;
      gap:12px;
      padding:14px;
      border-radius:14px;
      background:rgba(255,255,255,.03);
      border:1px solid rgba(255,255,255,.08);
    }

    .copy-box{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-top:10px;
    }

    .copy-input{
      flex:1;
      min-width:240px;
      background:#0b1326;
      border:1px solid rgba(255,255,255,.12);
      color:#fff;
      border-radius:12px;
      padding:12px;
    }

    .footer-space{
      height:30px;
    }

    @media (max-width: 1100px){
      .hero-grid,
      .grid-3,
      .grid-2,
      .city-grid,
      .kpi-grid{
        grid-template-columns:1fr 1fr;
      }
    }

    @media (max-width: 760px){
      .topbar-inner{flex-direction:column;align-items:flex-start}
      .hero-grid,
      .grid-3,
      .grid-2,
      .city-grid,
      .kpi-grid,
      .form-grid.two{
        grid-template-columns:1fr;
      }
      .hero h1{font-size:1.8rem}
      .task-item,
      .joined-city{
        flex-direction:column;
        align-items:flex-start;
      }
      .nav{
        width:100%;
      }
    }
  </style>
</head>
<body>

<% if (!user) { %>
  <!-- AUTH PAGE -->
  <div class="auth-wrap">
    <div class="auth-card">
      <div class="brand" style="margin-bottom:8px;">
        <div class="brand-badge">B</div>
        <div>Bitrex 722 Platform</div>
      </div>

      <h1>Welcome Back</h1>
      <div class="auth-note">
        Sign in to access your dashboard, city investments, daily tasks, deposits, withdrawals, and referral rewards.
      </div>

      <% if (message) { %>
        <div class="alert success"><%= message %></div>
      <% } %>
      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <div class="auth-tabs">
        <a href="/?auth=login" class="<%= authMode === 'login' ? 'active' : '' %>">Login</a>
        <a href="/?auth=signup" class="<%= authMode === 'signup' ? 'active' : '' %>">Sign Up</a>
        <a href="/?auth=forgot" class="<%= authMode === 'forgot' ? 'active' : '' %>">Forgot</a>
      </div>

      <% if (authMode === 'signup') { %>
        <form action="/signup" method="POST" class="form-grid">
          <input class="input" type="text" name="name" placeholder="Full name" />
          <input class="input" type="text" name="phone" placeholder="Phone number" required />
          <input class="input" type="email" name="email" placeholder="Email address" required />
          <input class="input" type="password" name="password" placeholder="Password (6-8 characters)" required minlength="6" maxlength="8" />
          <input class="input" type="text" name="referralCode" placeholder="Referral code (optional)" value="<%= referralFromQuery || '' %>" />
          <button class="btn btn-primary" type="submit">Create Account</button>
        </form>
      <% } else if (authMode === 'forgot') { %>
        <form action="/forgot-password" method="POST" class="form-grid">
          <input class="input" type="email" name="email" placeholder="Registered email" required />
          <input class="input" type="password" name="newPassword" placeholder="New password (6-8 chars)" required minlength="6" maxlength="8" />
          <input class="input" type="password" name="confirmNewPassword" placeholder="Confirm new password" required minlength="6" maxlength="8" />
          <button class="btn btn-primary" type="submit">Reset Password</button>
        </form>
      <% } else if (authMode === 'verify') { %>
        <div class="card" style="padding:18px;background:rgba(59,130,246,.08);border-color:rgba(59,130,246,.25)">
          <h3 style="margin-top:0;">Verify your email</h3>
          <p class="muted" style="margin-top:0;">Click the button below to confirm email verification and continue using your account.</p>
          <form action="/verify-email" method="POST">
            <button class="btn btn-primary" type="submit">Verify Email</button>
          </form>
        </div>
      <% } else { %>
        <form action="/login" method="POST" class="form-grid">
          <input class="input" type="text" name="phone" placeholder="Phone number" required />
          <input class="input" type="password" name="password" placeholder="Password" required />
          <button class="btn btn-primary" type="submit">Login to Dashboard</button>
        </form>
      <% } %>

      <div style="margin-top:18px;" class="small">
        Admin portal: <a href="/admin" style="color:#93c5fd;">Open admin login</a>
      </div>
    </div>
  </div>

<% } else { %>

  <!-- DASHBOARD -->
  <header class="topbar">
    <div class="container topbar-inner">
      <div class="brand">
        <div class="brand-badge">B</div>
        <div>Bitrex 722 Platform</div>
      </div>

      <nav class="nav">
        <a href="/?tab=home" class="<%= activeTab === 'home' ? 'active' : '' %>">Home</a>
        <a href="/?tab=city" class="<%= activeTab === 'city' ? 'active' : '' %>">City Investment</a>
        <a href="/?tab=task" class="<%= activeTab === 'task' ? 'active' : '' %>">Tasks</a>
        <a href="/?tab=wallet" class="<%= activeTab === 'wallet' ? 'active' : '' %>">Wallet</a>
        <a href="/?tab=menu" class="<%= activeTab === 'menu' ? 'active' : '' %>">Menu</a>
      </nav>

      <div class="header-actions">
        <% if (isAdminPhone) { %>
          <a href="/admin/dashboard" class="btn btn-outline">Admin Dashboard</a>
        <% } %>
        <form action="/logout" method="POST">
          <button class="btn btn-danger" type="submit">Logout</button>
        </form>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (message || error) { %>
      <div class="alerts">
        <% if (message) { %>
          <div class="alert success"><%= message %></div>
        <% } %>
        <% if (error) { %>
          <div class="alert error"><%= error %></div>
        <% } %>
      </div>
    <% } %>

    <!-- HERO / SUMMARY -->
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-card">
          <h1>Hello, <%= user.name || 'Investor' %> 👋</h1>
          <p>
            Welcome to your investment dashboard. Manage your city packages, complete daily tasks, make deposits,
            request withdrawals, track transactions, and grow your referral rewards from one place.
          </p>

          <div class="hero-pills">
            <div class="pill">Phone: <strong><%= user.phone %></strong></div>
            <div class="pill">Referral Code: <strong><%= user.referralCode %></strong></div>
            <div class="pill">Gems: <strong><%= user.gems || 0 %></strong></div>
            <div class="pill">Free Spins: <strong><%= user.freeSpins || 0 %></strong></div>
          </div>

          <div class="kpi-grid">
            <div class="kpi">
              <span>Wallet Balance</span>
              <strong>KSH <%= Number(user.balance || 0).toLocaleString() %></strong>
            </div>
            <div class="kpi">
              <span>Today Income</span>
              <strong>KSH <%= Number(user.todayIncome || 0).toLocaleString() %></strong>
            </div>
            <div class="kpi">
              <span>Total Earnings</span>
              <strong>KSH <%= Number(user.totalEarnings || 0).toLocaleString() %></strong>
            </div>
            <div class="kpi">
              <span>Tasks Today</span>
              <strong><%= user.tasksCompletedToday || 0 %>/<%= taskLimitToday || 0 %></strong>
            </div>
          </div>
        </div>

        <div class="hero-card" style="padding:0;">
          <div class="stats-grid">
            <div class="stat">
              <h3><%= user.activeCities?.length || 0 %></h3>
              <p>Active Cities</p>
            </div>
            <div class="stat">
              <h3><%= user.referredCount || 0 %></h3>
              <p>Referrals Joined</p>
            </div>
            <div class="stat">
              <h3><%= user.referralBonusEarned ? 'Yes' : 'No' %></h3>
              <p>Referral Bonus</p>
            </div>
            <div class="stat">
              <h3><%= taskLimitToday || 0 %></h3>
              <p>Task Limit Today</p>
            </div>
          </div>

          <div style="padding:0 22px 22px;">
            <div class="card" style="background:rgba(255,255,255,.03);">
              <h3 style="margin-top:0;">Referral Link</h3>
              <div class="muted">Share your referral link and invite others to join.</div>
              <div class="copy-box">
                <input id="refLink" class="copy-input" readonly value="<%= referralLink %>">
                <button class="btn btn-primary" type="button" onclick="copyReferral()">Copy Link</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HOME TAB -->
    <% if (activeTab === 'home') { %>
      <section class="section">
        <div class="grid grid-2">
          <div class="card">
            <h2>Account Overview</h2>
            <p class="muted">Your current account status, income progress, and joined cities.</p>

            <div class="joined-cities">
              <% if (user.activeCities && user.activeCities.length) { %>
                <% user.activeCities.forEach(code => { 
                    const city = cityConfig[code];
                    const joinedAt = user.cityJoinDates && user.cityJoinDates[code];
                %>
                  <div class="joined-city">
                    <div>
                      <strong><%= city ? city.city : code %></strong>
                      <div class="muted">
                        Joined: <%= joinedAt ? new Date(joinedAt).toLocaleDateString() : 'N/A' %>
                      </div>
                    </div>
                    <div>
                      <% if (code === 'INTERN' && internExpired) { %>
                        <span class="badge no">Expired</span>
                      <% } else { %>
                        <span class="badge ok">Active</span>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="joined-city">
                  <div>
                    <strong>No city joined yet</strong>
                    <div class="muted">Go to City Investment tab and activate a package to unlock tasks.</div>
                  </div>
                </div>
              <% } %>
            </div>
          </div>

          <div class="card">
            <h2>Quick Actions</h2>
            <p class="muted">Use the shortcuts below to manage your account faster.</p>
            <div class="form-actions">
              <a href="/?tab=city" class="btn btn-primary">Join City</a>
              <a href="/?tab=task" class="btn btn-outline">Start Task</a>
              <a href="/?tab=wallet" class="btn btn-outline">Deposit / Withdraw</a>
              <a href="/?tab=menu" class="btn btn-outline">Spin Roulette</a>
            </div>

            <div style="margin-top:22px;">
              <h3>Change Password</h3>
              <form action="/profile/password" method="POST" class="form-grid">
                <input class="input" type="password" name="currentPassword" placeholder="Current password" required />
                <input class="input" type="password" name="newPassword" placeholder="New password (6-8 chars)" required minlength="6" maxlength="8" />
                <button class="btn btn-primary" type="submit">Update Password</button>
              </form>
            </div>
          </div>
        </div>
      </section>
    <% } %>

    <!-- CITY TAB -->
    <% if (activeTab === 'city') { %>
      <section class="section">
        <div class="card">
          <h2>City Investment Packages</h2>
          <p class="muted">
            Join a city package to unlock daily tasks and income. Sign the contract before joining.
          </p>

          <div class="city-grid">
            <% Object.keys(cityConfig).forEach(code => {
              const city = cityConfig[code];
              const joined = user.activeCities && user.activeCities.includes(code);
            %>
              <div class="city-card">
                <img src="<%= city.image %>" alt="<%= city.city %>">
                <div class="city-content">
                  <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
                    <h3 style="margin:0;"><%= city.city %></h3>
                    <% if (joined) { %>
                      <span class="badge ok">Joined</span>
                    <% } else { %>
                      <span class="badge info"><%= code %></span>
                    <% } %>
                  </div>

                  <div class="city-price">
                    <% if (city.free) { %>
                      FREE
                    <% } else { %>
                      KSH <%= Number(city.amount || 0).toLocaleString() %>
                    <% } %>
                  </div>

                  <div class="city-meta">
                    <div class="meta-box">
                      <strong><%= city.tasksPerDay %></strong>
                      <div class="muted">Tasks / Day</div>
                    </div>
                    <div class="meta-box">
                      <strong>KSH <%= Number(city.dailyIncome || 0).toLocaleString() %></strong>
                      <div class="muted">Daily Income</div>
                    </div>
                    <div class="meta-box">
                      <strong><%= city.durationDays || 365 %></strong>
                      <div class="muted">Duration Days</div>
                    </div>
                    <div class="meta-box">
                      <strong><%= code %></strong>
                      <div class="muted">Package Code</div>
                    </div>
                  </div>

                  <% if (joined) { %>
                    <button class="btn btn-outline" type="button" disabled>Already Joined</button>
                  <% } else { %>
                    <form action="/invest/<%= code %>" method="POST" class="form-grid">
                      <input class="input" type="text" name="signature" placeholder="Type your signature to accept contract" required />
                      <button class="btn btn-primary" type="submit">Join <%= city.city %></button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- TASK TAB -->
    <% if (activeTab === 'task') { %>
      <section class="section">
        <div class="grid grid-2">
          <div class="card">
            <h2>Task Center</h2>
            <p class="muted">
              Complete available tasks to earn KSH 50 per task. Daily limit depends on your active city packages.
            </p>

            <div class="kpi-grid" style="grid-template-columns:repeat(3,1fr);">
              <div class="kpi">
                <span>Completed</span>
                <strong><%= user.tasksCompletedToday || 0 %></strong>
              </div>
              <div class="kpi">
                <span>Limit Today</span>
                <strong><%= taskLimitToday || 0 %></strong>
              </div>
              <div class="kpi">
                <span>Reward / Task</span>
                <strong>KSH 50</strong>
              </div>
            </div>

            <div style="margin-top:20px;">
              <h3>Claim Task</h3>
              <form action="/task" method="POST" class="form-grid">
                <select class="select" name="taskName" required>
                  <option value="">Select task</option>
                  <% tasks.forEach(task => { %>
                    <option value="<%= task %>"><%= task %></option>
                  <% }) %>
                </select>
                <button class="btn btn-primary" type="submit">Complete Task</button>
              </form>
            </div>
          </div>

          <div class="card">
            <h2>Available Task List</h2>
            <p class="muted">You can only claim a task once per day.</p>
            <div class="task-list">
              <% tasks.forEach(task => { %>
                <div class="task-item">
                  <div>
                    <div class="task-name"><%= task %></div>
                    <div class="muted">Reward: KSH 50</div>
                  </div>
                  <div class="task-badge">
                    <%= user.claimedTasksToday && user.claimedTasksToday.includes(task) ? 'Claimed Today' : 'Available' %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </section>
    <% } %>

    <!-- WALLET TAB -->
    <% if (activeTab === 'wallet') { %>
      <section class="section">
        <div class="grid grid-2">
          <div class="card">
            <h2>Deposit via M-Pesa</h2>
            <p class="muted">Minimum deposit is KSH 200. Enter the phone number that will receive the STK Push.</p>
            <form action="/deposit" method="POST" class="form-grid">
              <input class="input" type="number" name="amount" placeholder="Deposit amount" min="200" required />
              <input class="input" type="text" name="phone" placeholder="M-Pesa phone number" required />
              <button class="btn btn-primary" type="submit">Deposit Now</button>
            </form>
          </div>

          <div class="card">
            <h2>Withdraw Funds</h2>
            <p class="muted">Minimum withdrawal is KSH 300. Withdrawal requires your withdrawal password.</p>
            <form action="/withdraw" method="POST" class="form-grid">
              <input class="input" type="number" name="amount" placeholder="Withdrawal amount" min="300" required />
              <input class="input" type="text" name="phone" placeholder="Withdrawal phone number" required />
              <input class="input" type="password" name="withdrawalPassword" placeholder="Withdrawal password" required />
              <button class="btn btn-primary" type="submit">Request Withdrawal</button>
            </form>
          </div>
        </div>

        <div class="card" style="margin-top:20px;">
          <h2>Transaction History</h2>
          <p class="muted">Latest account activity, deposits, withdrawals, tasks, bonuses and profile updates.</p>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Amount</th>
                  <th>Detail</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% if (user.transactions && user.transactions.length) { %>
                  <% user.transactions.forEach(tx => { %>
                    <tr>
                      <td><%= tx.type %></td>
                      <td>KSH <%= Number(tx.amount || 0).toLocaleString() %></td>
                      <td><%= tx.detail || '-' %></td>
                      <td>
                        <% if (tx.status === 'APPROVED') { %>
                          <span class="badge ok">APPROVED</span>
                        <% } else if (tx.status === 'PENDING') { %>
                          <span class="badge pending">PENDING</span>
                        <% } else if (tx.status === 'REJECTED') { %>
                          <span class="badge no">REJECTED</span>
                        <% } else { %>
                          <span class="badge info"><%= tx.status || 'N/A' %></span>
                        <% } %>
                      </td>
                      <td><%= tx.date ? new Date(tx.date).toLocaleString() : '-' %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="muted">No transactions yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    <% } %>

    <!-- MENU TAB -->
    <% if (activeTab === 'menu') { %>
      <section class="section">
        <div class="grid grid-2">
          <div class="card">
            <h2>Roulette Spin</h2>
            <p class="muted">
              Use your free spins first. After that, each spin costs 2 Gems. Possible rewards include Gems and cash.
            </p>

            <div class="kpi-grid" style="grid-template-columns:repeat(3,1fr);">
              <div class="kpi">
                <span>Current Gems</span>
                <strong><%= user.gems || 0 %></strong>
              </div>
              <div class="kpi">
                <span>Free Spins</span>
                <strong><%= user.freeSpins || 0 %></strong>
              </div>
              <div class="kpi">
                <span>Spin Cost</span>
                <strong>2 Gems</strong>
              </div>
            </div>

            <form action="/spin-roulette" method="POST" style="margin-top:18px;">
              <button class="btn btn-primary" type="submit">Spin Roulette</button>
            </form>
          </div>

          <div class="card">
            <h2>Referral Rewards</h2>
            <p class="muted">
              Earn Gems when your referrals join a paid city. Reach 5 successful referral joins to unlock the KSH 300 referral bonus.
            </p>

            <div class="joined-cities">
              <div class="joined-city">
                <div>
                  <strong>Referral Code</strong>
                  <div class="muted"><%= user.referralCode %></div>
                </div>
                <span class="badge info">CODE</span>
              </div>

              <div class="joined-city">
                <div>
                  <strong>Referred Count</strong>
                  <div class="muted">Users who joined through your code</div>
                </div>
                <span class="badge ok"><%= user.referredCount || 0 %></span>
              </div>

              <div class="joined-city">
                <div>
                  <strong>Bonus Status</strong>
                  <div class="muted">One-time KSH 300 bonus after 5 successful city joins</div>
                </div>
                <% if (user.referralBonusEarned) { %>
                  <span class="badge ok">EARNED</span>
                <% } else { %>
                  <span class="badge pending">PENDING</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </section>
    <% } %>

    <div class="footer-space"></div>
  </main>

<% } %>

<script>
  function copyReferral() {
    const input = document.getElementById('refLink');
    if (!input) return;
    input.select();
    input.setSelectionRange(0, 99999);
    document.execCommand('copy');
    alert('Referral link copied.');
  }
</script>

</body>
</html>
