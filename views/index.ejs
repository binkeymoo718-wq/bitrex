<script>
  (function(){
    // ================= AUTH TABS =================
    const authButtons = document.querySelectorAll('[data-auth-tab]');
    const authLinkButtons = document.querySelectorAll('[data-auth-tab-link]');
    const authPanels = document.querySelectorAll('.auth-panel');

    function openAuthTab(tab){
      authButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.authTab === tab));
      authPanels.forEach(panel => panel.classList.toggle('active', panel.id === 'auth-' + tab));
      const url = new URL(window.location.href);
      url.searchParams.set('auth', tab);
      history.replaceState({}, '', url.toString());
    }

    authButtons.forEach(btn => {
      btn.addEventListener('click', () => openAuthTab(btn.dataset.authTab));
    });

    authLinkButtons.forEach(link => {
      link.addEventListener('click', () => openAuthTab(link.dataset.authTabLink));
    });

    // ================= PASSWORD TOGGLE =================
    document.querySelectorAll('.password-toggle').forEach(btn => {
      btn.addEventListener('click', function(){
        const input = this.parentElement.querySelector('.password-input');
        if(!input) return;
        const icon = this.querySelector('i');
        if(input.type === 'password'){
          input.type = 'text';
          if(icon){
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
          }
        }else{
          input.type = 'password';
          if(icon){
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
          }
        }
      });
    });

    // If no dashboard user, stop here.
    const loggedIn = <%- JSON.stringify(!!user) %>;
    if(!loggedIn) return;

    // ================= BOTTOM TABS =================
    const navButtons = document.querySelectorAll('.nav-btn[data-tab]');
    const tabViews = document.querySelectorAll('.tab-view');

    function openTab(tab){
      navButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.tab === tab));
      tabViews.forEach(view => view.classList.toggle('active', view.id === 'tab-' + tab));

      const url = new URL(window.location.href);
      url.searchParams.set('tab', tab);
      history.replaceState({}, '', url.toString());
    }

    navButtons.forEach(btn => {
      btn.addEventListener('click', () => openTab(btn.dataset.tab));
    });

    // ================= MENU SUBPAGES =================
    const menuMain = document.getElementById('menu-main');
    const menuPages = {
      profile: document.getElementById('menu-profile'),
      support: document.getElementById('menu-support'),
      referrals: document.getElementById('menu-referrals'),
      terms: document.getElementById('menu-terms'),
      history: document.getElementById('menu-history'),
      download: document.getElementById('menu-download')
    };

    function openMenuPage(name){
      if(!menuMain) return;
      menuMain.classList.remove('active');
      Object.values(menuPages).forEach(page => page && page.classList.remove('active'));
      if(menuPages[name]) menuPages[name].classList.add('active');
    }

    function backToMenu(){
      if(!menuMain) return;
      menuMain.classList.add('active');
      Object.values(menuPages).forEach(page => page && page.classList.remove('active'));
    }

    document.querySelectorAll('[data-menu-open]').forEach(btn => {
      btn.addEventListener('click', () => openMenuPage(btn.dataset.menuOpen));
    });

    document.querySelectorAll('[data-menu-back]').forEach(btn => {
      btn.addEventListener('click', backToMenu);
    });

    // ================= REFERRAL COPY/SHARE =================
    const refInput = document.getElementById('referralLinkInput');
    const copyBtn = document.getElementById('copyReferralBtn');
    const shareBtn = document.getElementById('shareReferralBtn');

    if(copyBtn && refInput){
      copyBtn.addEventListener('click', async () => {
        try{
          await navigator.clipboard.writeText(refInput.value);
          copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copied';
          setTimeout(() => {
            copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy Link';
          }, 1600);
        }catch{
          refInput.select();
          document.execCommand('copy');
        }
      });
    }

    if(shareBtn && refInput){
      shareBtn.addEventListener('click', async () => {
        const shareData = {
          title: 'Join BITREX-722',
          text: 'Join BITREX-722 using my referral link.',
          url: refInput.value
        };

        if(navigator.share){
          try{
            await navigator.share(shareData);
          }catch(err){}
        }else{
          window.open('https://wa.me/?text=' + encodeURIComponent(shareData.text + ' ' + shareData.url), '_blank');
        }
      });
    }

    // ================= TASK CLAIM SYSTEM =================
    const claimButtons = document.querySelectorAll('.task-claim-btn');
    let currentTasksCompleted = <%- JSON.stringify(Number(user.tasksCompletedToday || 0)) %>;
    let currentTaskLimit = <%- JSON.stringify(Number(taskLimitToday || 0)) %>;

    function formatSeconds(sec){
      const mins = String(Math.floor(sec / 60)).padStart(2, '0');
      const secs = String(sec % 60).padStart(2, '0');
      return `${mins}:${secs}`;
    }

    function updateTaskSummaryUI(){
      const badge = document.querySelector('#tab-task .badge.pending');
      if(badge){
        badge.innerHTML = `<i class="fa-solid fa-list-check"></i> ${currentTasksCompleted} / ${currentTaskLimit} Claimed Today`;
      }

      if(currentTasksCompleted >= currentTaskLimit){
        document.querySelectorAll('.task-claim-btn').forEach(btn => {
          btn.disabled = true;
          btn.classList.add('btn-dark');
        });
      }
    }

    async function completeTask(taskName, card, btn){
      try{
        const response = await fetch('/api/task/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ taskName })
        });
        const data = await response.json();

        if(!response.ok || !data.ok){
          throw new Error(data.error || 'Could not claim task.');
        }

        currentTasksCompleted = Number(data.tasksCompletedToday || currentTasksCompleted + 1);
        currentTaskLimit = Number(data.taskLimitToday || currentTaskLimit);
        updateTaskSummaryUI();

        const badge = card.querySelector('.badge');
        const countdownText = card.querySelector('.countdown-text');

        if(badge){
          badge.className = 'badge claimed';
          badge.innerHTML = '<i class="fa-solid fa-check"></i> Claimed';
        }
        if(countdownText) countdownText.textContent = 'Completed';

        btn.disabled = true;
        btn.className = 'btn btn-dark';
        btn.innerHTML = '<i class="fa-solid fa-check"></i> Claimed';
        card.dataset.claimed = 'true';

        // Refresh balance/income cards quickly without full reload
        setTimeout(() => {
          window.location.href = '/?tab=task&message=' + encodeURIComponent(data.message || 'Task completed.');
        }, 600);

      } catch(err){
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-hand-holding-dollar"></i> Claim';
        alert(err.message || 'Task claim failed.');
      }
    }

    claimButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        if(btn.disabled) return;

        if(currentTasksCompleted >= currentTaskLimit){
          alert('Task limit reached for today.');
          return;
        }

        const taskName = btn.dataset.task;
        const card = btn.closest('[data-task-card]');
        if(!card || card.dataset.claimed === 'true') return;

        btn.disabled = true;
        let seconds = 60;
        btn.innerHTML = '<i class="fa-regular fa-clock"></i> Processing...';

        const countdownText = card.querySelector('.countdown-text');
        if(countdownText) countdownText.textContent = formatSeconds(seconds);

        const timer = setInterval(() => {
          seconds--;
          if(countdownText) countdownText.textContent = formatSeconds(Math.max(seconds, 0));

          if(seconds <= 0){
            clearInterval(timer);
            completeTask(taskName, card, btn);
          }
        }, 1000);
      });
    });

    // ================= SPIN WHEEL =================
    const spinBtn = document.getElementById('spinWheelBtn');
    const wheelCircle = document.getElementById('wheelCircle');
    const spinResultBox = document.getElementById('spinResultBox');
    const spinFreeSpins = document.getElementById('spinFreeSpins');
    const spinGems = document.getElementById('spinGems');
    const spinWalletBalance = document.getElementById('spinWalletBalance');

    let wheelRotation = 0;
    const wheelRewardSlots = [
      { label: '3 Gems', angle: 30 },
      { label: '1 Gem', angle: 90 },
      { label: '2 Gems', angle: 150 },
      { label: 'KSH 50', angle: 210 },
      { label: 'KSH 100', angle: 270 },
      { label: 'KSH 150', angle: 330 }
    ];

    if(spinBtn){
      spinBtn.addEventListener('click', async () => {
        if(spinBtn.disabled) return;
        spinBtn.disabled = true;
        spinBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Spinning...';

        try{
          const response = await fetch('/api/spin-roulette', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          const data = await response.json();
          if(!response.ok || !data.ok){
            throw new Error(data.error || 'Spin failed');
          }

          const prizeLabel = data.prize?.label || 'Reward';
          const slot = wheelRewardSlots.find(item => item.label === prizeLabel) || wheelRewardSlots[Math.floor(Math.random() * wheelRewardSlots.length)];
          const extraSpins = 5 * 360;
          wheelRotation += extraSpins + (360 - slot.angle);

          if(wheelCircle){
            wheelCircle.style.transform = `rotate(${wheelRotation}deg)`;
          }

          setTimeout(() => {
            spinResultBox.innerHTML = `
              <strong style="display:block;font-size:18px;margin-bottom:8px;">Congratulations 🎉</strong>
              You won <strong>${prizeLabel}</strong>.<br/>
              ${data.message || 'Your reward has been applied to your account.'}
            `;

            if(spinFreeSpins) spinFreeSpins.textContent = data.freeSpins ?? spinFreeSpins.textContent;
            if(spinGems) spinGems.textContent = data.gems ?? spinGems.textContent;
            if(spinWalletBalance) spinWalletBalance.textContent = 'KSH ' + Number(data.balance || 0).toLocaleString();

            spinBtn.disabled = false;
            spinBtn.innerHTML = '<i class="fa-solid fa-dharmachakra"></i> Spin Now';
          }, 4200);

        }catch(err){
          spinBtn.disabled = false;
          spinBtn.innerHTML = '<i class="fa-solid fa-dharmachakra"></i> Spin Now';
          alert(err.message || 'Unable to spin right now.');
        }
      });
    }

  })();
</script>
</body>
</html>
