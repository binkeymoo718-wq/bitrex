<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BITREX 722 Platform</title>
  <meta name="theme-color" content="#0b1220" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <style>
    :root{
      --bg:#060b19;
      --bg2:#0d1a33;
      --card:#111b31cc;
      --line:#2a3d63;
      --text:#e2e8f0;
      --muted:#94a3b8;
      --blue:#4f8dff;
      --cyan:#35d3ff;
      --green:#16a34a;
      --red:#dc2626;
      --amber:#f59e0b;
      --dark:#0a1428;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      color:var(--text);
      font-family:Inter,Arial,sans-serif;
      background:
        radial-gradient(circle at 15% 10%, rgba(79,141,255,.18), transparent 20%),
        radial-gradient(circle at 85% 10%, rgba(53,211,255,.12), transparent 20%),
        linear-gradient(180deg,var(--bg),var(--bg2));
      min-height:100vh;
    }
    a{text-decoration:none;color:inherit}
    .container{max-width:1250px;margin:0 auto;padding:20px}
    .card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:18px;
      padding:18px;
      box-shadow:0 12px 36px rgba(0,0,0,.25);
    }
    .topbar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:16px;
      margin-bottom:18px;
      flex-wrap:wrap;
    }
    .brand{display:flex;align-items:center;gap:14px}
    .logo{
      width:56px;height:56px;border-radius:16px;
      display:grid;place-items:center;
      background:linear-gradient(120deg,var(--blue),var(--cyan));
      font-size:1.4rem;font-weight:900;color:white;
      box-shadow:0 10px 24px rgba(79,141,255,.35);
    }
    .brand h1{margin:0;font-size:1.25rem}
    .brand p{margin:4px 0 0;color:var(--muted);font-size:.92rem}
    .nav-actions{display:flex;gap:10px;flex-wrap:wrap}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;
      gap:8px;
      border:none;border-radius:12px;
      padding:11px 16px;
      font-weight:800;
      cursor:pointer;
      color:#fff;
      background:#22324d;
      text-decoration:none;
    }
    .btn.primary{background:linear-gradient(120deg,var(--blue),var(--cyan))}
    .btn.success{background:var(--green)}
    .btn.danger{background:var(--red)}
    .btn.outline{
      background:transparent;
      border:1px solid #38517c;
      color:#cfe0ff;
    }
    .btn.small{padding:9px 12px;border-radius:10px;font-size:.9rem}
    .msg{
      padding:12px 14px;
      border-radius:12px;
      margin-bottom:14px;
      font-weight:700;
    }
    .msg.good{background:#0f2f1b;border:1px solid #205b35;color:#9ff3ba}
    .msg.bad{background:#3a1218;border:1px solid #6d222e;color:#ffc0c8}
    .tabs{
      display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px
    }
    .tab{
      padding:10px 14px;border-radius:999px;
      background:#0a1428;border:1px solid #31486f;
      color:#cfe0ff;font-weight:800;font-size:.92rem;
    }
    .tab.active{background:linear-gradient(120deg,#1d4ed8,#2563eb)}
    .hero{
      display:grid;
      grid-template-columns:1.25fr .95fr;
      gap:18px;
      margin-bottom:18px;
    }
    .hero h2{margin:0 0 12px;font-size:2rem;line-height:1.12}
    .hero p{margin:0;color:var(--muted);line-height:1.7}
    .hero-badges{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
    .badge{
      background:#0a1428;border:1px solid #32476f;
      border-radius:999px;padding:8px 12px;
      color:#bfd3ff;font-size:.88rem;font-weight:800;
    }
    .stats{
      display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px
    }
    .pill{
      background:#0a1428;border:1px solid #32476f;
      border-radius:14px;padding:14px;
    }
    .pill .label{color:var(--muted);font-size:.9rem}
    .pill h3{margin:8px 0 0;font-size:1.45rem}
    .walletBox{
      display:flex;flex-direction:column;gap:14px;justify-content:space-between;
      min-height:100%;
    }
    .balance{
      background:#0a1428;border:1px solid #32476f;border-radius:16px;padding:16px;
    }
    .balance .small{color:var(--muted);font-size:.92rem}
    .balance .big{font-size:2rem;font-weight:900;margin-top:8px}
    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .section-title{margin:0 0 12px;font-size:1.1rem}
    .section-sub{margin:-4px 0 14px;color:var(--muted);font-size:.92rem}
    .auth-grid{
      display:grid;grid-template-columns:1fr 1fr;gap:18px
    }
    .auth-tabs{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}
    .auth-pill{
      padding:9px 12px;border-radius:999px;
      border:1px solid #36507b;background:#0a1428;
      color:#dbeafe;font-weight:800;font-size:.9rem
    }
    .auth-pill.active{background:linear-gradient(120deg,var(--blue),var(--cyan))}
    input,select,textarea{
      width:100%;
      padding:12px;
      border-radius:12px;
      border:1px solid #314158;
      background:#0a1428;
      color:#fff;
      outline:none;
      margin-top:10px;
    }
    textarea{min-height:110px;resize:vertical}
    input::placeholder, textarea::placeholder{color:#7f93b8}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .city-grid{
      display:grid;grid-template-columns:repeat(3,1fr);gap:14px
    }
    .city-card{
      overflow:hidden;padding:0
    }
    .city-banner{
      min-height:150px;
      background-size:cover;
      background-position:center;
      position:relative;
    }
    .city-banner::after{
      content:'';
      position:absolute;inset:0;
      background:linear-gradient(180deg,transparent,rgba(5,10,25,.9));
    }
    .city-code{
      position:absolute;top:12px;left:12px;z-index:1;
      background:rgba(0,0,0,.45);
      border:1px solid rgba(255,255,255,.18);
      padding:6px 10px;border-radius:999px;font-weight:800
    }
    .city-content{padding:16px}
    .city-meta{
      display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0
    }
    .mini{
      background:#0a1428;border:1px solid #32476f;
      border-radius:12px;padding:10px
    }
    .mini b{display:block;font-size:1rem;margin-top:4px}
    .joined{
      display:inline-block;padding:6px 10px;border-radius:999px;
      background:#14532d;color:#bbf7d0;font-size:.8rem;font-weight:800;margin-top:10px
    }
    .expired{
      display:inline-block;padding:6px 10px;border-radius:999px;
      background:#7f1d1d;color:#fecaca;font-size:.8rem;font-weight:800;margin-top:10px
    }
    .task-grid{
      display:grid;grid-template-columns:repeat(2,1fr);gap:12px
    }
    .task-item{
      background:#0a1428;border:1px solid #32476f;
      border-radius:14px;padding:14px;
      display:flex;flex-direction:column;gap:10px
    }
    .task-top{
      display:flex;justify-content:space-between;gap:10px;align-items:flex-start
    }
    .status{
      display:inline-block;
      padding:5px 10px;border-radius:999px;
      font-size:.76rem;font-weight:800
    }
    .APPROVED{background:#14532d;color:#bbf7d0}
    .REJECTED{background:#7f1d1d;color:#fecaca}
    .PENDING{background:#3b2a08;color:#fde68a}
    table{width:100%;border-collapse:collapse}
    th,td{
      border-bottom:1px solid #253654;
      padding:10px 8px;text-align:left;font-size:.92rem;vertical-align:top
    }
    th{color:#bfd3ff}
    .menu-grid{
      display:grid;grid-template-columns:1fr 1fr;gap:18px
    }
    .roulette{
      text-align:center
    }
    .roulette-wheel{
      width:180px;height:180px;border-radius:50%;
      margin:10px auto 18px;
      background:conic-gradient(
        #2563eb 0deg 60deg,
        #16a34a 60deg 120deg,
        #f59e0b 120deg 180deg,
        #dc2626 180deg 240deg,
        #8b5cf6 240deg 300deg,
        #06b6d4 300deg 360deg
      );
      border:8px solid #0a1428;
      box-shadow:0 0 0 3px #32476f inset, 0 14px 32px rgba(0,0,0,.28);
      position:relative;
    }
    .roulette-wheel::before{
      content:'';
      position:absolute;
      top:-18px;left:50%;transform:translateX(-50%);
      width:0;height:0;
      border-left:14px solid transparent;
      border-right:14px solid transparent;
      border-bottom:24px solid #fff;
    }
    .copy-box{
      display:flex;gap:10px;flex-wrap:wrap;margin-top:12px
    }
    .copy-input{
      flex:1;min-width:220px;
      padding:12px;border-radius:12px;
      border:1px solid #314158;background:#0a1428;color:#fff
    }
    .footer-note{
      margin-top:20px;
      color:var(--muted);
      text-align:center;
      font-size:.92rem
    }
    .muted{color:var(--muted)}
    @media(max-width:1100px){
      .city-grid{grid-template-columns:1fr 1fr}
      .stats{grid-template-columns:repeat(2,1fr)}
      .auth-grid,.menu-grid,.grid-2,.hero{grid-template-columns:1fr}
    }
    @media(max-width:720px){
      .city-grid,.task-grid{grid-template-columns:1fr}
      .form-row{grid-template-columns:1fr}
      .stats{grid-template-columns:1fr}
      .topbar{align-items:flex-start}
      .hero h2{font-size:1.55rem}
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- TOP BAR -->
    <div class="card topbar">
      <div class="brand">
        <div class="logo">B</div>
        <div>
          <h1>BITREX 722 Platform</h1>
          <p>Task & city investment dashboard with IntaSend M-Pesa deposits.</p>
        </div>
      </div>

      <div class="nav-actions">
        <% if (user) { %>
          <% if (isAdminPhone) { %>
            <a class="btn outline" href="/admin">Admin</a>
          <% } %>
          <a class="btn outline" href="/?tab=wallet">Wallet</a>
          <a class="btn outline" href="/?tab=menu">Menu</a>
          <form action="/logout" method="post" style="margin:0">
            <button class="btn danger" type="submit">Logout</button>
          </form>
        <% } else { %>
          <a class="btn outline" href="/admin">Admin</a>
          <a class="btn primary" href="/?auth=login">Login</a>
          <a class="btn success" href="/?auth=signup">Create Account</a>
        <% } %>
      </div>
    </div>

    <% if (message) { %>
      <div class="msg good"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="msg bad"><%= error %></div>
    <% } %>

    <% if (!user) { %>
      <!-- GUEST VIEW -->
      <div class="hero">
        <div class="card">
          <h2>Earn from tasks, join city packages, deposit with M-Pesa and manage your BITREX wallet.</h2>
          <p>
            Sign up to unlock city investment packages, daily task rewards, withdrawals,
            referral bonuses and roulette spins. Your account dashboard also tracks every
            transaction and pending request.
          </p>

          <div class="hero-badges">
            <span class="badge">M-Pesa STK Push</span>
            <span class="badge">Daily Task Earnings</span>
            <span class="badge">Referral Rewards</span>
            <span class="badge">City Investment Packages</span>
          </div>

          <div style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap">
            <a class="btn primary" href="/?auth=signup">Create Account</a>
            <a class="btn outline" href="/?auth=login">Login</a>
          </div>
        </div>

        <div class="card">
          <h3 class="section-title">Why join BITREX?</h3>
          <div class="stats" style="grid-template-columns:1fr 1fr">
            <div class="pill">
              <div class="label">Starter Access</div>
              <h3>INTERN</h3>
            </div>
            <div class="pill">
              <div class="label">Daily Tasks</div>
              <h3>Up to 10/day</h3>
            </div>
            <div class="pill">
              <div class="label">Deposit</div>
              <h3>M-Pesa</h3>
            </div>
            <div class="pill">
              <div class="label">Referral Bonus</div>
              <h3>KSH 300</h3>
            </div>
          </div>
          <p class="muted" style="margin-top:12px">
            Join, verify your email, activate a city package, then start completing tasks to earn.
          </p>
        </div>
      </div>

      <div class="auth-grid">
        <!-- AUTH FORM -->
        <div class="card">
          <div class="auth-tabs">
            <a href="/?auth=login" class="auth-pill <%= authMode === 'login' ? 'active' : '' %>">Login</a>
            <a href="/?auth=signup" class="auth-pill <%= authMode === 'signup' ? 'active' : '' %>">Sign Up</a>
            <a href="/?auth=forgot" class="auth-pill <%= authMode === 'forgot' ? 'active' : '' %>">Forgot Password</a>
          </div>

          <% if (authMode === 'signup') { %>
            <h3 class="section-title">Create your account</h3>
            <p class="section-sub">Password must be 6 to 8 characters.</p>
            <form action="/signup" method="post">
              <input type="text" name="name" placeholder="Full name" />
              <input type="text" name="phone" placeholder="Phone number e.g. 0722..." required />
              <input type="email" name="email" placeholder="Email address" required />
              <input type="password" name="password" placeholder="Password (6-8 chars)" minlength="6" maxlength="8" required />
              <input
                type="text"
                name="referralCode"
                placeholder="Referral code (optional)"
                value="<%= referralFromQuery || '' %>"
              />
              <button class="btn primary" type="submit" style="margin-top:12px;width:100%">Create Account</button>
            </form>

          <% } else if (authMode === 'forgot') { %>
            <h3 class="section-title">Reset your password</h3>
            <p class="section-sub">Use your registered email to reset your password.</p>
            <form action="/forgot-password" method="post">
              <input type="email" name="email" placeholder="Registered email" required />
              <input type="password" name="newPassword" placeholder="New password (6-8 chars)" minlength="6" maxlength="8" required />
              <input type="password" name="confirmNewPassword" placeholder="Confirm new password" minlength="6" maxlength="8" required />
              <button class="btn primary" type="submit" style="margin-top:12px;width:100%">Reset Password</button>
            </form>

          <% } else { %>
            <h3 class="section-title">Login to your account</h3>
            <p class="section-sub">Enter your phone number and password to continue.</p>
            <form action="/login" method="post">
              <input type="text" name="phone" placeholder="Phone number" required />
              <input type="password" name="password" placeholder="Password" required />
              <button class="btn primary" type="submit" style="margin-top:12px;width:100%">Login</button>
            </form>
          <% } %>
        </div>

        <!-- PACKAGE PREVIEW -->
        <div class="card">
          <h3 class="section-title">Available investment packages</h3>
          <p class="section-sub">Preview the city packages before you create an account.</p>

          <div style="display:grid;gap:12px">
            <% Object.entries(cityConfig).forEach(([code, city]) => { %>
              <div class="pill">
                <div style="display:flex;justify-content:space-between;gap:12px;align-items:center">
                  <div>
                    <div style="font-weight:800"><%= code %> — <%= city.city %></div>
                    <div class="muted" style="margin-top:4px">
                      KSH <%= city.amount %> • <%= city.tasksPerDay %> task(s)/day • KSH <%= city.dailyIncome %>/day
                    </div>
                  </div>
                  <span class="status APPROVED"><%= city.durationDays %> days</span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

    <% } else { %>
      <!-- LOGGED IN VIEW -->

      <!-- TAB BAR -->
      <div class="tabs">
        <a class="tab <%= activeTab === 'home' ? 'active' : '' %>" href="/?tab=home">Home</a>
        <a class="tab <%= activeTab === 'city' ? 'active' : '' %>" href="/?tab=city">City Packages</a>
        <a class="tab <%= activeTab === 'task' ? 'active' : '' %>" href="/?tab=task">Tasks</a>
        <a class="tab <%= activeTab === 'wallet' ? 'active' : '' %>" href="/?tab=wallet">Wallet</a>
        <a class="tab <%= activeTab === 'menu' ? 'active' : '' %>" href="/?tab=menu">Menu</a>
      </div>

      <!-- HERO / DASHBOARD -->
      <div class="hero">
        <div class="card">
          <h2>Welcome back, <%= user.name || 'Investor' %></h2>
          <p>
            Manage your city investments, claim daily tasks, fund your account using IntaSend M-Pesa STK Push,
            request withdrawals and track all activity from one dashboard.
          </p>

          <div class="stats">
            <div class="pill">
              <div class="label">Wallet Balance</div>
              <h3>KSH <%= Number(user.balance || 0).toLocaleString() %></h3>
            </div>
            <div class="pill">
              <div class="label">Today Income</div>
              <h3>KSH <%= Number(user.todayIncome || 0).toLocaleString() %></h3>
            </div>
            <div class="pill">
              <div class="label">Total Earnings</div>
              <h3>KSH <%= Number(user.totalEarnings || 0).toLocaleString() %></h3>
            </div>
            <div class="pill">
              <div class="label">Task Progress</div>
              <h3><%= user.tasksCompletedToday || 0 %>/<%= taskLimitToday || 0 %></h3>
            </div>
          </div>
        </div>

        <div class="card walletBox">
          <div class="balance">
            <div class="small">Referral code</div>
            <div class="big" style="font-size:1.35rem"><%= user.referralCode || '-' %></div>
            <div class="small" style="margin-top:10px">
              Referred users: <b><%= user.referredCount || 0 %></b> &nbsp;•&nbsp;
              Gems: <b><%= user.gems || 0 %></b> &nbsp;•&nbsp;
              Free spins: <b><%= user.freeSpins || 0 %></b>
            </div>
          </div>

          <div style="display:grid;gap:10px">
            <a href="/?tab=city" class="btn primary">Join City Package</a>
            <a href="/?tab=task" class="btn outline">Claim Task</a>
            <a href="/?tab=wallet" class="btn success">Deposit / Withdraw</a>
          </div>
        </div>
      </div>

      <!-- HOME TAB -->
      <% if (activeTab === 'home') { %>
        <div class="grid-2">
          <div class="card">
            <h3 class="section-title">Account summary</h3>
            <table>
              <tbody>
                <tr><th>Full name</th><td><%= user.name || '-' %></td></tr>
                <tr><th>Phone</th><td><%= user.phone || '-' %></td></tr>
                <tr><th>Email</th><td><%= user.email || '-' %></td></tr>
                <tr>
                  <th>Email verified</th>
                  <td>
                    <% if (user.emailVerified) { %>
                      <span class="status APPROVED">VERIFIED</span>
                    <% } else { %>
                      <span class="status PENDING">NOT VERIFIED</span>
                    <% } %>
                  </td>
                </tr>
                <tr><th>Created</th><td><%= user.createdAt ? new Date(user.createdAt).toLocaleString() : '-' %></td></tr>
                <tr><th>Last login</th><td><%= user.lastLoginAt ? new Date(user.lastLoginAt).toLocaleString() : '-' %></td></tr>
                <tr><th>Referral bonus earned</th><td><%= user.referralBonusEarned ? 'Yes' : 'No' %></td></tr>
              </tbody>
            </table>

            <% if (!user.emailVerified) { %>
              <form action="/verify-email" method="post" style="margin-top:14px">
                <button class="btn primary" type="submit">Verify Email</button>
              </form>
            <% } %>
          </div>

          <div class="card">
            <h3 class="section-title">Active city investments</h3>
            <% if (user.activeCities && user.activeCities.length) { %>
              <div style="display:grid;gap:12px">
                <% user.activeCities.forEach(code => { 
                  const city = cityConfig[code];
                  const expired = !city || (code === 'INTERN' ? internExpired : false) || false;
                %>
                  <div class="pill">
                    <div style="display:flex;justify-content:space-between;gap:10px;align-items:center">
                      <div>
                        <div style="font-weight:800"><%= code %> — <%= city ? city.city : code %></div>
                        <div class="muted" style="margin-top:4px">
                          Joined: <%= user.cityJoinDates && user.cityJoinDates[code] ? new Date(user.cityJoinDates[code]).toLocaleDateString() : '-' %>
                        </div>
                        <div class="muted" style="margin-top:4px">
                          Tasks/day: <%= city ? city.tasksPerDay : 0 %> • Daily income: KSH <%= city ? city.dailyIncome : 0 %>
                        </div>
                      </div>
                      <% if (code === 'INTERN' && internExpired) { %>
                        <span class="status REJECTED">EXPIRED</span>
                      <% } else { %>
                        <span class="status APPROVED">ACTIVE</span>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="muted">You have not joined any city package yet.</p>
              <a href="/?tab=city" class="btn primary">Browse Packages</a>
            <% } %>
          </div>
        </div>

        <div class="card" style="margin-top:18px">
          <h3 class="section-title">Recent transactions</h3>
          <% if (user.transactions && user.transactions.length) { %>
            <table>
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Amount</th>
                  <th>Detail</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% user.transactions.slice(0, 20).forEach(tx => { %>
                  <tr>
                    <td><%= tx.type || '-' %></td>
                    <td>KSH <%= Number(tx.amount || 0).toLocaleString() %></td>
                    <td><%= tx.detail || '-' %></td>
                    <td><span class="status <%= tx.status || 'APPROVED' %>"><%= tx.status || 'APPROVED' %></span></td>
                    <td><%= tx.date ? new Date(tx.date).toLocaleString() : '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <p class="muted">No transactions yet.</p>
          <% } %>
        </div>
      <% } %>

      <!-- CITY TAB -->
      <% if (activeTab === 'city') { %>
        <div class="card">
          <h3 class="section-title">City investment packages</h3>
          <p class="section-sub">
            Sign the city contract before joining. If a package requires payment, it will be deducted from your wallet balance.
          </p>

          <div class="city-grid">
            <% Object.entries(cityConfig).forEach(([code, city]) => { 
              const alreadyJoined = user.activeCities && user.activeCities.includes(code);
              const expiredInternPackage = code === 'INTERN' && internExpired;
            %>
              <div class="card city-card">
                <div class="city-banner" style="background-image:url('<%= city.image %>')">
                  <div class="city-code"><%= code %></div>
                </div>
                <div class="city-content">
                  <h3 style="margin:0"><%= city.city %></h3>
                  <div class="muted" style="margin-top:6px">
                    Package amount: <b>KSH <%= Number(city.amount || 0).toLocaleString() %></b>
                  </div>

                  <div class="city-meta">
                    <div class="mini">
                      Tasks / Day
                      <b><%= city.tasksPerDay %></b>
                    </div>
                    <div class="mini">
                      Daily Income
                      <b>KSH <%= Number(city.dailyIncome || 0).toLocaleString() %></b>
                    </div>
                    <div class="mini">
                      Duration
                      <b><%= city.durationDays %> day(s)</b>
                    </div>
                    <div class="mini">
                      Status
                      <b><%= alreadyJoined ? 'Joined' : 'Open' %></b>
                    </div>
                  </div>

                  <% if (alreadyJoined) { %>
                    <% if (expiredInternPackage) { %>
                      <div class="expired">INTERN EXPIRED</div>
                    <% } else { %>
                      <div class="joined">ALREADY JOINED</div>
                    <% } %>
                  <% } else { %>
                    <form action="/invest/<%= code %>" method="post" style="margin-top:12px">
                      <textarea
                        name="signature"
                        placeholder="Type your contract signature here to join <%= city.city %>"
                        required
                      ></textarea>
                      <button class="btn primary" type="submit" style="margin-top:10px;width:100%">
                        Join <%= city.city %>
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- TASK TAB -->
      <% if (activeTab === 'task') { %>
        <div class="grid-2">
          <div class="card">
            <h3 class="section-title">Task dashboard</h3>
            <div class="stats" style="grid-template-columns:1fr 1fr">
              <div class="pill">
                <div class="label">Completed Today</div>
                <h3><%= user.tasksCompletedToday || 0 %></h3>
              </div>
              <div class="pill">
                <div class="label">Daily Limit</div>
                <h3><%= taskLimitToday || 0 %></h3>
              </div>
              <div class="pill">
                <div class="label">Today Income</div>
                <h3>KSH <%= Number(user.todayIncome || 0).toLocaleString() %></h3>
              </div>
              <div class="pill">
                <div class="label">Claimed Today</div>
                <h3><%= user.claimedTasksToday ? user.claimedTasksToday.length : 0 %></h3>
              </div>
            </div>

            <% if (!user.activeCities || !user.activeCities.length) { %>
              <div class="msg bad" style="margin-top:14px">No task allowed without city investments.</div>
              <a href="/?tab=city" class="btn primary">Join a city package first</a>
            <% } else { %>
              <p class="muted" style="margin-top:14px">
                Each completed task rewards <b>KSH 50</b>. You cannot claim the same task twice in one day.
              </p>
            <% } %>
          </div>

          <div class="card">
            <h3 class="section-title">Claim a task</h3>
            <p class="section-sub">Choose any available task from the list below and submit it.</p>

            <form action="/task" method="post">
              <select name="taskName" required>
                <option value="">Select task</option>
                <% tasks.forEach(task => { %>
                  <option value="<%= task %>"><%= task %></option>
                <% }) %>
              </select>
              <button class="btn primary" type="submit" style="margin-top:12px;width:100%">
                Claim Task Reward
              </button>
            </form>
          </div>
        </div>

        <div class="card" style="margin-top:18px">
          <h3 class="section-title">Task catalogue</h3>
          <div class="task-grid">
            <% tasks.forEach(task => { 
              const claimed = user.claimedTasksToday && user.claimedTasksToday.includes(task);
            %>
              <div class="task-item">
                <div class="task-top">
                  <div style="font-weight:800"><%= task %></div>
                  <span class="status <%= claimed ? 'APPROVED' : 'PENDING' %>">
                    <%= claimed ? 'CLAIMED' : 'AVAILABLE' %>
                  </span>
                </div>
                <div class="muted">Reward: KSH 50</div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- WALLET TAB -->
      <% if (activeTab === 'wallet') { %>
        <div class="grid-2">
          <div style="display:grid;gap:18px">
            <div class="card">
              <h3 class="section-title">Deposit with M-Pesa</h3>
              <p class="section-sub">Minimum deposit is KSH 200. An STK push will be sent to your phone.</p>
              <form action="/deposit" method="post">
                <input
                  type="text"
                  name="phone"
                  placeholder="M-Pesa number e.g. 07XXXXXXXX"
                  value="<%= user.phone || '' %>"
                  required
                />
                <input
                  type="number"
                  name="amount"
                  min="200"
                  placeholder="Deposit amount"
                  required
                />
                <button class="btn primary" type="submit" style="margin-top:12px;width:100%">
                  Send STK Push
                </button>
              </form>
            </div>

            <div class="card">
              <h3 class="section-title">Change account password</h3>
              <p class="section-sub">Password must be 6 to 8 characters.</p>
              <form action="/profile/password" method="post">
                <input type="password" name="currentPassword" placeholder="Current password" required />
                <input type="password" name="newPassword" placeholder="New password (6-8 chars)" minlength="6" maxlength="8" required />
                <button class="btn outline" type="submit" style="margin-top:12px;width:100%">
                  Update Password
                </button>
              </form>
            </div>
          </div>

          <div style="display:grid;gap:18px">
            <div class="card">
              <h3 class="section-title">Withdraw funds</h3>
              <p class="section-sub">Minimum withdrawal is KSH 300. Enter your withdrawal password to continue.</p>
              <form action="/withdraw" method="post">
                <input
                  type="text"
                  name="phone"
                  placeholder="Withdrawal phone number"
                  value="<%= user.phone || '' %>"
                  required
                />
                <input
                  type="number"
                  name="amount"
                  min="300"
                  placeholder="Withdrawal amount"
                  required
                />
                <input
                  type="password"
                  name="withdrawalPassword"
                  placeholder="Withdrawal password"
                  required
                />
                <button class="btn success" type="submit" style="margin-top:12px;width:100%">
                  Submit Withdrawal Request
                </button>
              </form>
            </div>

            <div class="card">
              <h3 class="section-title">Wallet summary</h3>
              <table>
                <tbody>
                  <tr><th>Balance</th><td>KSH <%= Number(user.balance || 0).toLocaleString() %></td></tr>
                  <tr><th>Total earnings</th><td>KSH <%= Number(user.totalEarnings || 0).toLocaleString() %></td></tr>
                  <tr><th>Today income</th><td>KSH <%= Number(user.todayIncome || 0).toLocaleString() %></td></tr>
                  <tr><th>Tasks completed today</th><td><%= user.tasksCompletedToday || 0 %></td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>

      <!-- MENU TAB -->
      <% if (activeTab === 'menu') { %>
        <div class="menu-grid">
          <div class="card roulette">
            <h3 class="section-title">Roulette Spin</h3>
            <p class="section-sub">Use 1 free spin or 2 gems per spin.</p>
            <div class="roulette-wheel"></div>
            <div class="stats" style="grid-template-columns:1fr 1fr">
              <div class="pill">
                <div class="label">Gems</div>
                <h3><%= user.gems || 0 %></h3>
              </div>
              <div class="pill">
                <div class="label">Free Spins</div>
                <h3><%= user.freeSpins || 0 %></h3>
              </div>
            </div>
            <form action="/spin-roulette" method="post" style="margin-top:14px">
              <button class="btn primary" type="submit">Spin Roulette</button>
            </form>
          </div>

          <div style="display:grid;gap:18px">
            <div class="card">
              <h3 class="section-title">Referral link</h3>
              <p class="section-sub">
                Invite friends using your referral link. Bonus rules still depend on them joining a paid city package.
              </p>

              <div class="copy-box">
                <input
                  class="copy-input"
                  id="refLink"
                  value="<%= referralLink || '' %>"
                  readonly
                />
                <button class="btn outline" type="button" onclick="copyReferral()">Copy</button>
              </div>

              <div style="margin-top:12px" class="muted">
                Referral code: <b><%= user.referralCode || '-' %></b><br />
                Referred users: <b><%= user.referredCount || 0 %></b><br />
                Bonus earned: <b><%= user.referralBonusEarned ? 'Yes' : 'No' %></b>
              </div>
            </div>

            <div class="card">
              <h3 class="section-title">Quick account actions</h3>
              <div style="display:grid;gap:10px">
                <% if (!user.emailVerified) { %>
                  <form action="/verify-email" method="post">
                    <button class="btn primary" type="submit" style="width:100%">Verify Email</button>
                  </form>
                <% } %>
                <a href="/?tab=wallet" class="btn outline">Open Wallet</a>
                <a href="/?tab=task" class="btn outline">Go to Tasks</a>
                <a href="/?tab=city" class="btn outline">View City Packages</a>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    <% } %>

    <div class="footer-note">
      BITREX 722 Platform &copy; <%= new Date().getFullYear() %>
    </div>
  </div>

  <script>
    function copyReferral() {
      const input = document.getElementById('refLink');
      if (!input) return;
      input.select();
      input.setSelectionRange(0, 99999);
      navigator.clipboard.writeText(input.value).then(() => {
        alert('Referral link copied');
      }).catch(() => {
        document.execCommand('copy');
        alert('Referral link copied');
      });
    }
  </script>
</body>
</html>
