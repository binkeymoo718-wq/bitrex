          <div class="wheel-wrap" style="margin-top:12px">
            <div class="pointer"></div>
            <div id="wheel" class="wheel">
              <span class="wheel-label" style="transform:rotate(-60deg) translate(60px,-8px)">KSH 500</span>
              <span class="wheel-label" style="transform:rotate(0deg) translate(60px,-8px)">KSH 150</span>
              <span class="wheel-label" style="transform:rotate(60deg) translate(70px,-8px)">1 GEM</span>
              <span class="wheel-label" style="transform:rotate(120deg) translate(60px,-8px)">2 GEMS</span>
              <span class="wheel-label" style="transform:rotate(180deg) translate(65px,-8px)">KSH 100</span>
              <span class="wheel-label" style="transform:rotate(240deg) translate(70px,-8px)">KSH 50</span>
              <span class="spin-center">🕓</span>
            </div>
            <button type="button" id="spinBtn" onclick="spinWheel()">🎡 Spin</button>
