{
  "name": "BITREX Investment Platform",
  "short_name": "BITREX",
  "description": "A professional mobile-ready investment dashboard and wallet platform.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#07111f",
  "theme_color": "#07111f",
  "categories": ["finance", "business", "productivity"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/icons/screenshot.svg",
      "sizes": "1280x720",
      "type": "image/svg+xml",
      "form_factor": "wide"
    },
    {
      "src": "/icons/screenshot-mobile.svg",
      "sizes": "540x960",
      "type": "image/svg+xml",
      "form_factor": "narrow"
    }
  ]
}
